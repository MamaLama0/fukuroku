  <area id="105" name="Page - Settings">
    <add key="SETTINGS_NL_Tab_Title" value="Settings" />
    <add key="SETTINGS_NL_Tab_Header_Global_Setting" value="Global Settings" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Playing_Area" value="Magnetize Playing Area" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Playing_Area" value="Magnetize the playing area/slots" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Playing_Area" value="The playing area can be magnetized, this means you can drag and drop tables and they will snap to the slots inmediately. You can also drag and drop pressing the CTRL key to avoid the swapping of the tables, instead, they will stack" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Observer_Area" value="Magnetize Observer Area" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Observer_Area" value="Magnetize the observer area/slots" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Observer_Area" value="The Observer slots can also be magnetized" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Lobby_Slots" value="Magnetize Lobby Slots" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Lobby_Slots" value="Magnetize the lobby slots" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Lobby_Slots" value="As well as the lobby slots. As long as the lobby slots have both the stack sites option" />
    <add key="SETTINGS_NL_CheckBox_Invert_Ctrl_Key" value="Invert CTRL key use for magnetization" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Observer_Area_When_Table_Closed" value="Reorder Observer Area when a table is closed" />
    <add key="SETTINGS_NL_Tooltip_Title_Reoder_Observer_Area_When_Table_Closed" value="Reorder observer area on table closed" />
    <add key="SETTINGS_NL_Tooltip_Body_Reoder_Observer_Area_When_Table_Closed" value="You can make the tables be reordered in the observer slots when one of them is closed" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Playing_Area_When_Table_Closed" value="Reorder Playing Area when a table is closed" />
    <add key="SETTINGS_NL_Tooltip_Title_Reorder_Playing_Area_When_Table_Closed" value="Reorder playing area on table closed" />
    <add key="SETTINGS_NL_Tooltip_Body_Reorder_Playing_Area_When_Table_Closed" value="You can make the tables be reordered in the playing slots when one of them is closed" />
    <add key="SETTINGS_NL_CheckBox_Keep_Most_Urgent_On_Top" value="Manage stack urgency" />
    <add key="SETTINGS_NL_Tooltip_Title_Keep_Most_Urgent_On_Top" value="Manage stack urgency" />
    <add key="SETTINGS_NL_Tooltip_Body_Keep_Most_Urgent_On_Top" value="When tables share a stack slot, Jurojin brings the most urgent table (least time left to act) to the top of that stack. This only manages visibility within the stack — it does not move keyboard focus." />
    <add key="SETTINGS_NL_CheckBox_Auto_Focus_Most_Urgent_Always" value="Auto Focus Most Urgent Table Always" />
    <add key="SETTINGS_NL_Tooltip_Title_Auto_Focus_Most_Urgent_Always" value="Auto Focus Most Urgent Table Always" />
    <add key="SETTINGS_NL_Tooltip_Body_Auto_Focus_Most_Urgent_Always" value="When the first table needs action (or after you act and another still needs action), Jurojin focuses the most urgent table globally so you can play without reaching for the mouse." />
    <add key="SETTINGS_NL_CheckBox_Also_Force_Move_Mouse" value="Also Force Move Mouse" />
    <add key="SETTINGS_NL_Tooltip_Title_Also_Force_Move_Mouse" value="Also Force Move Mouse" />
    <add key="SETTINGS_NL_Tooltip_Body_Also_Force_Move_Mouse" value="Also moves the mouse cursor onto the focused table. Useful for gamepad play or sites that require the cursor over the table." />
    <add key="SETTINGS_NL_CheckBox_Minimize_App_To_System_Tray" value="Minimize app to system tray" />
    <add key="SETTINGS_NL_CheckBox_Save_Jurojin_Location_On_Close" value="Save Jurojin Location on Close" />
    <add key="SETTINGS_NL_Tooltip_Title_Alarm_For_Action_Required" value="Alarm for Action Required" />
    <add key="SETTINGS_NL_Tooltip_Title_Delayed_Alarm_Action_Enabled" value="Delayed alarm for action required" />
    <add key="SETTINGS_NL_Tooltip_Subtitle_Delayed_Alarm_Action_Enabled" value="Sounds after 10 seconds from turn start" />
    <add key="SETTINGS_NL_Tooltip_Body_Delayed_Alarm_Action_Required" value="You can make Jurojin play an alarm after the configured number of seconds has passed since your turn started, as long as action is still required." />
    <add key="SETTINGS_NL_Tooltip_Body_Minimize_Application_To_System_Tray" value="When you press the minimize button with this feature turned on, the app will go to the system Tray on lower right of Windows." />
    <add key="SETTINGS_NL_Tooltip_Title_Minimize_Application_To_System_Tray" value="Minimize to tray" />
    <add key="SETTINGS_NL_CheckBox_Show_RNG" value="Show RNG" />
    <add key="SETTINGS_NL_CheckBox_Sub_Show_RNG" value="Random Number Generator" />
    <add key="SETTINGS_NL_Tooltip_Title_Show_Random_Number_Generator" value="RNG" />
    <add key="SETTINGS_NL_Tooltip_Body_Show_Random_Number_Generator" value="This will display an RNG on the screen (not over tables, its independant!)" />
    <add key="SETTINGS_NL_CheckBox_Drag_Table_Clicking_Anywhere" value="Drag table by clicking anywhere on it" />
    <add key="SETTINGS_NL_CheckBox_Focus_Table_Under_Mouse" value="Focus table under mouse" />
    <add key="SETTINGS_NL_Tooltip_Title_Focus_Table_Under_Mouse" value="Focus table under mouse" />
    <add key="SETTINGS_NL_Tooltip_Body_Focus_Table_Under_Mouse" value="This feature brings the table to front when you hover the mouse over it" />
    <add key="SETTINGS_NL_CheckBox_Bring_Only_Tables_In_Playing_Slot_To_Front" value="Bring only tables in playing slot to the front" />
    <add key="SETTINGS_NL_Tab_Header_Global_Hotkeys" value="Global Hotkeys" />
