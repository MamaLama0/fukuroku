      <add key="DIALOG_STORE_BINANCE_WARNING_Button_Cancel" value="Cancel" />
      <add key="DIALOG_STORE_BINANCE_WARNING_Btc_Body" value="When withdrawing from exchanges directly, a fee is charged for withdrawing funds. Make sure to be sending to the address the correct amount! In Binance you have to press this button to make sure the withdrawal amount is correct, otherwise we will receive insufficient funds and your products will not be activated." />
