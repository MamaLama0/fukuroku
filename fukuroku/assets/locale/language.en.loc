  <area id="114" name="Feature Lock">
    <add key="FEATURE_LOCK_Label_Coming_Soon" value="COMING SOON" />
    <add key="FEATURE_LOCK_Label_Watch_On_TouTube" value="WATCH IT IN ACTION ON YOUTUBE" />
