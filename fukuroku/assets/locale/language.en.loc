  <area id="115" name="Walkthrough">
    <sub id="0" name="Intro">
      <add key="WALK_INTRO_SKIP_OPTION_Label_Intro" value="The Walkthrough was interrupted. Do you want to start over?" />
      <add key="WALK_INTRO_SKIP_OPTION_Label_Button_Skip" value="SKIP" />
      <add key="WALK_INTRO_SKIP_OPTION_Label_Button_Continue" value="START" />
    </sub>
    <sub id="1" name="Language Selection">
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Welcome" value="WELCOME!" />
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Intro" value="We will now guide you through the most basic settings and how to configure them" />
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Choose_Language" value="CHOOSE YOUR LANGUAGE" />
      <add key="WALK_INTRO_FINISH_Label_Button_LetsStart" value="LET'S START!" />
    </sub>
    <sub id="2" name="Finish">
      <add key="WALK_INTRO_FINISH_Label_Welcome" value="FINISHED" />
      <add key="WALK_INTRO_FINISH_Label_Line1" value="Great! You can now use Jurojin" />
      <add key="WALK_INTRO_FINISH_Label_Line2" value="Play &amp; Enjoy! Good luck at the tables!" />
      <add key="WALK_INTRO_FINISH_Label_Button_PlayNow" value="PLAY NOW" />
    </sub>
    <sub id="3" name="Layouts">
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Layout" value="Let's start by configuring a Layout. Click the Layout configuration menu item" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Create_New_Layout" value="The layout is your way to tell Jurojin where you want your tables to be sent. Click here to create a new Layout" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Intro" value="This option lets you create a layout manually" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Automatically" value="If you want to create the layout quickly, you can use the automatic creation feature" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_From_Preset" value="Or you can choose an option from our layout templates" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Clone_Existing" value="Or you can clone an existing layout. Useful for creating a similar layout to an already created one and saving time." />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Action" value="For now, let's do one manually so you get to know all your options" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Slot" value="This button adds a Playing Slot. Your tables will be sent here by default" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Observer_Slot" value="Similarly, you can add an Observer Slot. You can use these slots to observe tables where you are not playing" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Replay_Slot" value="Replay slots are only for hand replays (not every site supports this feature)" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Lobby_Slot" value="Lobby windows can also be recognized by Jurojin and be sent to a lobby slot. Take notice that the lobby windows are not resized as the tables, so you can only define the location for them" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_CopyBottom" value="Press this button now to create a new slot with the same size as the current one exactly below it" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_DeleteSlot" value="If you need to delete a slot, simply press on the trash can. Delete this slot" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Slots_Create_Layout" value="Now that you know how to add slots, create your layout. Once you are finished, click on the button to continue and save your layout" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Save_Layout" value="All done! Now save your layout so we can continue" />
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Back" value="Now let's go back to see some more features" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Tab_Header_Automatic_Layout_Switch" value="Here you can configure Jurojin to switch layouts automatically" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Select_Automatic_Layout_Options" value="Configure the automatic layour switch config as you want now!" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Or_Observer_Slot" value="With these buttons you can add playing or observer slots to your layout, with the feature Keep Most Urgent on top from general settings you can stack tables in the same slot and they will pop in order!" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Dynamic_Slots" value="With these two buttons you can add dynamic slots, you can only choose one of these two types to be added to your layout as they offer a different flow for your tables" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Action_Required_Slots" value="With the action required slot, tables will be moved into it every time it's your turn to act" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_InHand_Slots" value="With the in hand slot, tables will be moved whenever you enter the hand, vpip, post the blind, etc. This can be configured in each site config" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys_Tab" value="Now lets check the layout hotkeys tab.." />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys" value="With these hotkeys, you can send tables to your playing or observer slots by just hovering them and pressing the keybinding" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkey_Dynamic_Slots" value="With this hotkey, you can lock a table out of the dynamic slots flow, so it stays wherever it is. really useful for when you are playing a big hand or final table" />
    </sub>
    <sub id="4" name="Sites Config">
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Sites" value="Click here to go to Sites Configuration" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATIONS_Party_Poker_Hex" value="Click to see what configurations are available for Pokerstars (if you don't play in Stars, don't worry. You will be able to configure your sites later)" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Toggle_Tiling_Status" value="With this button you can enable/disable tiling (only for this site)." />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Tiling_Options_Details" value="Here you will be able to configure how the tables are automatically moved/tiled for a specific poker site." />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Check_Auto_Play_On_Launch" value="When this is turned on, once Jurojin is opened, all your tables will be moved depending on what you configured above. This option saves you the time of pressing PLAY in Jurojin so it starts detecting the tables. We strongly recommend you using this feature" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Save_Settings" value="If you have something to save this is the time! If not just press skip" />
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Back" value="Let's go back again and see some more features" />
    </sub>
    <sub id="5" name="General Configuration">
      <add key="WALK_SCENARIO_GENCONFIG_HAMBURGER_MENU_ITEM_Configuration" value="This button takes you to the General Configuration" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Playing_Area" value="The playing area can be magnetized, this means you can drag and drop tables and they will snap to the slots inmediately. You can also drag and drop pressing the CTRL key to avoid the swapping of the tables, instead, they will stack" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Observer_Area" value="The Observer slots can also be magnetized" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tooltip_Magnetize_Playing_Area" value="This icon will give you a small explanation of what each feature is" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Lobby_Slots" value="As well as the lobby slots. As long as the lobby slots have both the stack sites option" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Observer_Area_Table_Closed" value="You can make the tables be reordered in the observer slots when one of them is closed" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Playing_Area_Table_Closed" value="You can make the tables be reordered in the playing slots when one of them is closed" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Focus_Table_Under_Mouse" value="This feature brings the table to front when you hover the mouse over it" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Highlight_Table_Under_Focus" value="This will highlight the focused table border." />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Show_Random_Number_Generator" value="This will show random number generator at the start of the app. If you leave this feature on, the RNG will appear as soon as you finish this guide!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Minimize_To_System_Tray" value="When you press the minimize button, the app will only appear in the system tray (small icons on the lower right of Windows)" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Keep_Most_Urgent_On_Top" value="When you have more than one table stacked on the same slot, Jurojin will keep the most urgent on top. When you take action the next most urgent goes to top." />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_WorksFor_Keep_Most_Urgent_On_Top" value="There are some features that do not work for all sites! With this icon you can check which support it!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Global" value="You can turn this options on or off to make Jurojin ideal!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Global_Hotkeys" value="These are the available general hotkeys in Jurojin" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Set_HotKeys" value="You can set the hotkeys by selecting the field and pressing the keyboard shortcut" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Table_Border" value="Here you can configure the colored borders for your tables! Some sections have tabs like this, don't forget to check!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Table_Border" value="You can turn on this option to have a violet border over the focused table" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Save_Changes" value="Save your settings or just press on skip ssaving" />
    </sub>
    <sub id="6" name="HotKeys Config">
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_HAMBURGER_MENU_ITEM_HotKeys" value="Here you will be able to define hotkeys to take actions on the tables like check/fold/bet/raise!" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Intro" value="Set your keybindings with your mouse or keyboard for your betsizes and actions! Some sites like GGPoker require you to do some extra config, check our FAQ for more info!" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Discord_Intro" value="Looks like you don't have access to this feature! By clicking on this button you can request access leaving your Jurojin username on the chat" />
    </sub>
    <sub id="7" name="Controller Config">
      <add key="WALK_SCENARIO_CONTROLLER_HAMBURGER_MENU_ITEM_Controller" value="We have also added controller support for some poker sites!" />
      <add key="WALK_SCENARIO_CONTROLLER_Page_Intro" value="Grab some beers, seat at the couch and enjoy some spins with our new controller support!" />
    </sub>
    <sub id="8" name="Overlays Config">
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_HAMBURGER_MENU_ITEM_Overlays" value="In this view you can configure the overlays that appear over your tables!" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Page_Intro" value="Any item that appears over each table is on this view, here you can turn them on and off as well as configuring some aspects about them!" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Table_Overlays_Contents" value="Here you can configure the overlays that appear inside your tables. The overlays will show different stats that are super handy ingame. Click the learn more next to each overlay to see guides about them" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Tab_Seats_Overlays_Intro" value="Let's go the seat overlays section" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Seats_Overlays_Contents" value="The seat overlays are always sticked next to a player seat and show things like position and actions line, make sure you have the hero centered in the sites configs" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Tab_Table_Counters_Intro" value="Now let's check the counter overlays" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Table_Counters_Contents" value="The counter overlays will dispaly info related to tables on the slot where the table is located (if at any)" />
    </sub>
    <sub id="9" name="Changelog">
      <add key="WALK_SCENARIO_CHANGELOG_HAMBURGER_MENU_ITEM_Changelog" value="In this section you will be able to read about the latest news for the app! It goes red when there's new stuff!" />
      <add key="WALK_SCENARIO_CHANGELOG_Page_Intro" value="Learn about the latest news in here!" />
    </sub>
    <sub id="10" name="Outro">
      <add key="WALK_SCENARIO_GENOUTRO_REPORT_ISSUE" value="If you have any issues use the report button so we can help you, or join our discord channel!" />
      <add key="WALK_SCENARIO_GENOUTRO_WALKTHROUGH_ON_DEMAND" value="You can see this guide again at any time by pressing on this button." />
    </sub>
    <sub id="11" name="Others">
      <add key="WALK_Common_Label_User_Action_Complete" value="ALL DONE!" />
      <add key="WALK_Common_Label_User_Intro_Acknowledge" value="GOT IT" />
      <add key="WALK_Common_Skip_Saving" value="Skip Saving" />
      <add key="WALK_Button_See_Walkthrough_Again" value="SEE GUIDE AGAIN" />
      <add key="WALK_Button_Guide" value="GUIDE" />
      <add key="WALK_Button_Skip_To_End" value="I will finish this guide later" />
    </sub>
  </area>
  <area id="116" name="Walkthrough V2">
    <sub id="0" name="Intro">
      <add key="WALKV2_INTRO_Title_Welcome_To_Jurojin_Poker" value="Welcome to Jurojin Poker!" />
      <add key="WALKV2_INTRO_Label_Choose_Your_Language_To_Begin" value="Choose your language to begin" />
      <add key="WALKV2_INTRO_Button_Lets_Start" value="Let's Start" />
    </sub>
    <sub id="1" name="Mini Intro">
      <add key="WALKV2_MINI_INTRO_Title_Lets_Learn_The_Basics" value="Let's learn the basics..." />
      <add key="WALKV2_MINI_INTRO_Description_I_Will_Be_Guiding_You_Through_The_App" value="I will be guiding you through the app so you can learn about our most important features! In Jurojin you will find three main functionalities. You can click on any of these to learn." />
      <add key="WALKV2_MINI_INTRO_Button_Tiling" value="Tiling" />
      <add key="WALKV2_MINI_INTRO_Button_Hotkeys" value="Hotkeys" />
      <add key="WALKV2_MINI_INTRO_Button_Overlays" value="Overlays" />
      <add key="WALKV2_MINI_INTRO_Button_I_Will_Go_Through_Jurojin_Myself" value="I will go through Jurojin myself" />
    </sub>
    <sub id="2" name="Mini Finish">
      <add key="WALKV2_MINI_FINISH_Title_Well_Done" value="Well Done!" />
      <add key="WALKV2_MINI_FINISH_Description_Great_You_Finished_One_Of_Our_Miniguides" value="¡Genial! ¡Has terminado una de nuestras miniguías! Si quieres ver otra o repetir la misma, puedes hacerlo ahora mismo." />
      <add key="WALKV2_MINI_FINISH_Button_Tiling" value="Tiling" />
      <add key="WALKV2_MINI_FINISH_Button_Hotkeys" value="Hotkeys" />
      <add key="WALKV2_MINI_FINISH_Button_Overlays" value="Overlays" />
