      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Title_Auto_Top-Up_For_Cash_Games" value="Rebuy/Topup" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Body_Auto_Top-Up_For_Cash_Games" value="Use this feature to rebuy or topup automatically on your tables. If you play Zoom, the topup will only occur when pressing the Jurojin fold hotkey that has an intended delay" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Toaster_Content_If_You_Play_Zone_Topup_Will_Happen_Only_With_Fold_Hotkey" value="If you play zone, the topup will happen only with the fold hotkey from Jurojin" />
