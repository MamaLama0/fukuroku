      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Title_Hide_Board" value="Hide Board" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Body_Hide_Board" value="You can hide the board when you go all in to avoid tilt and nerves" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Color_Stacks" value="Color Stacks" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Set_A_Specific_Color_On_Stacks_Based_On_Amount" value="Set a specific color on the player stacks based on their stack size" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Title_BB_Conversion" value="BB Convertion" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Body_BB_Conversion" value="With this feature, you can convert the stacks and betsizes into BB values. By clicking on your stack, you can switch between them, as well as have different amount of decimals in the value. Turn off the built-in convertion in Bodog if you want to use this one!" />
