    <add key="OVERLAY_SETTINGS_PAGE_NL_Pot_Odds_Tooltip_Body" value="With this overlay you will be able to know the relationship between the risk vs. the reward. It can be expressed as a mathematical relationship reward:risk or as a percentage." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Stack_To_Pot_Ratio" value="SPR" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Tooltip_Title" value="SPR" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Tooltip_Body" value="With this overlay you will be able to know the relationship between the effective stack (the stack of the player with less chips) divided by the pot size." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Effective_Stack" value="EFFECTIVE STACK" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_EFFS_Tooltip_Title" value="EFF. S" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_EFFS_Tooltip_Body" value="With this overlay you can see how many chips has the player with least chips on the hand" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bet_Buttons" value="BET BUTTONS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Bet_Buttons_Tooltip_Title" value="BET BUTTONS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Bet_Buttons_Tooltip_Body" value="This overlay will display the bet values that you have configured for your hotkeys on the Hotkeys/Betsizes page! If you press CTRL over the overlay, you will see the other eight betsizes" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Action_History" value="ACTION HISTORY" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Action_History_Tooltip_Title" value="ACTIONS HISTORY OVERLAY" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Action_History_Tooltip_Body" value="This overlay will help you notice the intentions the opponents are trying to show you while playing, you will see every action they perform during a hand" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Position" value="POSITIONS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Positions_Tooltip_Title" value="POSITIONS OVERLAY" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Positions_Tooltip_Body" value="With this overlay you will be able to see each player position on the table" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_AR_Tables_Counter" value="ACTION REQUIRED TABLES COUNTER" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Hand_Tables_Counter" value="HAND COUNTER" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_ST_Tables_Counter" value="STACKED TABLES COUNTER" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_TOASTER_Check_Guide" value="A guide will open on your browser for seat based overlays so you configure everything properly. Make sure to have seat centering ok on all sites before testing the feature!" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_SPR_Next_Street" value="SPR N.S." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_POT_Next_Street" value="POT N.S." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Next_Street_Tooltip_Title" value="SPR Next Street Overlay" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Next_Street_Tooltip_Body" value="This overlay will read your betfield value, and assume your opponent would call, then calculating what the SPR will be next street" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ON_DISABLE_Actions_Title" value="Disable Overlay" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ON_DISABLE_Actions_Message" value="Are you sure? You may not be able to report Table or hand issues if this Overlay is disabled." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_AR_Counter_Tooltip_Title" value="Action Required Tables Counter" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_AR_Counter_Tooltip_Body" value="This overlay will tell you how many tables are requiring action right at that time on that specific slot. Its cycle button will only cycle through tables that require action" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ST_Counter_Tooltip_Title" value="Stacked Tables Counter" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ST_Counter_Tooltip_Body" value="Use this overlay to know how many tables are at specific slot" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Hand_Counter_Tooltip_Title" value="Hand Counter" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Hand_Counter_Tooltip_Body" value="The Hands Counter will help you track your volume on each table individually and allow you to decide when to take a break or simply finish the current session. Closing the table will reset the counter!" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Save_Location_Title" value="Save Location" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Save_Location_Body" value="Make sure you are in the home screen of Jurojin and then accomodate your overlays where you want them clicking on the dotted area. Then press the hotkey over that table" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Outs" value="MINIMUM OUTS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Minimum_Outs_Tooltip_Title" value="MINIMUM OUTS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency" value="MDF" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency_Tooltip_Title" value="MINIMUM DEFENSE FREQUENCY" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency_Tooltip_Body" value="This overlay shows the minimum % of hands you should call a specific bet size from your opponent to not be exploitable by your opponents" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity" value="BLUFF EQUITY" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity_Tooltip_Title" value="BLUFF EQUITY" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity_Tooltip_Body" value="Represents, given a bet size (read from your betbox before making any bet), how often your rival should fold based on your knowledge of his play style, on a given situation to make the bet profitable for you, specially useful when bluffing" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_POT_Next_Street_Tooltip_Title" value="POT Next Street Overlay" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_POT_Next_Street_Tooltip_Body" value="This HUD automatically calculates the expected pot size for the next betting round, considering the current bet-box value (before submitting the raise) and assuming the opponent calls." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Minimum_Outs_Tooltip_Body" value="This overlay shows Pot Odds * Unknown Cards, it will tell you how many outs your hand should have for it to be a profitable call, it does not tell you how many outs you currently have based off your whole cards and board." />
