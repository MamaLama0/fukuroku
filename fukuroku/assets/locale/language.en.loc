  <area id="100" name="App Window">
    <add key="APP_WINDOW_NL_Popup_Signup_Title" value="SIGNUP" />
    <add key="APP_WINDOW_NL_Popup_Signup_Subtitle" value="TO START YOU FREE TRIAL!!" />
    <add key="APP_WINDOW_NL_" value="" />
    <sub id="0" name="Error Messages">
      <add key="ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_NL_MESSAGE" value="We detected a change in your displays configuration and your current active layout has slots outside of bounds. Do you want to edit Active Layout now?" />
      <add key="ON_APPLICATION_ERROR_Title" value="Server Error" />
      <add key="ON_SERVER_FATAL_ERROR_MESSAGE" value="Connection lost. Check your internet connection." />
      <add key="ON_ERROR" value="It appears there was an error! Please contact us via discord to solve it! https://jurojinpoker.com/discord" />
      <add key="ON_APPLICATION_MAINTENANCE_Title" value="Server Maintenance" />
      <add key="ON_APPLICATION_MAINTENANCE_Text" value="We need you to reopen Jurojin right now, most probably you will be back to your normal user in the app after reopening!" />
      <add key="DLL_MISSING_ERROR_TITLE" value="Files Missing" />
      <add key="DLL_MISSING_ERROR_MESSAGE" value="You have missing files that are needed to run the app! This is usually the antivirus deleting them! Please add an exception to the Jurojin installation folder on your antivirus or Windows Defender and then try using the app again. If you keep seeing this error message after doing so, please download our latest installer from https://jurojinpoker.com/download?v=345789/" />
      <add key="INSTALLATION_INTEGRITY_ERROR_TITLE" value="Installation Modified" />
      <add key="INSTALLATION_INTEGRITY_ERROR_MESSAGE" value="Jurojin detected an unexpected change in your installation files. For your security, the app will close. Please reinstall from https://jurojinpoker.com/download" />
      <add key="UNHANDLED_EX_ERROR_OUTOFMEMORY" value="Your PC has ran out of RAM memory or GPU memory to execute the program. Consider closing some unused apps like the browser, or maybe upgrading your PC" />
      <add key="GLOBALFEATURE_ERROR" value="There was an error activating one of your Comfort Features, Please contact support with this info: #ex#" />
      <add key="PLAYINGSESSIONHANDLER_ERROR" value="There was a problem when saving the tables info into your layout, please contact support with this info: #ex#" />
      <add key="HOOKCONTROLLER_ERROR" value="There was a problem connecting with your controller, please contact support with this info: #ex#" />
      <add key="EMERGENCY_SHUTDOWN_CANNOT_CONNECT_TO_SERVERS_MESSAGE" value="The app cannot currently connect to our servers and will be shutdown for security measures" />
      <add key="KEEP_ALIVE_RECONNECT_ENTITLEMENTS_REVOKED_TOAST" value="Your PC cannot currently connect to our servers. Please check your internet connection and firewall/antivirus" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Title" value="Connection problem" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Body" isFormatted="true" value="&lt;p&gt;Your subscription is still active, but Jurojin cannot reach our servers from your PC. Features were temporarily disabled for security.&lt;/p&gt;&lt;p&gt;Check your internet connection, firewall, and antivirus, then wait for Jurojin to reconnect automatically.&lt;/p&gt;" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Open_Guide" value="Open troubleshooting guide" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Got_It" value="Got it" />
    </sub>
