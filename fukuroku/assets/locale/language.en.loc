    <sub id="3" name="Tab - Rebuy Topup">
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tab_Header_Rebuy_Topup" value="Rebuy/Topup" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Toggle_Auto_Top-Up_For_Cash_Games" value="Auto Top-Up for Cash Games" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Auto_Top-Up_For_Cash_Games" value="Auto Top-Up for Cash Games" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Description_Auto_TopUp" value="Tired of clicking the rebuy Button? Don’t let your stack run low! With this feature you will be able to keep youreslf strong at the table. Just let Jurojin do the job by telling it when to rebuy and how much! " />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Auto_Top_Up_Back_To" value="Auto top up back to" />
