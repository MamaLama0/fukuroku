      <add key="LAYOUT_CONFIGURATION_NL_ON_TABLES_LAYOUT_CONFIGURATION_Auto_Swap_Message" value="Activating a Layout manually would disable Automatic Layout Switch. Are you sure turn off this feature and Activate this Layout?" />
