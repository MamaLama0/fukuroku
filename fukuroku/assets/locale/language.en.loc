      <add key="SITE_VALIDATION_OPEN_BEFORE_SCANNING" value="Please open the poker site before you start detecting the tables with Jurojin." />
      <add key="SITE_VALIDATION_COINPOKER_HUD_INTERFERENCE_DETECTED" value="EliteHUD products prevent Jurojin from working effectively on CoinPoker by affecting the original flow of the casino execution. Direct any complaints to their support." />
