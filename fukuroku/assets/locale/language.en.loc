      <add key="EDIT_LAYOUT_NL_Button_Add_Action_Required_Slot" value="Add ACTION REQUIRED Slot" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Title_Action_Required" value="Action Required" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Body_Action_Required" value="This slots represents the area of the screen where tables will go when it is your turn to play. There will only be one table at a time in this type of slots, when all these slots are occupied with a table, tables go to the Queue slots, and once the action required slot is freed, the most urgent table from the queue slot is sent." />
      <add key="EDIT_LAYOUT_NL_Button_Add_Queue_Slot" value="Add QUEUE Slot" />
      <add key="EDIT_LAYOUT_NL_Button_Add_In_Hand_Slot" value="Add IN HAND Slot" />
      <add key="EDIT_LAYOUT_NL_Button_Save_Changes" value="Save Changes" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Title" value="Some slots will be deleted" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Message" value="Slots marked with red borders are either outside of the bounds of the display or overlapping with other slots and will be removed. Do you want to proceed?" />
      <add key="EDIT_LAYOUT_NL_Label_Stack_Tables_In_Ar_Slot" value="Stack Tables in the AR Slot as your turn comes in each of them" />
      <add key="EDIT_LAYOUT_Tooltip_Title_In_Hand" value="In Hand Slots" />
      <add key="EDIT_LAYOUT_Tooltip_Body_In_Hand" value="In Hand Slots are the best way to focus only in important hands, tables will move here when you VPIP. You can configure this behavior in each site configuration" />
    </sub>
