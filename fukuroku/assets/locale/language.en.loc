    <add key="SETTINGS_NL_Label_Reorder_Observer_Area" value="Reorder Observer Area" />
    <add key="SETTINGS_NL_Label_Send_Table_To_Playing_Area" value="Send Table to Playing Area" />
    <add key="SETTINGS_NL_Tooltip_Title_Send_Table_To_Playing_Area" value="SEND TABLES TO PLAYING SLOTS" />
    <add key="SETTINGS_NL_Tooltip_Body_Send_Table_To_Playing_Area" value="When you hover a table with your mouse and press this hotkey, it will be moved to the next available playing slot. It also works for unsupported sites and emulators! Don't forget to report the unsupported sites in our forums!" />
    <add key="SETTINGS_NL_Label_Send_Table_To_Observer_Area" value="Send Table to Observer Area" />
    <add key="SETTINGS_NL_Move_Tables_Clicking_Anywhere" value="Move tables by clicking anywhere on the client area" />
    <add key="SETTINGS_NL_Tooltip_Title_Move_Tables_Clicking_Anywhere" value="Move Tables By Clicking Anywhere" />
    <add key="SETTINGS_NL_Tooltip_Body_Move_Tables_Clicking_Anywhere" value="This feature will let you drag a table without having to annoyingly click on the title bar of the window. Make sure to click the table and not a child of it like one of the HUDs. The lower 20% of the table area will not work, we did this to avoid problems with the built-in bet sliders of the poker sites" />
    <add key="SETTINGS_NL_Hide_Title_Bar_Of_Tables" value="Hide the title bar of the tables" />
    <add key="SETTINGS_NL_Tooltip_Title_Send_Table_To_Observer_Area" value="SEND TABLES TO OBSERVE SLOTS" />
    <add key="SETTINGS_NL_Tooltip_Body_Send_Table_To_Observer_Area" value="When you hover a table with your mouse and press this hotkey, it will be moved to the next available observe slot. It also works for unsupported sites and emulators! Don't forget to report the unsupported sites in our forums!" />
