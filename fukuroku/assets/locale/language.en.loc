      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Auto_Timebank" value="Auto Timebank" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Avoid_Sitting_Out" value="Avoid Sitting Out" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Title_Avoid_Sitting_Out" value="Avoid sitting out" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Body_Avoid_Sitting_Out" value="If you run out of time, including or not your timebank, this feature will automatically tell the poker room you are back into the table." />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Keep_The_Spins_Rolling" value="Keep the Spins Rolling" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Hide_Hero_Balance" value="Hide Hero Balance" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Title_Hide_Hero_Balance" value="Hide Balance" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Body_Hide_Hero_Balance" value="With this feature you can hide your bankroll at the poker site, a clickeable eye will appear next to your balance to toggle its visibility" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Title_Keep_Spins_Rolling" value="Keep the spins rolling" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Body_Keep_Spins_Rolling" value="After a Spin has ended, Jurojin will buy you another ticket to start a new one immediately! Don't forget to turn this off once you are done playing!" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Copy_Player_Name" value="Copy Player Name" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Dont_Remove" value="Don’t remove the &lt;&gt; on &lt;PLAYER&gt; for this function to work" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Custom_Link" value="Custom Link" />
