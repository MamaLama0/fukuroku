    <add key="APP_LIMITATIONS_LOW_STAKES_QUOTA_REACHED" value="Ops, você atingiu a cota acima de Low-Stakes. Faça upgrade para desbloquear!" />
    <add key="APP_LIMITATIONS_LOW_STAKES_QUOTA_REACHED_ACTION" value="Faça upgrade para desbloquear!" />
