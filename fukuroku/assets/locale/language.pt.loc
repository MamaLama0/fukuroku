  <area id="115" name="Walkthrough">
    <sub id="0" name="Intro">
      <add key="WALK_INTRO_SKIP_OPTION_Label_Intro" value="A Demonstração foi interrompida. Queres recomeçar?" />
      <add key="WALK_INTRO_SKIP_OPTION_Label_Button_Skip" value="SALTAT" />
      <add key="WALK_INTRO_SKIP_OPTION_Label_Button_Continue" value="COMEÇAR" />
    </sub>
    <sub id="1" name="Language Selection">
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Welcome" value="BEM-VINDO!" />
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Intro" value="Iremos guiar-te pelas definições mais básicas e como as configurar" />
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Choose_Language" value="SELECCIONA O IDIOMA" />
      <add key="WALK_INTRO_FINISH_Label_Button_LetsStart" value="VAMOS COMEÇAR!" />
    </sub>
    <sub id="2" name="Finish">
      <add key="WALK_INTRO_FINISH_Label_Welcome" value="TERMINADO" />
      <add key="WALK_INTRO_FINISH_Label_Line1" value="Óptimo! Já poder usar o Jurojin" />
      <add key="WALK_INTRO_FINISH_Label_Line2" value="Joga &amp; Desfruta! Boa sorte nas mesas!" />
      <add key="WALK_INTRO_FINISH_Label_Button_PlayNow" value="JOGAR AGORA" />
    </sub>
    <sub id="3" name="Layouts">
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Layout" value="Comecemos por configurar um Layout. Clica em configuração de Layout" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Create_New_Layout" value="O layout é a tua maneira de dizer ao Jurojin para onde queres que as tuas mesas sejam enviadas. Clica aqui para criares um novo Layout" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Intro" value="Esta opção deixa-te criar um layout manualmente" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Automatically" value="Se quiseres criar um layout rapidamente, podes optar pela criação automática" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_From_Preset" value="Ou podes escolher uma opção de entre os nossos modelos de layout" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Clone_Existing" value="Ou você pode clonar um layout existente. Útil para criar um layout semelhante a um já criado e economizar tempo." />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Action" value="Por agora, vamos fazer um manualmente, para poderes conhecer todas as tuas opções" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Slot" value="Este botão adiciona um Slot de Jogo. As tuas mesas serão enviadas para aqui por defeito" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Observer_Slot" value="Também podes adicionar um Slot de Observação. Podes usar estes slots para observar mesas onde não estejas a jogar" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Replay_Slot" value="Os slots de replay são apenas para replays de mãos (nem todos os sites suportam esta opção)" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Lobby_Slot" value="As janelas do Lobby também podem ser reconhecidas pelo Jurojin e ser enviadas para um slot de lobby. Tem em conta que as janelas de lobby não são redimensionadas como as mesas, apenas poderás definir onde queres que apareçam" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_CopyBottom" value="Clica neste botão para criar um novo slot com o mesmo tamanho exactamente por debaixo deste" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_DeleteSlot" value="Se precisares de apagar um slot, basta clicares no balde do lixo. Apagar este slot" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Slots_Create_Layout" value="Agora que sabes como adicionar slots, cria o teu layout. Quando terminares, clica no botão para continuar e grava o teu layout" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Save_Layout" value="Feito! Agora grava o teu layout para podermos continuar" />
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Back" value="Agora voltamos atrás para ver mais opções" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Tab_Header_Automatic_Layout_Switch" value="Aqui você pode configurar o Jurojin para alternar layouts automaticamente" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Select_Automatic_Layout_Options" value="Você pode configurar esta seção selecionando as opções adequadas" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Or_Observer_Slot" value="" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Dynamic_Slots" value="" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Action_Required_Slots" value="" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_InHand_Slots" value="" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys_Tab" value="" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys" value="" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkey_Dynamic_Slots" value="" />
    </sub>
    <sub id="4" name="Sites Config">
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Sites" value="Clica aqui para ir para Configurações de Sites" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATIONS_Party_Poker_Hex" value="Clica para veres as configurações disponíveis para a Pokerstars (se não jogas na Stars, não te preocupes. Poderás configurar os teus sites depois)" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Toggle_Tiling_Status" value="Com este botão você pode habilitar / desabilitar o tiling (somente para este site)." />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Tiling_Options_Details" value="Aqui você poderá configurar como as mesas são movidas/agrupadas automaticamente para um site de poker específico." />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Check_Auto_Play_On_Launch" value="Quando aqui está ligado, assim que o Jurojin for aberto, todas as tuas mesas serão movidas de acordo com as tuas configurações anteriores. Esta opção poupa-te o tempo de clicares em PLAY no Jurojin para começar a detectar as mesas. Recomendamos fortemente que utilizes esta opção" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Save_Settings" value="Podes agora gravar as tuas definições pretendidas" />
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Back" value="Agora voltamos atrás de novo para ver mais opções" />
    </sub>
    <sub id="5" name="General Configuration">
      <add key="WALK_SCENARIO_GENCONFIG_HAMBURGER_MENU_ITEM_Configuration" value="Este botão leva-te para as Configurações Gerais" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Playing_Area" value="A área de jogo pode ser magnetizada, isto significa que podes arrastar com o rato as mesas para que elas fiquem imediatamente nos slots. Também as podes mover pressionando a tecla CTRL para elas se empilharem em vez de trocarem" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Observer_Area" value="Os slots de Observação também podem ser magnetizados" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tooltip_Magnetize_Playing_Area" value="Este ícone lhe dará uma pequena explicação sobre cada recurso" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Lobby_Slots" value="Bem como os slots de lobby. Desde que ambos tenham a opção de empilhar" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Observer_Area_Table_Closed" value="Podes optar por reorganizar as mesas nos slots de observação quando uma delas é fechada" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Playing_Area_Table_Closed" value="Podes optar por reorganizar as mesas nos slots de jogo quando uma delas é fechada" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Focus_Table_Under_Mouse" value="Esta opção coloca-te a mesa à frente quando lhe passas o rato por cima" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Highlight_Table_Under_Focus" value="Quando a tabela ficar focada, realce-a com uma borda colorida" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Show_Random_Number_Generator" value="Mostre um gerador de números de alteração em forma de chip. Se você deixar essa opção ativada, verá a guia assim que este guia terminar!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Minimize_To_System_Tray" value="Quando você pressiona o botão minimizar, o aplicativo aparece apenas na bandeja do sistema (pequenos ícones no canto inferior direito do Windows)" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Keep_Most_Urgent_On_Top" value="Quando você tem mais de uma mesa empilhada no mesmo slot, Jurojin manterá a mais urgente no topo. Quando você age, o próximo item mais urgente vai para o topo." />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_WorksFor_Keep_Most_Urgent_On_Top" value="Existem alguns recursos que não funcionam para todos os sites! Com este ícone você pode verificar quais suportam isso!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Global" value="Você pode ativar ou desativar essas opções para tornar o Jurojin ideal!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Global_Hotkeys" value="Estas são as hotkeys gerais disponíveis no Jurojin" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Set_HotKeys" value="Podes programar as hotkeys seleccionando o campo e clicando no atalho no teclado" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Table_Border" value="Aqui você pode configurar as bordas coloridas de suas mesas! Algumas seções possuem abas como esta, não se esqueça de verificar!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Table_Border" value="Você pode ativar esta opção para ter uma borda violeta sobre a mesa em foco" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Save_Changes" value="Gravar definições" />
    </sub>
    <sub id="6" name="HotKeys Config">
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_HAMBURGER_MENU_ITEM_HotKeys" value="Aqui você poderá definir teclas de atalho para realizar ações nas mesas como check / fold / bet / raise!" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Intro" value="Defina seus atalhos de teclado com o mouse ou teclado para suas apostas e ações! Alguns sites como o GGPoker exigem que você faça algumas configurações extras, verifique nosso FAQ para mais informações!" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Discord_Intro" value="Parece que você não tem acesso a este recurso! Ao clicar neste botão você pode solicitar acesso deixando seu nome de usuário Jurojin no chat" />
    </sub>
    <sub id="7" name="Controller Config">
      <add key="WALK_SCENARIO_CONTROLLER_HAMBURGER_MENU_ITEM_Controller" value="Também adicionamos suporte a controle para alguns sites de poker!" />
      <add key="WALK_SCENARIO_CONTROLLER_Page_Intro" value="Pegue algumas cervejas, sente-se no sofá e aproveite algumas rodadas com nosso novo suporte a controle!" />
    </sub>
    <sub id="8" name="Overlays Config">
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_HAMBURGER_MENU_ITEM_Overlays" value="Nesta visualização você pode configurar as camadas que aparecem nas suas mesas!" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Page_Intro" value="Qualquer item que apareça sobre cada mesa está nesta visualização, aqui você pode ligá-los e desligá-los, bem como configurar alguns aspectos sobre eles!" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Table_Overlays_Contents" value="Aqui você pode configurar as camadas que aparecem dentro de suas mesas. As camadas mostrarão estatísticas diferentes que são super úteis no jogo. Clique em saiba mais ao lado de cada camada para ver dicas sobre elas." />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Tab_Seats_Overlays_Intro" value="Vamos para a seção de camadas de assento" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Seats_Overlays_Contents" value="As camadas de assento estão sempre coladas ao lado de um assento de jogador e mostram coisas como posição e histórico de ações, certifique-se de ter o herói centralizado nas configurações do site" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Tab_Table_Counters_Intro" value="Agora vamos verificar as camadas de contadores" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Table_Counters_Contents" value="As camadas de contadores exibirão informações relacionadas às mesas no slot onde a mesa está localizada (se houver)" />
    </sub>
    <sub id="9" name="Changelog">
      <add key="WALK_SCENARIO_CHANGELOG_HAMBURGER_MENU_ITEM_Changelog" value="Nesta seção você poderá ler sobre as últimas notícias do app! Fica vermelho quando há novidades!" />
      <add key="WALK_SCENARIO_CHANGELOG_Page_Intro" value="Saiba mais sobre as últimas notícias aqui!" />
    </sub>
