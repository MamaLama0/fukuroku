    <add key="APP_LIMIATIONS_MAX_TILED_TABLES_REACHED" value="Você só pode acomodar duas mesas de stakes mais altos e uma quantidade ilimitada se forem de microstakes!" />
    <add key="APP_LIMIATIONS_MAX_TILED_TABLES_REACHED_ACTION" value="Obter o Bundle de Tiling" />
    <add key="APP_LIMITATIONS_NEW_TABLE_GAINED_HOTKEY_RIGHTS" value="Esta é agora a mesa de stakes mais altos onde você tem hotkeys grátis!" />
    <add key="APP_LIMITATIONS_NEW_TABLE_GAINED_HOTKEY_RIGHTS_ACTION" value="Ativar hotkeys para todas as mesas" />
    <add key="APP_LIMITATIONS_TABLE_DOESNT_HAVE_HOTKEY_RIGHTS" value="Você não pode usar hotkeys nesta mesa" />
    <add key="APP_LIMITATIONS_TABLE_DOESNT_HAVE_HOTKEY_RIGHTS_ACTION" value="Ativar hotkeys para todas as mesas" />
    <add key="APP_LIMITATIONS_TABLE_DOESNT_HAVE_HOTKEY_RIGHTS_SHOW_FREE_TABLE" value="Esta é a mesa de stakes mais altos onde você tem hotkeys grátis!" />
    <add key="APP_LIMITATIONS_NEW_TABLE_GAINED_OVERLAY_RIGHTS" value="Esta é agora a mesa com Overlays grátis" />
