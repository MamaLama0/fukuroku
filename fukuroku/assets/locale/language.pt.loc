    <add key="APP_WINDOW_NL_Popup_Signup_Title" value="REGISTA-TE" />
    <add key="APP_WINDOW_NL_Popup_Signup_Subtitle" value="PARA COMEÇARES O TEU TRIAL!!" />
    <add key="APP_WINDOW_NL_" value="" />
    <sub id="0" name="Error Messages">
      <add key="ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_NL_MESSAGE" value="Detectamos uma mudança na configuração de seus monitores e seu layout ativo atual tem slots fora dos limites. Quer editar o Layout Ativo agora?" />
      <add key="ON_APPLICATION_ERROR_Title" value="Erro de Servidor" />
      <add key="ON_SERVER_FATAL_ERROR_MESSAGE" value="Ligação perdida. Verifica a tua ligação à Internet." />
      <add key="ON_ERROR" value="Parece que ocorreu um erro! Entre em contato conosco via discord para resolvê-lo! https://jurojinpoker.com/discord" />
      <add key="ON_APPLICATION_MAINTENANCE_Title" value="Manutenção do Servidor" />
      <add key="ON_APPLICATION_MAINTENANCE_Text" value="Precisamos que você reabra Jurojin agora, provavelmente você voltará ao seu usuário normal no aplicativo após a reabertura!" />
      <add key="DLL_MISSING_ERROR_TITLE" value="Arquivos ausentes" />
      <add key="DLL_MISSING_ERROR_MESSAGE" value="Você tem arquivos ausentes que são necessários para execução! Geralmente é o antivírus que os exclui! Adicione uma exceção à pasta de instalação do Jurojin em seu antivírus ou Windows Defender e tente usar o aplicativo novamente. Se você continuar vendo esta mensagem de erro depois de fazer isso, faça o download do nosso instalador mais recente em https://jurojinpoker.com/download?v=345789/" />
      <add key="INSTALLATION_INTEGRITY_ERROR_TITLE" value="Instalação modificada" />
      <add key="INSTALLATION_INTEGRITY_ERROR_MESSAGE" value="O Jurojin detectou uma alteração inesperada nos arquivos de instalação. Por segurança, o aplicativo será fechado. Reinstale em https://jurojinpoker.com/download" />
      <add key="UNHANDLED_EX_ERROR_OUTOFMEMORY" value="" />
      <add key="GLOBALFEATURE_ERROR" value="" />
      <add key="PLAYINGSESSIONHANDLER_ERROR" value="" />
      <add key="HOOKCONTROLLER_ERROR" value="" />
      <add key="EMERGENCY_SHUTDOWN_CANNOT_CONNECT_TO_SERVERS_MESSAGE" value="" />
      <add key="KEEP_ALIVE_RECONNECT_ENTITLEMENTS_REVOKED_TOAST" value="Seu PC não consegue se conectar aos nossos servidores. Verifique sua conexão com a internet e o firewall/antivírus" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Title" value="Problema de conexão" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Body" isFormatted="true" value="&lt;p&gt;Sua assinatura continua ativa, mas o Jurojin não consegue alcançar nossos servidores a partir do seu PC. Os recursos foram desativados temporariamente por segurança.&lt;/p&gt;&lt;p&gt;Verifique sua conexão com a internet, firewall e antivírus e aguarde o Jurojin se reconectar automaticamente.&lt;/p&gt;" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Open_Guide" value="Abrir guia de solução de problemas" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Got_It" value="Entendi" />
    </sub>
