    <add key="SETTINGS_NL_CheckBox_Magnetize_Playing_Area" value="Magnetizar Área de Jogo" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Playing_Area" value="Magnetize a Área/Slots de Jogo" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Playing_Area" value="A área de jogo pode ser magnetizada, isso significa que você pode arrastar e soltar as mesas e elas se encaixarão nos slots imediatamente. Você também pode arrastar e soltar pressionando a tecla CTRL para evitar a troca das tabelas, em vez disso, elas serão empilhadas" />
