    <add key="SETTINGS_NL_Tooltip_Body_Minimize_Application_To_System_Tray" value="Quando você pressiona o botão minimizar com esse recurso ativado, o aplicativo irá para a bandeja do sistema no canto inferior direito do Windows." />
