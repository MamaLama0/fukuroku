  <area id="120" name="Toasters">
    <add key="ACTIVE_LAYOUT_TOASTER_TEXT" value="LAYOUT ATIVO:" />
    <add key="NO_ACCESS_TO_FEATURE_MESSAGE" value="Sem acesso a #name# no # game#! Por favor, pergunte em nossa comunidade Discord!" />
    <add key="HOTKEYS_DISABLED_FOR_SITE" value="Lembre-se de que você desativou as teclas de atalho para o site #game#! Você pode ativá-los novamente na seção de teclas de atalho!" />
    <add key="OVERLAYS_POSITION_SAVED" value="Suas posições de camadas agora foram salvas!" />
    <add key="APP_LOCATION_RESTORED" value="Localização do app restaurada" />
    <add key="INJECTION_AVOIDED_VIA_BACKOFFICE_NOTIF" value="Por favor, reabra o aplicativo! Uma de suas salas de pôquer está agora em modo de diagnóstico e precisamos que todos reabra o aplicativo para resolver o problema o mais rápido possível!" />
    <add key="INJECTION_AVOIDED_VIA_BACKOFFICE" value="#game# não terá recursos de organização, pois foi desativado pela equipe Jurojin!" />
    <add key="HOSTS_FILE_BLOCKS_HELP_REPORT" value="O suporte está bloqueado pelo arquivo hosts. Contate o suporte." />
    <add key="COINPOKER_ALT_STUCK_UNJAMMED" value="CoinPoker Alt Stucked was Unjammed" />
    <add key="NEW_APP_VERSION_NOTIFICATION" value="Você tem uma nova atualização pendente! Recomendamos reabrir Jurojin para obter a versão mais recente!" />
    <add key="MOVE_ARROUND_HOTKEYS_DISCLAIMER" value="Certifique-se de desligar &quot;Foco de Mesa Sobre o Mouse&quot; ou deixe o ponteiro do mouse em um canto se for jogar com o teclado!" />
    <add key="SPACEBAR_NOT_RECOMMENDED" value="Você não deve usar a barra de espaço como tecla de atalho no #game# pois gera vários bugs!" />
    <add key="KEEP_MOST_URGENT_MESSAGE" value="Abrimos um guia em seu navegador para que você possa configurar cada site adequadamente para o recurso 'Mantenha os mais Urgentes no Topo'" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_TITLE" value="Jogar sem o mouse?" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_BODY" value="Auto Focus move o foco do teclado para a mesa mais urgente. Para fold, check ou bet sem o mouse, as hotkeys da mesa devem apontar para a mesa em foco." />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_YES" value="Sim, alterar" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_IGNORE" value="Ignorar" />
    <add key="ONE_TABLE_HOTKEYS_MESSAGE" value="Você só pode usar teclas de atalho em uma mesa por vez! Por favor, confira nossa loja se você quiser usá-los em todas as mesas!" />
    <add key="CONNECTION_COLLIDED" value="O aplicativo só pode ser usado em um PC por vez, seu aplicativo permanecerá aberto em seu outro PC" />
    <add key="PACIFIC_POKER_X64" value="Você tem uma versão x64 do 888Poker onde apenas o mosaico funcionará. Você pode seguir nosso guia, instalar uma versão x86 irá corrigi-lo" />
    <add key="PACIFIC_POKER_X64_WORKING" value="Jurojin agora suporta totalmente a versão 888 (x64), faça o download e instale o software 888 mais recente para sua região." />
    <add key="TABLE_BURIED_IN_STACK_DIALOG" value="Você tem mesas urgentes &quot;enterradas&quot; em uma pilha! Um artigo muito útil será aberto em seu navegador ao fechar esta caixa de diálogo, ative o recurso 'Manter os Mais Urgentes no Topo'" />
    <add key="TABLE_BURIED_IN_STACK_TOASTER" value="Você tem tabelas urgentes enterradas em uma pilha, considere habilitar o recurso 'Manter os Mais Urgentes no Topo'." />
    <add key="STACK_GUIDANCE_STACKING_OFF" value="Ops — você tem várias mesas em um slot e os recursos de stacking estão desligados. Vamos mostrar como corrigir. Um guia abrirá no navegador ao fechar este diálogo." />
    <add key="STACK_GUIDANCE_ENHANCE_STACK" value="Você está no caminho certo com o jogo em stack. Vamos mostrar mais alguns recursos que farão a diferença. Um guia abrirá no navegador ao fechar este diálogo." />
    <add key="APP_LIMITATIONS_FREE_TIER_STAKE_NOT_COVERED" value="O plano Free Tier não cobre esta mesa devido ao stake. Assine e desbloqueie!" />
