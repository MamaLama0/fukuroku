      <add key="EDIT_LAYOUT_NL_Button_Add_Observer_Area_Slot" value="Ajouter un Slot d'OBSERVATION" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Replay_Area_Slot" value="Ajouter un Slot de REPLAY" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Lobby_Slot" value="Ajouter un Slot de LOBBY" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Action_Required_Slot" value="Ajouter un Slot ACTION REQUISE" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Title_Action_Required" value="Action Requise" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Body_Action_Required" value="Ces slots représentent la zone de l'écran où les tables vont quand c'est votre tour de jouer. Il n'y aura qu'une table à la fois dans ce type de slots, lorsque tous ces slots sont occupés, les tables vont dans les slots de file d'attente, et une fois le slot action requise libéré, la table la plus urgente de la file est envoyée." />
      <add key="EDIT_LAYOUT_NL_Button_Add_Queue_Slot" value="Ajouter un slot QUEUE" />
      <add key="EDIT_LAYOUT_NL_Button_Add_In_Hand_Slot" value="Ajouter un slot IN HAND" />
      <add key="EDIT_LAYOUT_NL_Button_Save_Changes" value="Sauvegarder les modifications" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Title" value="Certains slots seront supprimés" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Message" value="Les slots marqués de bordures rouges sont soit hors des limites de l'écran, soit en chevauchement avec d'autres slots et seront supprimés. Voulez-vous continuer ?" />
      <add key="EDIT_LAYOUT_NL_Label_Stack_Tables_In_Ar_Slot" value="Empiler les tables dans le slot AR au moment où c'est votre tour sur chacune d'elles" />
      <add key="EDIT_LAYOUT_Tooltip_Title_In_Hand" value="Slots In Hand" />
      <add key="EDIT_LAYOUT_Tooltip_Body_In_Hand" value="Les slots In Hand sont la meilleure façon de se concentrer uniquement sur les mains importantes, les tables s'y déplaceront lorsque vous VPIP. Vous pouvez configurer ce comportement dans chaque configuration de site" />
    </sub>
