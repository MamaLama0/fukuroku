    <sub id="3" name="Layouts">
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Layout" value="Commençons par configurer un Layout. Cliquez sur l’élément de menu de configuration du Layout" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Create_New_Layout" value="Le layout est votre façon d’indiquer à Jurojin où vous voulez envoyer vos tables. Cliquez ici pour créer un nouveau Layout" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Intro" value="Cette option vous permet de créer un layout manuellement" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Automatically" value="Si vous souhaitez créer le layout rapidement, vous pouvez utiliser la fonction de création automatique" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_From_Preset" value="Ou vous pouvez choisir une option parmi nos modèles de layouts" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Clone_Existing" value="Ou vous pouvez cloner un layout existant. Utile pour créer un layout similaire à un existant et gagner du temps." />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Action" value="Pour l’instant, faisons-en un manuellement afin que vous découvriez toutes vos options" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Slot" value="Ce bouton ajoute un Playing Slot. Vos tables seront envoyées ici par défaut" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Observer_Slot" value="De même, vous pouvez ajouter un Observer Slot. Vous pouvez utiliser ces slots pour observer les tables où vous ne jouez pas" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Replay_Slot" value="Les Replay slots sont uniquement pour les replays de mains (pas tous les sites supportent cette fonctionnalité)" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Lobby_Slot" value="Les fenêtres de lobby peuvent également être reconnues par Jurojin et envoyées à un lobby slot. Notez que les fenêtres de lobby ne sont pas redimensionnées comme les tables, vous ne pouvez donc définir que leur emplacement" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_CopyBottom" value="Appuyez sur ce bouton maintenant pour créer un nouveau slot de la même taille que celui actuel juste en dessous" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_DeleteSlot" value="Si vous devez supprimer un slot, appuyez simplement sur la poubelle. Supprimer ce slot" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Slots_Create_Layout" value="Maintenant que vous savez comment ajouter des slots, créez votre layout. Une fois terminé, cliquez sur le bouton pour continuer et sauvegarder votre layout" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Save_Layout" value="C’est terminé ! Sauvegardez maintenant votre layout pour que nous puissions continuer" />
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Back" value="Revenons en arrière pour voir d’autres fonctionnalités" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Tab_Header_Automatic_Layout_Switch" value="Ici, vous pouvez configurer Jurojin pour changer les layouts automatiquement" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Select_Automatic_Layout_Options" value="Configurez la commutation automatique des layouts comme vous le souhaitez maintenant !" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Or_Observer_Slot" value="Avec ces boutons, vous pouvez ajouter des playing ou observer slots à votre layout. Avec la fonctionnalité Keep Most Urgent on top dans les paramètres généraux, vous pouvez empiler les tables dans le même slot et elles apparaîtront dans l’ordre !" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Dynamic_Slots" value="Avec ces deux boutons, vous pouvez ajouter des slots dynamiques. Vous ne pouvez choisir qu’un seul de ces deux types à ajouter à votre layout car ils offrent un flux différent pour vos tables" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Action_Required_Slots" value="Avec le slot action required, les tables y seront déplacées chaque fois que c’est votre tour d’agir" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_InHand_Slots" value="Avec le slot in hand, les tables seront déplacées chaque fois que vous entrez dans la main, faites du vpip, postez la blind, etc. Ceci peut être configuré dans chaque configuration de site" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys_Tab" value="Vérifions maintenant l’onglet des raccourcis clavier du layout..." />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys" value="Vérifions maintenant l’onglet des raccourcis clavier du layout..." />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkey_Dynamic_Slots" value="Avec ce raccourci, vous pouvez verrouiller une table hors du flux des slots dynamiques, elle reste donc où elle est. Très utile quand vous jouez une grosse main ou une table finale" />
    </sub>
    <sub id="4" name="Sites Config">
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Sites" value="Cliquez ici pour aller à la configuration des sites" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATIONS_Party_Poker_Hex" value="Cliquez pour voir quelles configurations sont disponibles pour Pokerstars (si vous ne jouez pas sur Stars, ne vous inquiétez pas. Vous pourrez configurer vos sites plus tard)" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Toggle_Tiling_Status" value="Avec ce bouton vous pouvez activer/désactiver le tiling (seulement pour ce site)." />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Tiling_Options_Details" value="Ici vous pourrez configurer comment les tables sont automatiquement déplacées/tilées pour un site de poker spécifique." />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Check_Auto_Play_On_Launch" value="Quand cette option est activée, une fois Jurojin ouvert, toutes vos tables seront déplacées selon ce que vous avez configuré ci-dessus. Cette option vous fait gagner du temps en évitant d’appuyer sur PLAY dans Jurojin pour commencer la détection des tables. Nous vous recommandons vivement d’utiliser cette fonctionnalité" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Save_Settings" value="Si vous avez des modifications à sauvegarder, c’est le moment ! Sinon, appuyez sur passer" />
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Back" value="Retournez en arrière et découvrons d’autres fonctionnalités" />
    </sub>
    <sub id="5" name="General Configuration">
      <add key="WALK_SCENARIO_GENCONFIG_HAMBURGER_MENU_ITEM_Configuration" value="Ce bouton vous mène à la Configuration générale" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Playing_Area" value="La zone de jeu peut être magnétisée, cela signifie que vous pouvez glisser-déposer les tables et elles s’aligneront immédiatement sur les slots. Vous pouvez aussi glisser-déposer en maintenant la touche CTRL pour éviter l’échange des tables, elles seront alors empilées" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Observer_Area" value="Les Observer slots peuvent aussi être magnétisés" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tooltip_Magnetize_Playing_Area" value="Cet icône vous donnera une petite explication pour chaque fonctionnalité" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Lobby_Slots" value="De même que les lobby slots. Tant que les lobby slots ont l’option stack sites" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Observer_Area_Table_Closed" value="Vous pouvez faire réordonner les tables dans les observer slots quand l’une d’elles est fermée" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Playing_Area_Table_Closed" value="Vous pouvez faire réordonner les tables dans les slots de jeu lorsque l'une d'entre elles est fermée" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Focus_Table_Under_Mouse" value="Cette fonctionnalité met la table au premier plan lorsque vous la survolez avec la souris" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Highlight_Table_Under_Focus" value="Cela va mettre en surbrillance la bordure de la table focus." />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Show_Random_Number_Generator" value="Cela affichera le générateur de nombres aléatoires au démarrage de l'application. Si vous laissez cette fonction activée, le RNG apparaîtra dès que vous aurez fini ce guide !" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Minimize_To_System_Tray" value="Quand vous appuyez sur le bouton réduire, l’application apparaîtra seulement dans la zone de notification (petites icônes en bas à droite de Windows)" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Keep_Most_Urgent_On_Top" value="Quand vous avez plusieurs tables empilées dans le même slot, Jurojin garde la table la plus urgente en haut. Quand vous agissez, la table suivante la plus urgente passe en haut." />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_WorksFor_Keep_Most_Urgent_On_Top" value="Certain fonctionnalités ne fonctionnent pas sur tous les sites ! Avec cette icône, vous pouvez vérifier lesquels sont compatibles !" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Global" value="Vous pouvez activer ou désactiver ces options pour rendre Jurojin idéal !" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Global_Hotkeys" value="Voici les raccourcis clavier généraux disponibles dans Jurojin" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Set_HotKeys" value="Vous pouvez définir les raccourcis en sélectionnant le champ et en appuyant sur le raccourci clavier" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Table_Border" value="Ici vous pouvez configurer les bordures colorées de vos tables ! Certaines sections ont des onglets comme celui-ci, n'oubliez pas de vérifier !" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Table_Border" value="Vous pouvez activer cette option pour avoir une bordure violette autour de la table focalisée" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Save_Changes" value="Enregistrez vos paramètres ou appuyez simplement sur ignorer l'enregistrement" />
    </sub>
    <sub id="6" name="HotKeys Config">
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_HAMBURGER_MENU_ITEM_HotKeys" value="Ici vous pourrez définir des raccourcis pour effectuer des actions sur les tables comme check/fold/bet/raise !" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Intro" value="Définissez vos raccourcis avec la souris ou le clavier pour vos mises et actions ! Certains sites comme GGPoker nécessitent une configuration supplémentaire, consultez notre FAQ pour plus d'infos !" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Discord_Intro" value="Il semble que vous n'ayez pas accès à cette fonctionnalité ! En cliquant sur ce bouton, vous pouvez demander l'accès en laissant votre nom d'utilisateur Jurojin dans le chat" />
    </sub>
    <sub id="7" name="Controller Config">
      <add key="WALK_SCENARIO_CONTROLLER_HAMBURGER_MENU_ITEM_Controller" value="Nous avons également ajouté la prise en charge des contrôleurs pour certains sites de poker !" />
      <add key="WALK_SCENARIO_CONTROLLER_Page_Intro" value="Prenez quelques bières, asseyez-vous sur le canapé et profitez de quelques spins avec notre nouveau support contrôleur !" />
    </sub>
    <sub id="8" name="Overlays Config">
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_HAMBURGER_MENU_ITEM_Overlays" value="Dans cette vue, vous pouvez configurer les overlays qui apparaissent au-dessus de vos tables !" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Page_Intro" value="Tout élément apparaissant sur chaque table se trouve dans cette vue, vous pouvez ici les activer ou désactiver ainsi que configurer certains aspects !" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Table_Overlays_Contents" value="Ici vous pouvez configurer les overlays qui apparaissent à l'intérieur de vos tables. Ces overlays affichent différentes statistiques très utiles en jeu. Cliquez sur en savoir plus à côté de chaque overlay pour voir des guides à leur sujet" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Tab_Seats_Overlays_Intro" value="Passons à la section des overlays de siège" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Seats_Overlays_Contents" value="Les overlays de siège sont toujours collés à côté d'un siège joueur et montrent des informations comme la position et la ligne d'actions, assurez-vous que le héros soit centré dans les configs des sites" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Tab_Table_Counters_Intro" value="Passons maintenant aux overlays de compteur" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Table_Counters_Contents" value="Les overlays de compteur affichent des infos liées aux tables sur le slot où la table est située (le cas échéant)" />
    </sub>
    <sub id="9" name="Changelog">
      <add key="WALK_SCENARIO_CHANGELOG_HAMBURGER_MENU_ITEM_Changelog" value="Dans cette section, vous pourrez lire les dernières nouveautés de l'application ! L'icône devient rouge lorsqu'il y a des nouveautés !" />
      <add key="WALK_SCENARIO_CHANGELOG_Page_Intro" value="Découvrez ici les dernières nouveautés !" />
    </sub>
    <sub id="10" name="Outro">
      <add key="WALK_SCENARIO_GENOUTRO_REPORT_ISSUE" value="Si vous rencontrez des problèmes, utilisez le bouton signaler pour que nous puissions vous aider, ou rejoignez notre canal Discord !" />
      <add key="WALK_SCENARIO_GENOUTRO_WALKTHROUGH_ON_DEMAND" value="Vous pouvez revoir ce guide à tout moment en appuyant sur ce bouton." />
    </sub>
    <sub id="11" name="Others">
      <add key="WALK_Common_Label_User_Action_Complete" value="TERMINÉ !" />
      <add key="WALK_Common_Label_User_Intro_Acknowledge" value="COMPRIS" />
      <add key="WALK_Common_Skip_Saving" value="Ignorer l'enregistrement" />
      <add key="WALK_Button_See_Walkthrough_Again" value="VOIR LE GUIDE À NOUVEAU" />
      <add key="WALK_Button_Guide" value="GUIDE" />
      <add key="WALK_Button_Skip_To_End" value="Je finirai ce guide plus tard" />
    </sub>
  </area>
  <area id="116" name="Walkthrough V2">
    <sub id="0" name="Intro">
      <add key="WALKV2_INTRO_Title_Welcome_To_Jurojin_Poker" value="Bienvenue sur Jurojin Poker !" />
      <add key="WALKV2_INTRO_Label_Choose_Your_Language_To_Begin" value="Choisissez votre langue pour commencer" />
      <add key="WALKV2_INTRO_Button_Lets_Start" value="Commençons" />
    </sub>
    <sub id="1" name="Mini Intro">
      <add key="WALKV2_MINI_INTRO_Title_Lets_Learn_The_Basics" value="Apprenons les bases..." />
      <add key="WALKV2_MINI_INTRO_Description_I_Will_Be_Guiding_You_Through_The_App" value="Je vais vous guider à travers l’application pour que vous découvriez nos fonctionnalités les plus importantes ! Dans Jurojin, vous trouverez trois fonctionnalités principales. Vous pouvez cliquer sur n'importe laquelle d'elles pour en savoir plus." />
      <add key="WALKV2_MINI_INTRO_Button_Tiling" value="Tiling" />
      <add key="WALKV2_MINI_INTRO_Button_Hotkeys" value="Raccourcis" />
      <add key="WALKV2_MINI_INTRO_Button_Overlays" value="Overlays" />
      <add key="WALKV2_MINI_INTRO_Button_I_Will_Go_Through_Jurojin_Myself" value="Je vais parcourir Jurojin moi-même" />
    </sub>
    <sub id="2" name="Mini Finish">
      <add key="WALKV2_MINI_FINISH_Title_Well_Done" value="Bien joué !" />
      <add key="WALKV2_MINI_FINISH_Description_Great_You_Finished_One_Of_Our_Miniguides" value="Super ! Vous avez terminé un de nos miniguides ! Si vous souhaitez en voir un autre ou refaire celui-ci, vous pouvez le faire dès maintenant !" />
      <add key="WALKV2_MINI_FINISH_Button_Tiling" value="Tiling" />
      <add key="WALKV2_MINI_FINISH_Button_Hotkeys" value="Raccourcis" />
      <add key="WALKV2_MINI_FINISH_Button_Overlays" value="Overlays" />
      <add key="WALKV2_MINI_FINISH_Button_I_Will_Go_Through_Jurojin_Myself" value="Je vais parcourir Jurojin moi-même" />
    </sub>
  </area>
