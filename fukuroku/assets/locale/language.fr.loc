      <add key="SLOT_POSITION_ITEM_Label_Swap" value="ÉCHANGER" />
    </sub>
    <sub id="2" name="Window - Slot Size Selection">
      <add key="SLOT_SIZE_SELECTION_WINDOW_Title" value="TITRE DE LA FENÊTRE" />
      <add key="SLOT_SIZE_SELECTION_WINDOW_Label_Slot_Size" value="TAILLE DU SLOT" />
