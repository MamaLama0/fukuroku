      <add key="LAYOUT_CONFIGURATION_NL_Hotkeys_Label_Observer_Slot_No" value="Slot d'Observateur n°" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Lock_Table_Of_Dynamic_Flow" value="Bloquer la table hors du flux dynamique" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Move_Table_To_Next_Slot" value="Déplacer la table au slot suivant" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Move_Table_To_Previous_Slot" value="Déplacer la table au slot précédent" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Help_Title_Lock_Table" value="Bloquer/Réinsérer la table" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Help_Body_Lock_Table" value="Utilisez ce raccourci pour exclure ou réinsérer une table dans le flux dynamique des slots (AR/In Hand). En gros, la table reste dans le slot où elle se trouve. Vous pouvez appuyer de nouveau sur le raccourci pour remettre la table dans le flux dynamique." />
    </sub>
