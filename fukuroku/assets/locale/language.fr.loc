  <area id="105" name="Page - Settings">
    <add key="SETTINGS_NL_Tab_Title" value="Paramètres" />
    <add key="SETTINGS_NL_Tab_Header_Global_Setting" value="Paramètres globaux" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Playing_Area" value="Magnétiser la zone de jeu" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Playing_Area" value="Magnétiser la zone de jeu/slots" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Playing_Area" value="La zone de jeu peut être magnétisée, ce qui signifie que vous pouvez glisser-déposer les tables qui s'aligneront immédiatement sur les slots. Vous pouvez aussi glisser-déposer en maintenant CTRL pour éviter l'échange des tables, qui s'empileront alors." />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Observer_Area" value="Magnétiser la zone d'observation" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Observer_Area" value="Magnétiser la zone d'observation/slots" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Observer_Area" value="Les slots d'observation peuvent également être magnétisés" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Lobby_Slots" value="Magnétiser les lobby slots" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Lobby_Slots" value="Magnétiser les lobby slots" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Lobby_Slots" value="Ainsi que les lobby slots, tant que l'option stack sites est activée sur ces slots" />
    <add key="SETTINGS_NL_CheckBox_Invert_Ctrl_Key" value="Inverser l'utilisation de CTRL pour la magnétisation" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Observer_Area_When_Table_Closed" value="Réordonner la zone d'observation quand une table est fermée" />
    <add key="SETTINGS_NL_Tooltip_Title_Reoder_Observer_Area_When_Table_Closed" value="Réordonner la zone d'observation quand une table est fermée" />
    <add key="SETTINGS_NL_Tooltip_Body_Reoder_Observer_Area_When_Table_Closed" value="Vous pouvez faire réordonner les tables dans les slots d'observation lorsque l'une d'entre elles est fermée" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Playing_Area_When_Table_Closed" value="Réordonner la zone de jeu quand une table est fermée" />
    <add key="SETTINGS_NL_Tooltip_Title_Reorder_Playing_Area_When_Table_Closed" value="Réordonner la zone de jeu quand une table est fermée" />
    <add key="SETTINGS_NL_Tooltip_Body_Reorder_Playing_Area_When_Table_Closed" value="Vous pouvez faire réordonner les tables dans les slots de jeu lorsque l'une d'entre elles est fermée" />
    <add key="SETTINGS_NL_CheckBox_Keep_Most_Urgent_On_Top" value="Gérer l'urgence du stack" />
    <add key="SETTINGS_NL_Tooltip_Title_Keep_Most_Urgent_On_Top" value="Gérer l'urgence du stack" />
    <add key="SETTINGS_NL_Tooltip_Body_Keep_Most_Urgent_On_Top" value="Lorsque des tables partagent un slot (stack), Jurojin met au premier plan la table la plus urgente (le moins de temps restant pour agir). Cela gère uniquement la visibilité dans le stack — cela ne déplace pas le focus clavier." />
    <add key="SETTINGS_NL_CheckBox_Auto_Focus_Most_Urgent_Always" value="Toujours auto-focaliser la table la plus urgente" />
    <add key="SETTINGS_NL_Tooltip_Title_Auto_Focus_Most_Urgent_Always" value="Toujours auto-focaliser la table la plus urgente" />
    <add key="SETTINGS_NL_Tooltip_Body_Auto_Focus_Most_Urgent_Always" value="Lorsque la première table nécessite une action (ou après avoir agi et qu'une autre en a encore besoin), Jurojin focalise globalement la table la plus urgente pour jouer sans saisir la souris." />
    <add key="SETTINGS_NL_CheckBox_Also_Force_Move_Mouse" value="Aussi forcer le déplacement de la souris" />
    <add key="SETTINGS_NL_Tooltip_Title_Also_Force_Move_Mouse" value="Aussi forcer le déplacement de la souris" />
    <add key="SETTINGS_NL_Tooltip_Body_Also_Force_Move_Mouse" value="Déplace aussi le curseur de la souris sur la table focalisée. Utile pour le gamepad ou les sites qui exigent le curseur sur la table." />
    <add key="SETTINGS_NL_CheckBox_Minimize_App_To_System_Tray" value="Réduire l'application dans la barre système" />
    <add key="SETTINGS_NL_CheckBox_Save_Jurojin_Location_On_Close" value="" />
    <add key="SETTINGS_NL_Tooltip_Title_Alarm_For_Action_Required" value="" />
    <add key="SETTINGS_NL_Tooltip_Title_Delayed_Alarm_Action_Enabled" value="Alarme différée pour action requise" />
    <add key="SETTINGS_NL_Tooltip_Subtitle_Delayed_Alarm_Action_Enabled" value="Sonne 10 secondes après le début de votre tour" />
    <add key="SETTINGS_NL_Tooltip_Body_Delayed_Alarm_Action_Required" value="Vous pouvez demander à Jurojin de jouer une alarme après le nombre de secondes configuré depuis le début de votre tour, tant qu'une action est toujours requise." />
    <add key="SETTINGS_NL_Tooltip_Body_Minimize_Application_To_System_Tray" value="Quand vous appuyez sur réduire avec cette option activée, l'application ira dans la barre système en bas à droite de Windows." />
    <add key="SETTINGS_NL_Tooltip_Title_Minimize_Application_To_System_Tray" value="Réduire dans la barre système" />
    <add key="SETTINGS_NL_CheckBox_Show_RNG" value="Afficher le RNG" />
    <add key="SETTINGS_NL_CheckBox_Sub_Show_RNG" value="Générateur de nombres aléatoires" />
    <add key="SETTINGS_NL_Tooltip_Title_Show_Random_Number_Generator" value="RNG" />
    <add key="SETTINGS_NL_Tooltip_Body_Show_Random_Number_Generator" value="Cela affichera un RNG à l'écran (pas au-dessus des tables, c'est indépendant !)" />
    <add key="SETTINGS_NL_CheckBox_Drag_Table_Clicking_Anywhere" value="Déplacer la table en cliquant n'importe où dessus" />
    <add key="SETTINGS_NL_CheckBox_Focus_Table_Under_Mouse" value="Mettre la table sous le curseur au premier plan" />
    <add key="SETTINGS_NL_Tooltip_Title_Focus_Table_Under_Mouse" value="Mettre la table sous le curseur au premier plan" />
    <add key="SETTINGS_NL_Tooltip_Body_Focus_Table_Under_Mouse" value="Cette fonction amène la table au premier plan quand vous passez la souris dessus" />
    <add key="SETTINGS_NL_CheckBox_Bring_Only_Tables_In_Playing_Slot_To_Front" value="Mettre au premier plan seulement les tables dans le slot de jeu" />
    <add key="SETTINGS_NL_Tab_Header_Global_Hotkeys" value="Raccourcis globaux" />
    <add key="SETTINGS_NL_Label_Reorder_Playing_Area" value="Réordonner la zone de jeu" />
    <add key="SETTINGS_NL_Label_Reorder_Observer_Area" value="Réorganiser la zone d'observation" />
    <add key="SETTINGS_NL_Label_Send_Table_To_Playing_Area" value="Envoyer la table à la zone de jeu" />
    <add key="SETTINGS_NL_Tooltip_Title_Send_Table_To_Playing_Area" value="ENVOYER LES TABLES AUX SLOTS DE JEU" />
    <add key="SETTINGS_NL_Tooltip_Body_Send_Table_To_Playing_Area" value="Quand vous survolez une table avec votre souris et appuyez sur ce raccourci, elle sera déplacée vers le prochain slot de jeu disponible. Cela fonctionne aussi pour les sites et émulateurs non supportés ! N'oubliez pas de signaler les sites non supportés sur nos forums !" />
    <add key="SETTINGS_NL_Label_Send_Table_To_Observer_Area" value="Envoyer la table à la zone d'observation" />
    <add key="SETTINGS_NL_Move_Tables_Clicking_Anywhere" value="Déplacer les tables en cliquant n'importe où dans la zone client" />
    <add key="SETTINGS_NL_Tooltip_Title_Move_Tables_Clicking_Anywhere" value="Déplacer les tables en cliquant n'importe où" />
    <add key="SETTINGS_NL_Tooltip_Body_Move_Tables_Clicking_Anywhere" value="Cette fonction vous permet de déplacer une table sans devoir cliquer péniblement sur la barre de titre de la fenêtre. Assurez-vous de cliquer sur la table et non sur un de ses éléments enfants comme un HUD. Les 20 % inférieurs de la zone table ne fonctionneront pas, cela évite les problèmes avec les curseurs de mise intégrés des sites de poker." />
    <add key="SETTINGS_NL_Hide_Title_Bar_Of_Tables" value="Masquer la barre de titre des tables" />
    <add key="SETTINGS_NL_Tooltip_Title_Send_Table_To_Observer_Area" value="ENVOYER LES TABLES AUX SLOTS D'OBSERVATION" />
    <add key="SETTINGS_NL_Tooltip_Body_Send_Table_To_Observer_Area" value="Quand vous survolez une table avec votre souris et appuyez sur ce raccourci, elle sera déplacée vers le prochain slot d'observation disponible. Cela fonctionne aussi pour les sites et émulateurs non supportés ! N'oubliez pas de signaler les sites non supportés sur nos forums !" />
