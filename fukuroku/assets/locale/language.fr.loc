      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Send_Table_To_Playing_Slot" value="Envoyer la table à un slot de jeu" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Observer_Slot" value="Slot d'Observateur" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Send_Table_To_Observer_Slot" value="Envoyer la table à un slot d'observateur" />
