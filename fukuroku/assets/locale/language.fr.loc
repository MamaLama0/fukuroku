      <add key="LAYOUT_CONFIGURATION_NL_Label_Ask_Before_Switching_Layout_Automatically" value="Demander avant de changer automatiquement le layout" />
      <add key="LAYOUT_CONFIGURATION_NL_Info_Automatically_Switch_From_An_Initial_Layout" value="Avec Jurojin, il y aura toujours un layout actif, mais nous vous offrons la possibilité de changer automatiquement à partir d'un layout initial." />
      <add key="LAYOUT_CONFIGURATION_NL_Button_Save_Changes" value="Sauvegarder les Modifications" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_LAYOUT_SWITCH_Title" value="CHANGER DE LAYOUT" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_LAYOUT_SWITCH_Message" value="VOULEZ-VOUS CHANGER AUTOMATIQUEMENT VERS LE LAYOUT " />
      <add key="LAYOUT_CONFIGURATION_NL_Help_Layout_Switch_Title" value="Changement Automatique de Layout" />
      <add key="LAYOUT_CONFIGURATION_NL_Help_Layout_Switch_Body" value="Cette fonctionnalité changera automatiquement le layout actif en fonction du nombre de tables ouvertes. Cliquez sur l'icône de crayon sous le premier changement de layout pour commencer." />
      <add key="LAYOUT_CONFIGURATION_NL_ON_TABLES_LAYOUT_CONFIGURATION_Auto_Swap_Caption" value="CHANGEMENT AUTOMATIQUE DE LAYOUT" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_TABLES_LAYOUT_CONFIGURATION_Auto_Swap_Message" value="Activer un layout manuellement désactiverait le changement automatique. Êtes-vous sûr de vouloir désactiver cette fonctionnalité et activer ce layout ?" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_Title" value="ATTENTION !" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_Message" value="Nous avons détecté un changement dans la configuration de vos écrans et votre layout actif actuel a des slots hors limites. Voulez-vous modifier le layout actif maintenant ?" />
      <add key="LAYOUT_CONFIGURATION_NL_Tab_Header_Layout_Hotkeys" value="Raccourcis Layout" />
