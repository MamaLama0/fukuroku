  <area id="100" name="App Window">
    <add key="APP_WINDOW_NL_Popup_Signup_Title" value="INSCRIPTION" />
    <add key="APP_WINDOW_NL_Popup_Signup_Subtitle" value="POUR COMMENCER VOTRE ESSAI GRATUIT !!" />
    <add key="APP_WINDOW_NL_" value="INSCRIPTION" />
    <sub id="0" name="Error Messages">
      <add key="ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_NL_MESSAGE" value="Nous avons détecté un changement dans la configuration de vos écrans et votre layout actif actuel a des slots hors limites. Voulez-vous modifier le layout actif maintenant ?" />
      <add key="ON_APPLICATION_ERROR_Title" value="Erreur Serveur" />
      <add key="ON_SERVER_FATAL_ERROR_MESSAGE" value="Connexion perdue. Vérifiez votre connexion internet." />
      <add key="ON_ERROR" value="Erreur Serveur" />
      <add key="ON_APPLICATION_MAINTENANCE_Title" value="Maintenance Serveur" />
      <add key="ON_APPLICATION_MAINTENANCE_Text" value="Nous avons besoin que vous redémarriez Jurojin immédiatement, il est fort probable que vous retrouviez votre utilisateur normal dans l'application après le redémarrage !" />
      <add key="DLL_MISSING_ERROR_TITLE" value="Fichiers manquants" />
      <add key="DLL_MISSING_ERROR_MESSAGE" value="Il vous manque des fichiers nécessaires au fonctionnement de l'application ! C'est généralement l'antivirus qui les supprime ! Veuillez ajouter une exception pour le dossier d'installation de Jurojin dans votre antivirus ou Windows Defender puis essayez à nouveau d'utiliser l'application. Si l'erreur persiste, veuillez télécharger notre dernier installateur sur https://jurojinpoker.com/download?v=345789/" />
      <add key="INSTALLATION_INTEGRITY_ERROR_TITLE" value="Installation modifiée" />
      <add key="INSTALLATION_INTEGRITY_ERROR_MESSAGE" value="Jurojin a détecté une modification inattendue de vos fichiers d'installation. Pour votre sécurité, l'application va se fermer. Réinstallez depuis https://jurojinpoker.com/download" />
      <add key="UNHANDLED_EX_ERROR_OUTOFMEMORY" value="Votre PC a manqué de mémoire RAM ou de mémoire GPU pour exécuter le programme. Envisagez de fermer des applications inutilisées comme le navigateur, ou peut-être de mettre à jour votre PC" />
      <add key="GLOBALFEATURE_ERROR" value="Une erreur est survenue lors de l'activation d'une de vos fonctionnalités Confort, veuillez contacter le support avec cette info : #ex#" />
      <add key="PLAYINGSESSIONHANDLER_ERROR" value="Un problème est survenu lors de la sauvegarde des infos des tables dans votre layout, veuillez contacter le support avec cette info : #ex#" />
      <add key="HOOKCONTROLLER_ERROR" value="Un problème est survenu lors de la connexion avec votre contrôleur, veuillez contacter le support avec cette info : #ex#" />
      <add key="EMERGENCY_SHUTDOWN_CANNOT_CONNECT_TO_SERVERS_MESSAGE" value="" />
      <add key="KEEP_ALIVE_RECONNECT_ENTITLEMENTS_REVOKED_TOAST" value="Votre PC ne peut actuellement pas se connecter à nos serveurs. Vérifiez votre connexion internet et le pare-feu/antivirus" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Title" value="Problème de connexion" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Body" isFormatted="true" value="&lt;p&gt;Votre abonnement est toujours actif, mais Jurojin ne peut pas joindre nos serveurs depuis votre PC. Les fonctionnalités ont été temporairement désactivées pour des raisons de sécurité.&lt;/p&gt;&lt;p&gt;Vérifiez votre connexion internet, pare-feu et antivirus, puis attendez que Jurojin se reconnecte automatiquement.&lt;/p&gt;" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Open_Guide" value="Ouvrir le guide de dépannage" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Got_It" value="Compris" />
    </sub>
