      <add key="AUTOBET_PREFLOP_Add_BBs_Limper_Help_Title" value="Par limper" />
      <add key="AUTOBET_PREFLOP_Add_BBs_Limper_Help_Body" value="Limper signifie chaque joueur qui vient de payer la BB pour voir le flop, tout montant supérieur est considéré comme un call, pas un limp. Pour chaque limper, le montant total sera multiplié par la valeur dans cette case" />
      <add key="AUTOBET_PREFLOP_Add_X_Times_Cold_Caller_Help_Title" value="Par cold caller" />
      <add key="AUTOBET_PREFLOP_Add_X_Times_Cold_Caller_Help_Body" value="Un cold call signifie un call après deux relances ou plus, ou après une mise et une relance. Pour chaque cold caller, le montant total sera multiplié par la valeur dans cette case" />
      <add key="AUTOBET_PREFLOP_Label_Multiply_X_Times_Open_Raise" value="Multiplier par X la relance d'ouverture" />
