    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_RNG" value="RNG" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Report_Table" value="TABLE DE RAPPORT" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Pot_Odds" value="COTES DU POT" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Pot_Odds_Tooltip_Title" value="COTES DU POT" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Pot_Odds_Tooltip_Body" value="Avec cette superposition, vous pourrez connaître la relation risque vs récompense. Elle peut être exprimée comme un ratio mathématique récompense:risque ou en pourcentage." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Stack_To_Pot_Ratio" value="SPR" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Tooltip_Title" value="SPR" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Tooltip_Body" value="Avec cette superposition, vous connaîtrez la relation entre le stack effectif (le stack du joueur avec le moins de jetons) divisé par la taille du pot." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Effective_Stack" value="STACK EFFECTIF" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_EFFS_Tooltip_Title" value="STACK EFF." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_EFFS_Tooltip_Body" value="Avec cette superposition, vous pouvez voir combien de jetons a le joueur avec le moins de jetons dans la main" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bet_Buttons" value="BOUTONS DE MISE" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Bet_Buttons_Tooltip_Title" value="BOUTONS DE MISE" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Bet_Buttons_Tooltip_Body" value="Cette superposition affichera les valeurs de mise que vous avez configurées pour vos raccourcis dans la page Hotkeys/Betsizes ! Si vous appuyez sur CTRL en survolant la superposition, vous verrez les huit autres tailles de mise" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Action_History" value="HISTORIQUE DES ACTIONS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Action_History_Tooltip_Title" value="SUPERPOSITION DE L'HISTORIQUE DES ACTIONS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Action_History_Tooltip_Body" value="Cette superposition vous aidera à remarquer les intentions que les adversaires essaient de vous montrer en jouant, vous verrez chaque action qu'ils effectuent lors d'une main" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Position" value="POSITIONS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Positions_Tooltip_Title" value="SUPERPOSITION DES POSITIONS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Positions_Tooltip_Body" value="Avec cette superposition, vous pourrez voir la position de chaque joueur à la table" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_AR_Tables_Counter" value="COMPTEUR TABLES AVEC ACTION" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Hand_Tables_Counter" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_ST_Tables_Counter" value="COMPTEUR DE TABLES SUPERPOSÉES" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_TOASTER_Check_Guide" value="Un guide s'ouvrira dans votre navigateur pour les superpositions basées sur les sièges afin que vous configuriez tout correctement. Assurez-vous que le centrage des sièges est correct sur tous les sites avant de tester la fonctionnalité !" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_SPR_Next_Street" value="SPR N.S." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_POT_Next_Street" value="POT N.S." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Next_Street_Tooltip_Title" value="Superposition SPR prochaine street" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Next_Street_Tooltip_Body" value="Cette superposition lira la valeur de votre champ de mise, supposera que votre adversaire suivra, puis calculera ce que sera le SPR à la prochaine street" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ON_DISABLE_Actions_Title" value="Désactiver la superposition" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ON_DISABLE_Actions_Message" value="Êtes-vous sûr ? Vous ne pourrez peut-être pas signaler de problèmes de table ou de main si cette superposition est désactivée." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_AR_Counter_Tooltip_Title" value="Compteur de tables nécessitant une action" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_AR_Counter_Tooltip_Body" value="Cet overlay vous indiquera combien de tables nécessitent une action à ce moment précis sur ce slot spécifique. Son bouton de cycle ne fera défiler que les tables nécessitant une action" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ST_Counter_Tooltip_Title" value="Compteur de Tables Empilées" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ST_Counter_Tooltip_Body" value="Utilisez cet overlay pour savoir combien de tables se trouvent à un slot spécifique" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Hand_Counter_Tooltip_Title" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Hand_Counter_Tooltip_Body" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Save_Location_Title" value="Enregistrer l'Emplacement" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Save_Location_Body" value="Assurez-vous d'être sur l'écran d'accueil de Jurojin puis placez vos overlays où vous le souhaitez en cliquant sur la zone pointillée. Ensuite, appuyez sur la touche de raccourci au-dessus de cette table" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Outs" value="OUTS MINIMUMS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Minimum_Outs_Tooltip_Title" value="OUTS MINIMUMS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency" value="MDF" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency_Tooltip_Title" value="FRÉQUENCE MINIMALE DE DÉFENSE" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency_Tooltip_Body" value="Cet overlay montre le % minimum de mains avec lesquelles vous devriez suivre une taille de mise spécifique de votre adversaire pour ne pas être exploitable par vos adversaires" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity" value="ÉQUITE DE BLUFF" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity_Tooltip_Title" value="ÉQUITE DE BLUFF" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity_Tooltip_Body" value="Représente, pour une taille de mise donnée (lue depuis votre betbox avant de miser), à quelle fréquence votre adversaire devrait se coucher en fonction de votre connaissance de son style de jeu, dans une situation donnée, pour rendre la mise rentable pour vous, particulièrement utile lors d'un bluff" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_POT_Next_Street_Tooltip_Title" value="Overlay POT prochaine street" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_POT_Next_Street_Tooltip_Body" value="Ce HUD calcule automatiquement la taille du pot attendue pour la prochaine phase d’enchères, en tenant compte de la valeur actuelle de la bet-box (avant de soumettre la relance) et en supposant que l’adversaire suit." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Minimum_Outs_Tooltip_Body" value="" />
