    <sub id="1" name="Tab - Hotkey Configuration">
      <add key="HOTKEYS_NL_Tab_Header_Hotkey_Configuration" value="Paramètres" />
      <add key="HOTKEYS_NL_Label_Send_The_Hotkey_To" value="Envoyer le raccourci à" />
      <add key="HOTKEYS_NL_Check_Table_Below_Mouse_Pointer" value="Table sous le pointeur de la souris" />
      <add key="HOTKEYS_NL_Check_Focused_Table" value="Table en focus" />
      <add key="HOTKEYS_NL_Label_Override_Poker_Site_Wheel_Betting" value="Ajustement mise (molette)" />
      <add key="HOTKEYS_NL_Tooltip_Wheel_Betting_Title" value="AJUSTEMENT MISE (MOLETTE)" />
      <add key="HOTKEYS_NL_Tooltip_Wheel_Betting_Body" value="Vous pouvez activer ceci pour que Jurojin ajuste la taille de la mise avec la molette. Vous pouvez choisir de déplacer le curseur par BB ou SB. L'option sélectionnée impactera aussi le comportement des raccourcis Incrémenter et Décrémenter." />
      <add key="HOTKEYS_NL_Label_Small_Blinds" value="Petites blinds" />
      <add key="HOTKEYS_NL_Label_Big_Blinds" value="Grosses blinds" />
      <add key="HOTKEYS_NL_Label_Toggle_BB_Mode" value="Basculer le mode BB" />
      <add key="HOTKEYS_NL_Label_BB_Convertion_On_Bodog_Bovada" value="Conversion BB sur Bodog/Iggy" />
      <add key="HOTKEYS_NL_Button_Click_Here" value="Cliquez ici" />
      <add key="HOTKEYS_NL_Label_Instantly_Shove_Bet_When_Pressing_Hotkey" value="Lors de l'utilisation d'un raccourci de taille de mise" />
      <add key="HOTKEYS_NL_Label_Also_Instantly_Shove_When_Using_Betting_Overlay" value="Lors de l'utilisation d'un bouton de taille de mise sur le HUD de mise" />
      <add key="HOTKEYS_NL_Label_Instant_Shove_Only_All_In" value="Avec touche All-In" />
      <add key="HOTKEYS_NL_Label_AutoBet" value="Miser instantanément les jetons" />
      <add key="HOTKEYS_NL_Label_Geometric_Betsizing" value="Mise géométrique" />
      <add key="HOTKEYS_NL_Label_Convert_This_Betsize_Into_A_Geometric_Bet_Size" value="Convertir ce bouton de mise en taille de mise géométrique (2e, 3e)" />
      <add key="HOTKEYS_NL_Banner_When_Using_Betsize_Overlay_You_Can_Use_Ctrl_Key" value="En utilisant l'overlay de taille de mise, vous pouvez utiliser la touche CTRL pour choisir entre 3e et 2e" />
      <add key="HOTKEYS_NL_Tooltip_Geometric_Betsizing_Title" value="MISE GÉOMÉTRIQUE" />
      <add key="HOTKEYS_NL_Tooltip_Geometric_Betsizing_Body" value="Avec cette fonction, vous pouvez modifier un bouton de mise pour qu'il se comporte comme une mise géométrique. Les mises géométriques vous permettent de miser au flop/turn de façon à ce qu'en misant le même % à la rue suivante vous atteigniez un all-in à la rivière." />
    </sub>
