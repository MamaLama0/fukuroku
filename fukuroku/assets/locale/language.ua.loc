    <add key="COINPOKER_ALT_STUCK_UNJAMMED" value="CoinPoker Alt Stucked was Unjammed" />
    <add key="NEW_APP_VERSION_NOTIFICATION" value="" />
    <add key="MOVE_ARROUND_HOTKEYS_DISCLAIMER" value="" />
    <add key="SPACEBAR_NOT_RECOMMENDED" value="" />
    <add key="KEEP_MOST_URGENT_MESSAGE" value="" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_TITLE" value="Грати без миші?" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_BODY" value="Auto Focus переносить фокус клавіатури на найтерміновіший стіл. Щоб fold, check або bet без миші, хоткеї столу мають діяти на стіл у фокусі." />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_YES" value="Так, змінити" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_IGNORE" value="Ігнорувати" />
    <add key="ONE_TABLE_HOTKEYS_MESSAGE" value="" />
    <add key="CONNECTION_COLLIDED" value="" />
    <add key="PACIFIC_POKER_X64" value="" />
    <add key="PACIFIC_POKER_X64_WORKING" value="" />
    <add key="TABLE_BURIED_IN_STACK_DIALOG" value="" />
    <add key="TABLE_BURIED_IN_STACK_TOASTER" value="" />
    <add key="STACK_GUIDANCE_STACKING_OFF" value="Ой — у вас кілька столів в одному слоті, а функції stacking вимкнено. Покажемо, як це виправити. Після закриття цього вікна відкриється посібник у браузері." />
    <add key="STACK_GUIDANCE_ENHANCE_STACK" value="Ви на правильному шляху зі стеками. Покажемо ще кілька функцій, які змінять гру. Після закриття цього вікна відкриється посібник у браузері." />
    <add key="APP_LIMITATIONS_FREE_TIER_STAKE_NOT_COVERED" value="Тариф Free Tier не покриває цей стіл через ставки. Підпишіться та розблокуйте!" />
    <add key="APP_LIMITATIONS_FREE_TIER_STAKE_NOT_COVERED_ACTION" value="Підпишіться та розблокуйте!" />
    <add key="APP_LIMITATIONS_FREE_TIER_EXEMPT_ROOM_NOT_COVERED" value="Столи #game# не підтримуються на тарифі Free." />
    <add key="APP_LIMITATIONS_FREE_TIER_EXEMPT_ROOM_NOT_COVERED_ACTION" value="Підписатися на Tiling" />
    <add key="APP_LIMITATIONS_LOW_STAKES_QUOTA_REACHED" value="Ой, ви досягли квоти вище Low-Stakes. Оновіть план, щоб розблокувати!" />
    <add key="APP_LIMITATIONS_LOW_STAKES_QUOTA_REACHED_ACTION" value="Оновіть план, щоб розблокувати!" />
    <add key="APP_LIMITATIONS_CLUBGG_FULL_ACCESS_ONLY" value="ClubGG доступний лише у Full Access" />
    <add key="APP_LIMITATIONS_CLUBGG_FULL_ACCESS_ONLY_ACTION" value="Отримати Full Access" />
    <add key="APP_LIMIATIONS_MAX_TILED_TABLES_REACHED" value="Можна розмістити лише два столи вищих лімітів і необмежено — якщо вони мікроліміти!" />
    <add key="APP_LIMIATIONS_MAX_TILED_TABLES_REACHED_ACTION" value="Отримати Bundle Tiling" />
    <add key="APP_LIMITATIONS_NEW_TABLE_GAINED_HOTKEY_RIGHTS" value="Тепер це стіл вищих лімітів, де доступні безкоштовні хоткеї!" />
    <add key="APP_LIMITATIONS_NEW_TABLE_GAINED_HOTKEY_RIGHTS_ACTION" value="Увімкнути хоткеї для всіх столів" />
    <add key="APP_LIMITATIONS_TABLE_DOESNT_HAVE_HOTKEY_RIGHTS" value="На цьому столі не можна використовувати хоткеї" />
    <add key="APP_LIMITATIONS_TABLE_DOESNT_HAVE_HOTKEY_RIGHTS_ACTION" value="Увімкнути хоткеї для всіх столів" />
    <add key="APP_LIMITATIONS_TABLE_DOESNT_HAVE_HOTKEY_RIGHTS_SHOW_FREE_TABLE" value="Це стіл вищих лімітів, де доступні безкоштовні хоткеї!" />
    <add key="APP_LIMITATIONS_NEW_TABLE_GAINED_OVERLAY_RIGHTS" value="Тепер це стіл з безкоштовними оверлеями" />
    <add key="APP_LIMITATIONS_NEW_TABLE_GAINED_OVERLAY_RIGHTS_ACTION" value="Розблокувати оверлеї для всіх столів" />
    <add key="APP_LIMITATIONS_TABLE_DOESNT_HAVE_OVERLAY_RIGHTS" value="У цього столу не буде оверлеїв! Лише один стіл вищих лімітів може їх мати!" />
