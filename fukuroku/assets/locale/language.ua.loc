  <area id="123" name="Feature Showcase">
    <sub id="0" name="Highlight Callouts">
      <add key="FEATURE_SHOWCASE_NL_Body_Action_History_Settings" value="Оцініть нові стильні теми. Спойлер: &quot;Minimal&quot; стане вашою новою улюбленою!" />
      <add key="FEATURE_SHOWCASE_NL_Body_Keep_Most_Urgent_On_Top" value="Увімкніть &quot;Керувати терміновістю стеку&quot;, щоб Jurojin тримав найтерміновіший стіл зверху, коли ви складаєте кілька столів в один слот. Також вимкніть вбудовану функцію фокусу/терміновості столів у вашому румі, щоб вона не конфліктувала з Jurojin." />
      <add key="FEATURE_SHOWCASE_NL_Body_Auto_Focus_Most_Urgent" value="Увімкніть &quot;Завжди автофокус на найтерміновіший стіл&quot;, і Jurojin завжди триматиме найтерміновіший стіл зверху, навіть якщо столи перекриваються. Також вимкніть вбудовану функцію фокусу/терміновості столів у вашому румі, щоб вона не конфліктувала з Jurojin." />
      <add key="FEATURE_SHOWCASE_TOAST_Configuration_Suggestion" value="Jurojin має для вас пораду щодо налаштувань!" />
    </sub>
  </area>
