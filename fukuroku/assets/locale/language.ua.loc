      <add key="GLOBALFEATURE_ERROR" value="" />
      <add key="PLAYINGSESSIONHANDLER_ERROR" value="" />
      <add key="HOOKCONTROLLER_ERROR" value="" />
      <add key="EMERGENCY_SHUTDOWN_CANNOT_CONNECT_TO_SERVERS_MESSAGE" value="" />
      <add key="KEEP_ALIVE_RECONNECT_ENTITLEMENTS_REVOKED_TOAST" value="Ваш ПК зараз не може підключитися до наших серверів. Перевірте інтернет-з'єднання та брандмауер/антивірус" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Title" value="Проблема з підключенням" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Body" isFormatted="true" value="&lt;p&gt;Ваша підписка досі активна, але Jurojin не може підключитися до наших серверів з вашого ПК. Функції тимчасово вимкнено з міркувань безпеки.&lt;/p&gt;&lt;p&gt;Перевірте інтернет-з'єднання, брандмауер і антивірус і дочекайтеся автоматичного перепідключення Jurojin.&lt;/p&gt;" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Open_Guide" value="Відкрити посібник з усунення несправностей" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Got_It" value="Зрозуміло" />
    </sub>
