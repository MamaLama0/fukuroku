    <add key="SETTINGS_NL_Tooltip_Body_Keep_Most_Urgent_On_Top" value="Коли столи ділять один слот (стек), Jurojin піднімає найтерміновіший стіл (найменше часу на дію). Це лише видимість у стеку — фокус клавіатури не переміщується." />
    <add key="SETTINGS_NL_CheckBox_Auto_Focus_Most_Urgent_Always" value="Завжди автофокус на найтерміновіший стіл" />
    <add key="SETTINGS_NL_Tooltip_Title_Auto_Focus_Most_Urgent_Always" value="Завжди автофокус на найтерміновіший стіл" />
    <add key="SETTINGS_NL_Tooltip_Body_Auto_Focus_Most_Urgent_Always" value="Коли перший стіл потребує дії (або після вашої дії лишається інший), Jurojin глобально фокусує найтерміновіший стіл, щоб грати без миші." />
    <add key="SETTINGS_NL_CheckBox_Also_Force_Move_Mouse" value="Також примусово рухати мишу" />
    <add key="SETTINGS_NL_Tooltip_Title_Also_Force_Move_Mouse" value="Також примусово рухати мишу" />
    <add key="SETTINGS_NL_Tooltip_Body_Also_Force_Move_Mouse" value="Також переміщує курсор миші на стіл у фокусі. Корисно для геймпада або сайтів, де курсор має бути над столом." />
    <add key="SETTINGS_NL_CheckBox_Minimize_App_To_System_Tray" value="" />
