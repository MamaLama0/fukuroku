      <add key="HOTKEYS_NL_Check_Table_Below_Mouse_Pointer" value="Стол под курсором мыши" />
      <add key="HOTKEYS_NL_Check_Focused_Table" value="Фокус на стол" />
      <add key="HOTKEYS_NL_Label_Override_Poker_Site_Wheel_Betting" value="Регулировка ставки колёсиком" />
      <add key="HOTKEYS_NL_Tooltip_Wheel_Betting_Title" value="РЕГУЛИРОВКА СТАВКИ КОЛЁСИКОМ" />
      <add key="HOTKEYS_NL_Tooltip_Wheel_Betting_Body" value="Можно включить, чтобы Jurojin регулировал размер ставки колёсиком мыши. Вы можете выбрать движение слайдера по BB или SB. Выбранный вариант также повлияет на поведение горячих клавиш Увеличить и Уменьшить." />
      <add key="HOTKEYS_NL_Label_Small_Blinds" value="Малые блайнды" />
      <add key="HOTKEYS_NL_Label_Big_Blinds" value="Большие блайнды" />
      <add key="HOTKEYS_NL_Label_Toggle_BB_Mode" value="Переключить режим BB" />
      <add key="HOTKEYS_NL_Label_BB_Convertion_On_Bodog_Bovada" value="Конвертация BB на Bodog/Iggy" />
      <add key="HOTKEYS_NL_Button_Click_Here" value="Нажмите здесь" />
      <add key="HOTKEYS_NL_Label_Instantly_Shove_Bet_When_Pressing_Hotkey" value="При использовании горячей клавиши размера ставки" />
      <add key="HOTKEYS_NL_Label_Also_Instantly_Shove_When_Using_Betting_Overlay" value="При использовании кнопки размера ставки на Betting HUD" />
      <add key="HOTKEYS_NL_Label_Instant_Shove_Only_All_In" value="" />
