      <add key="CREATE_NEW_LAYOUT_AUTOMATICALLY_NL_Title_Create_New_Layout_Automatically" value="Создать новый layout автоматически" />
      <add key="CREATE_NEW_LAYOUT_AUTOMATICALLY_NL_Button_Prev" value="Назад" />
