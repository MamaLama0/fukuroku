    <add key="APP_LIMITATIONS_FREE_TIER_EXEMPT_ROOM_NOT_COVERED_ACTION" value="Подписаться на Tiling" />
    <add key="APP_LIMITATIONS_LOW_STAKES_QUOTA_REACHED" value="Упс, вы достигли квоты выше Low-Stakes. Обновите план, чтобы разблокировать!" />
    <add key="APP_LIMITATIONS_LOW_STAKES_QUOTA_REACHED_ACTION" value="Обновите план, чтобы разблокировать!" />
