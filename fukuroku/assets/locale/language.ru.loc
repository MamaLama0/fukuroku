    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Playing_Area" value="Игровая зона может быть магнитена, это значит, что вы можете перетаскивать столы, и они будут сразу притягиваться к slots. Также можно перетаскивать при нажатом CTRL, чтобы избежать обмена столов, и они будут стековаться" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Observer_Area" value="Магнитить зону наблюдателя" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Observer_Area" value="Магнитить зону наблюдателя и slots" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Observer_Area" value="Slots зоны наблюдателя также могут быть магнитены" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Lobby_Slots" value="Магнитить Lobby slots" />
