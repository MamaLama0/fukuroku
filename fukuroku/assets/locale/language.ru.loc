      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Copy_Player_Name_To_Clipboard_Double_Clicking_Player_Seat_Stack" value="Копировать имя игрока в буфер при двойном клике по стаку игрока" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Hide_Board_If_All_In" value="Скрывать борд при all in" />
