      <add key="LAYOUT_CONFIGURATION_NL_Label_Initial_Layout" value="Начальный" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Go_Back_To_Previous_Layout_If_Table_Decrease" value="Возвращаться к предыдущему layout при уменьшении столов" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Ask_Before_Switching_Layout_Automatically" value="Спрашивать перед автоматическим переключением layout" />
      <add key="LAYOUT_CONFIGURATION_NL_Info_Automatically_Switch_From_An_Initial_Layout" value="При использовании Jurojin всегда будет активен один layout, однако мы предлагаем возможность автоматически переключаться с начального layout." />
      <add key="LAYOUT_CONFIGURATION_NL_Button_Save_Changes" value="Сохранить изменения" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_LAYOUT_SWITCH_Title" value="ПЕРЕКЛЮЧИТЬ LAYOUT" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_LAYOUT_SWITCH_Message" value="ВЫ ХОТИТЕ АВТОМАТИЧЕСКИ ПЕРЕКЛЮЧИТЬСЯ НА LAYOUT " />
      <add key="LAYOUT_CONFIGURATION_NL_Help_Layout_Switch_Title" value="Автоматическое переключение layout" />
      <add key="LAYOUT_CONFIGURATION_NL_Help_Layout_Switch_Body" value="Эта функция автоматически изменит активный layout в зависимости от количества открытых столов. Нажмите на иконку карандаша под первым переключением layout, чтобы начать." />
      <add key="LAYOUT_CONFIGURATION_NL_ON_TABLES_LAYOUT_CONFIGURATION_Auto_Swap_Caption" value="АВТОМАТИЧЕСКОЕ ПЕРЕКЛЮЧЕНИЕ LAYOUT" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_TABLES_LAYOUT_CONFIGURATION_Auto_Swap_Message" value="Ручная активация Layout отключит Автоматическое переключение layout. Вы уверены, что хотите отключить эту функцию и активировать этот Layout?" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_Title" value="ВНИМАНИЕ!" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_Message" value="Обнаружено изменение конфигурации дисплеев, и ваш текущий активный layout содержит slots за пределами допустимой области. Хотите отредактировать Активный Layout сейчас?" />
      <add key="LAYOUT_CONFIGURATION_NL_Tab_Header_Layout_Hotkeys" value="Клавиши Layout" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Playing_Slot" value="Играющий Slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Send_Table_To_Playing_Slot" value="Отправить стол в играющий slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Observer_Slot" value="Наблюдатель Slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Send_Table_To_Observer_Slot" value="Отправить стол в наблюдательный slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Playing_Slot_No" value="Играющий Slot №" />
      <add key="LAYOUT_CONFIGURATION_NL_Hotkeys_Label_Observer_Slot_No" value="Наблюдатель Slot №" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Lock_Table_Of_Dynamic_Flow" value="Заблокировать стол вне динамического потока" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Move_Table_To_Next_Slot" value="Переместить стол в следующий slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Move_Table_To_Previous_Slot" value="Переместить стол в предыдущий slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Help_Title_Lock_Table" value="Заблокировать/Вставить стол заново" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Help_Body_Lock_Table" value="Используйте эту горячую клавишу, чтобы исключить или повторно вставить стол в динамический поток slots (AR/In Hand). По сути, ваш стол останется в том slot, где он находится. Можно нажать горячую клавишу снова, чтобы вернуть стол в динамический поток." />
    </sub>
    <sub id="1" name="Page - Create New Layout">
      <add key="CREATE_NEW_LAYOUT_NL_Title_Create_New_Layout" value="Создать новый Layout" />
      <add key="CREATE_NEW_LAYOUT_NL_Button_Create_Manually" value="Создать РУЧНО" />
      <add key="CREATE_NEW_LAYOUT_NL_Button_Create_Automatically" value="Создать АВТОМАТИЧЕСКИ" />
