    <add key="APP_LIMIATIONS_MAX_TILED_TABLES_REACHED" value="Можно разместить только два стола более высоких лимитов и неограниченно — если они микролимиты!" />
    <add key="APP_LIMIATIONS_MAX_TILED_TABLES_REACHED_ACTION" value="Получить Bundle Tiling" />
