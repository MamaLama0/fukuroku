      <add key="CREATE_NEW_LAYOUT_NL_Button_Clone_Existing_Layout" value="Клонировать СУЩЕСТВУЮЩИЙ LAYOUT" />
      <add key="CREATE_NEW_LAYOUT_NL_Help_Option_Unavaliable_For_Your_Screen_Resolution" value="Этот параметр недоступен для разрешения вашего экрана" />
    </sub>
    <sub id="2" name="Page - Edit Layout">
      <add key="EDIT_LAYOUT_NL_Title_Edit_Layout" value="Редактировать Layout" />
      <add key="EDIT_LAYOUT_NL_Label_Layout_Name" value="Имя Layout" />
      <add key="EDIT_LAYOUT_NL_Label_Hotkey_To_Switch_Layout_During_Session" value="Горячая клавиша для переключения layout во время сессии" />
      <add key="EDIT_LAYOUT_NL_Label_Dynamic_Slots" value="Динамические slots" />
      <add key="EDIT_LAYOUT_NL_Label_Resize_Every_Slot" value="Изменять размер каждого slot" />
      <add key="EDIT_LAYOUT_NL_Label_Scale" value="Масштаб:" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Playing_Area_Slot" value="Добавить ИГРАЮЩИЙ Slot" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Observer_Area_Slot" value="Добавить НАБЛЮДАТЕЛЬСКИЙ Slot" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Replay_Area_Slot" value="Добавить REPLAY Slot" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Lobby_Slot" value="Добавить LOBBY Slot" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Action_Required_Slot" value="Добавить ACTION REQUIRED Slot" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Title_Action_Required" value="Требуется действие" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Body_Action_Required" value="Этот slot обозначает область экрана, куда помещаются столы, когда наступает ваш ход. В таких slots в любой момент будет только один стол, когда все они заняты, столы переходят в очередь (Queue slots), и как только slot с требуемым действием освобождается, самый срочный стол из очереди отправляется туда." />
      <add key="EDIT_LAYOUT_NL_Button_Add_Queue_Slot" value="Добавить QUEUE slot" />
      <add key="EDIT_LAYOUT_NL_Button_Add_In_Hand_Slot" value="Добавить IN HAND slot" />
      <add key="EDIT_LAYOUT_NL_Button_Save_Changes" value="Сохранить изменения" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Title" value="Некоторые slots будут удалены" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Message" value="Slots с красной обводкой либо выходят за границы экрана, либо перекрываются с другими slots и будут удалены. Продолжить?" />
      <add key="EDIT_LAYOUT_NL_Label_Stack_Tables_In_Ar_Slot" value="Складывать столы в AR slot по мере наступления вашего хода за каждым из них" />
      <add key="EDIT_LAYOUT_Tooltip_Title_In_Hand" value="In Hand slots" />
      <add key="EDIT_LAYOUT_Tooltip_Body_In_Hand" value="In Hand slots — лучший способ сфокусироваться только на важных раздачах, столы будут перемещаться сюда при вашем VPIP. Это поведение можно настроить в конфигурации каждого сайта" />
    </sub>
