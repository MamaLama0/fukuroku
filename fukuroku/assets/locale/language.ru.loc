    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Lobby_Slots" value="Также и lobby slots. Если в lobby slots включена опция stack sites" />
    <add key="SETTINGS_NL_CheckBox_Invert_Ctrl_Key" value="Инвертировать использование CTRL для магнитизации" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Observer_Area_When_Table_Closed" value="Переставлять зону наблюдателя при закрытии стола" />
    <add key="SETTINGS_NL_Tooltip_Title_Reoder_Observer_Area_When_Table_Closed" value="Переставлять зону наблюдателя при закрытии стола" />
    <add key="SETTINGS_NL_Tooltip_Body_Reoder_Observer_Area_When_Table_Closed" value="Вы можете сделать так, чтобы столы переставлялись в observer slots, когда один из них закрывается" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Playing_Area_When_Table_Closed" value="Переставлять игровую зону при закрытии стола" />
    <add key="SETTINGS_NL_Tooltip_Title_Reorder_Playing_Area_When_Table_Closed" value="Переставлять игровую зону при закрытии стола" />
    <add key="SETTINGS_NL_Tooltip_Body_Reorder_Playing_Area_When_Table_Closed" value="Вы можете сделать так, чтобы столы переставлялись в playing slots, когда один из них закрывается" />
    <add key="SETTINGS_NL_CheckBox_Keep_Most_Urgent_On_Top" value="Управлять срочностью стека" />
    <add key="SETTINGS_NL_Tooltip_Title_Keep_Most_Urgent_On_Top" value="Управлять срочностью стека" />
    <add key="SETTINGS_NL_Tooltip_Body_Keep_Most_Urgent_On_Top" value="Когда столы делят один слот (стек), Jurojin поднимает самый срочный стол (меньше всего времени на действие). Это только видимость в стеке — фокус клавиатуры не перемещается." />
    <add key="SETTINGS_NL_CheckBox_Auto_Focus_Most_Urgent_Always" value="Всегда автофокус на самый срочный стол" />
    <add key="SETTINGS_NL_Tooltip_Title_Auto_Focus_Most_Urgent_Always" value="Всегда автофокус на самый срочный стол" />
    <add key="SETTINGS_NL_Tooltip_Body_Auto_Focus_Most_Urgent_Always" value="Когда первый стол требует действия (или после вашего действия остаётся другой), Jurojin глобально фокусирует самый срочный стол, чтобы играть без мыши." />
    <add key="SETTINGS_NL_CheckBox_Also_Force_Move_Mouse" value="Также принудительно двигать мышь" />
    <add key="SETTINGS_NL_Tooltip_Title_Also_Force_Move_Mouse" value="Также принудительно двигать мышь" />
    <add key="SETTINGS_NL_Tooltip_Body_Also_Force_Move_Mouse" value="Также перемещает курсор мыши на стол в фокусе. Полезно для геймпада или сайтов, где курсор должен быть над столом." />
    <add key="SETTINGS_NL_CheckBox_Minimize_App_To_System_Tray" value="Сворачивать приложение в системный трей" />
    <add key="SETTINGS_NL_CheckBox_Save_Jurojin_Location_On_Close" value="" />
    <add key="SETTINGS_NL_Tooltip_Title_Alarm_For_Action_Required" value="" />
    <add key="SETTINGS_NL_Tooltip_Title_Delayed_Alarm_Action_Enabled" value="Отложенная тревога для действия" />
    <add key="SETTINGS_NL_Tooltip_Subtitle_Delayed_Alarm_Action_Enabled" value="Звучит через 10 секунд после начала вашего хода" />
    <add key="SETTINGS_NL_Tooltip_Body_Delayed_Alarm_Action_Required" value="Вы можете настроить Jurojin так, чтобы сигнал тревоги звучал через заданное количество секунд после начала вашего хода, пока действие всё еще требуется." />
    <add key="SETTINGS_NL_Tooltip_Body_Minimize_Application_To_System_Tray" value="При нажатии на кнопку свернуть с включённой этой функцией, приложение уйдет в системный трей в правом нижнем углу Windows." />
    <add key="SETTINGS_NL_Tooltip_Title_Minimize_Application_To_System_Tray" value="Сворачивать в трей" />
    <add key="SETTINGS_NL_CheckBox_Show_RNG" value="Показывать RNG" />
    <add key="SETTINGS_NL_CheckBox_Sub_Show_RNG" value="Генератор случайных чисел" />
    <add key="SETTINGS_NL_Tooltip_Title_Show_Random_Number_Generator" value="ГСЧ" />
    <add key="SETTINGS_NL_Tooltip_Body_Show_Random_Number_Generator" value="Это покажет ГСЧ на экране (не поверх столов, независимый элемент!)" />
    <add key="SETTINGS_NL_CheckBox_Drag_Table_Clicking_Anywhere" value="Перетаскивать стол кликом по любой области" />
    <add key="SETTINGS_NL_CheckBox_Focus_Table_Under_Mouse" value="Фокусировать стол под мышью" />
    <add key="SETTINGS_NL_Tooltip_Title_Focus_Table_Under_Mouse" value="Фокусировать стол под мышью" />
    <add key="SETTINGS_NL_Tooltip_Body_Focus_Table_Under_Mouse" value="Эта функция выводит стол на передний план при наведении мыши" />
    <add key="SETTINGS_NL_CheckBox_Bring_Only_Tables_In_Playing_Slot_To_Front" value="Выводить на передний план только столы в игровом слоте" />
    <add key="SETTINGS_NL_Tab_Header_Global_Hotkeys" value="Глобальные горячие клавиши" />
    <add key="SETTINGS_NL_Label_Reorder_Playing_Area" value="Переставить игровую зону" />
    <add key="SETTINGS_NL_Label_Reorder_Observer_Area" value="Перестроить Observer Area" />
    <add key="SETTINGS_NL_Label_Send_Table_To_Playing_Area" value="Отправить стол в Playing Area" />
    <add key="SETTINGS_NL_Tooltip_Title_Send_Table_To_Playing_Area" value="ОТПРАВИТЬ СТОЛЫ В PLAYING SLOTS" />
    <add key="SETTINGS_NL_Tooltip_Body_Send_Table_To_Playing_Area" value="Когда вы наведете мышь на стол и нажмете эту горячую клавишу, он переместится в следующий доступный playing slot. Также работает на неподдерживаемых сайтах и эмуляторах! Не забудьте сообщить о неподдерживаемых сайтах на наших форумах!" />
    <add key="SETTINGS_NL_Label_Send_Table_To_Observer_Area" value="Отправить стол в Observer Area" />
    <add key="SETTINGS_NL_Move_Tables_Clicking_Anywhere" value="Перемещать столы, кликая в любом месте клиентской области" />
    <add key="SETTINGS_NL_Tooltip_Title_Move_Tables_Clicking_Anywhere" value="Перемещать столы кликом в любом месте" />
    <add key="SETTINGS_NL_Tooltip_Body_Move_Tables_Clicking_Anywhere" value="Эта функция позволит вам перетаскивать стол, не обязательно кликая по заголовку окна. Убедитесь, что вы кликаете именно по столу, а не по его дочерним элементам, например HUD. Нижние 20% области стола не работают, чтобы избежать проблем с встроенными слайдерами ставок на покерных сайтах" />
    <add key="SETTINGS_NL_Hide_Title_Bar_Of_Tables" value="Скрыть панель заголовка столов" />
    <add key="SETTINGS_NL_Tooltip_Title_Send_Table_To_Observer_Area" value="ОТПРАВИТЬ СТОЛЫ В OBSERVE SLOTS" />
    <add key="SETTINGS_NL_Tooltip_Body_Send_Table_To_Observer_Area" value="Когда вы наведете мышь на стол и нажмете эту горячую клавишу, он будет перемещён в следующий доступный observe slot. Также работает на неподдерживаемых сайтах и эмуляторах! Не забудьте сообщить о неподдерживаемых сайтах на наших форумах!" />
    <add key="SETTINGS_NL_Label_Preview_Active_Layout" value="Предпросмотр активного layout" />
