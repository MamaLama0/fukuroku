  <area id="100" name="App Window">
    <add key="APP_WINDOW_NL_Popup_Signup_Title" value="РЕГИСТРАЦИЯ" />
    <add key="APP_WINDOW_NL_Popup_Signup_Subtitle" value="ЧТОБЫ НАЧАТЬ ВАШ БЕСПЛАТНЫЙ ПРОБНЫЙ ПЕРИОД!!" />
    <add key="APP_WINDOW_NL_" value="РЕГИСТРАЦИЯ" />
    <sub id="0" name="Error Messages">
      <add key="ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_NL_MESSAGE" value="Обнаружено изменение конфигурации дисплеев, и ваш текущий активный layout содержит slots за пределами допустимой области. Хотите отредактировать Активный Layout сейчас?" />
      <add key="ON_APPLICATION_ERROR_Title" value="Ошибка сервера" />
      <add key="ON_SERVER_FATAL_ERROR_MESSAGE" value="Связь потеряна. Проверьте ваше интернет-соединение." />
      <add key="ON_ERROR" value="Ошибка сервера" />
      <add key="ON_APPLICATION_MAINTENANCE_Title" value="Обслуживание сервера" />
      <add key="ON_APPLICATION_MAINTENANCE_Text" value="Пожалуйста, сейчас же перезапустите Jurojin, скорее всего после этого вы вернётесь к обычному пользователю в приложении!" />
      <add key="DLL_MISSING_ERROR_TITLE" value="Отсутствуют файлы" />
      <add key="DLL_MISSING_ERROR_MESSAGE" value="Отсутствуют необходимые для запуска приложения файлы! Обычно их удаляет антивирус! Пожалуйста, добавьте папку установки Jurojin в исключения антивируса или Windows Defender и попробуйте снова использовать приложение. Если сообщение об ошибке появится снова, загрузите последний установщик с https://jurojinpoker.com/download?v=345789/" />
      <add key="INSTALLATION_INTEGRITY_ERROR_TITLE" value="Установка изменена" />
      <add key="INSTALLATION_INTEGRITY_ERROR_MESSAGE" value="Jurojin обнаружил неожиданное изменение файлов установки. Для вашей безопасности приложение будет закрыто. Переустановите с https://jurojinpoker.com/download" />
      <add key="UNHANDLED_EX_ERROR_OUTOFMEMORY" value="На вашем ПК закончилась оперативная память или память видеокарты для запуска программы. Рекомендуется закрыть неиспользуемые приложения, например браузер, или обновить ПК." />
      <add key="GLOBALFEATURE_ERROR" value="Произошла ошибка при активации одной из ваших Comfort Features, пожалуйста, свяжитесь с поддержкой с этой информацией: #ex#" />
      <add key="PLAYINGSESSIONHANDLER_ERROR" value="Произошла проблема при сохранении информации о столах в вашем layout, пожалуйста, свяжитесь с поддержкой с этой информацией: #ex#" />
      <add key="HOOKCONTROLLER_ERROR" value="Произошла проблема с подключением к вашему контроллеру, пожалуйста, свяжитесь с поддержкой с этой информацией: #ex#" />
      <add key="EMERGENCY_SHUTDOWN_CANNOT_CONNECT_TO_SERVERS_MESSAGE" value="" />
      <add key="KEEP_ALIVE_RECONNECT_ENTITLEMENTS_REVOKED_TOAST" value="Ваш ПК сейчас не может подключиться к нашим серверам. Проверьте интернет-соединение и брандмауэр/антивирус" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Title" value="Проблема с подключением" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Body" isFormatted="true" value="&lt;p&gt;Ваша подписка всё ещё активна, но Jurojin не может подключиться к нашим серверам с вашего ПК. Функции временно отключены в целях безопасности.&lt;/p&gt;&lt;p&gt;Проверьте интернет-соединение, брандмауэр и антивирус и дождитесь автоматического переподключения Jurojin.&lt;/p&gt;" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Open_Guide" value="Открыть руководство по устранению неполадок" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Got_It" value="Понятно" />
    </sub>
