    <sub id="15" name="Dialog - Store Binance Warning">
      <add key="DIALOG_STORE_BINANCE_WARNING_Title" value="लगभग हो गया..." />
      <add key="DIALOG_STORE_BINANCE_WARNING_Body" isFormatted="true" value="&lt;p&gt;यदि आप &lt;span style=&quot;font-weight: 700;&quot;&gt;Binance&lt;/span&gt; से withdrawal कर रहे हैं, तो आपको &lt;span style=&quot;font-weight: 700;&quot;&gt;अपने withdrawal में 1 अतिरिक्त USDT जोड़ना होगा&lt;/span&gt;, यदि आप किसी अन्य platform का उपयोग कर रहे हैं, तो कृपया हमें USDT भेजने से पहले उनके withdrawal rates जांच लें ताकि आंशिक भुगतान से बचा जा सके।&lt;/p&gt;" />
      <add key="DIALOG_STORE_BINANCE_WARNING_Button_Continue" value="जारी रखें" />
      <add key="DIALOG_STORE_BINANCE_WARNING_Button_Cancel" value="रद्द करें" />
      <add key="DIALOG_STORE_BINANCE_WARNING_Btc_Body" value="जब सीधे exchanges से withdrawal करते हैं, तो withdrawal शुल्क लिया जाता है। सुनिश्चित करें कि आप सही राशि उस पते पर भेज रहे हैं! Binance में आपको यह बटन दबाना होगा ताकि withdrawal राशि सही हो, अन्यथा हमें अपर्याप्त धन प्राप्त होगा और आपके products सक्रिय नहीं होंगे।" />
    </sub>
