    <sub id="3" name="Tab - Rebuy Topup">
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tab_Header_Rebuy_Topup" value="रीबाय/टॉपअप" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Toggle_Auto_Top-Up_For_Cash_Games" value="कैश गेम्स के लिए ऑटो टॉप-अप" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Auto_Top-Up_For_Cash_Games" value="कैश गेम्स के लिए ऑटो टॉप-अप" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Description_Auto_TopUp" value="रीबाय बटन क्लिक करने से थक गए हैं? अपने स्टैक को कम न होने दें! इस फीचर से आप टेबल पर मजबूत बने रहेंगे। बस Jurojin को बताएं कब और कितना रीबाय करना है!" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Auto_Top_Up_Back_To" value="स्वचालित टॉप-अप वापस" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Blinds_When_My_Stack_Goes_Below" value="जब मेरा स्टैक नीचे चला जाए तब blinds" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_When_I_Run_Out_Of_Chips_On_Table_Rebuy_With" value="जब टेबल पर चिप्स खत्म हो जाएं, रीबाय करें" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Blinds" value="जब मेरा स्टैक नीचे चला जाए तब blinds" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Title_Auto_Top-Up_For_Cash_Games" value="रीबाय/टॉपअप" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Body_Auto_Top-Up_For_Cash_Games" value="इस फीचर से आप अपने टेबल पर स्वतः रीबाय या टॉपअप कर सकते हैं। अगर आप Zoom खेलते हैं, तो टॉपअप तभी होगा जब Jurojin fold hotkey दबाया जाएगा जिसमें देरी शामिल है।" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Toaster_Content_If_You_Play_Zone_Topup_Will_Happen_Only_With_Fold_Hotkey" value="यदि आप zone खेलते हैं, तो टॉपअप केवल Jurojin के fold hotkey के साथ होगा" />
    </sub>
    <sub id="4" name="UserControl - Color Stacks">
