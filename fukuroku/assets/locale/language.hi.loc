      <add key="SITE_CONFIGURATION_DETAILS_NL_Option_Move_Table_To_Slot_Whenever_I_Start_A_New_Hand" value="जब भी मैं नया हाथ शुरू करता हूँ, टेबल को slot में ले जाएं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Option_Move_Table_To_Slot_Only_If_I_Voluntarily_Put_Money_In_The_Hand" value="केवल तब टेबल को slot में ले जाएं जब मैं स्वेच्छा से हाथ में पैसे डालूं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Option_Move_Table_To_Slot_When_Flop_Is_Shown" value="हाथ में पहले hero के टर्न पर टेबल को slot में ले जाएं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_After_Hand_Has_Ended" value="जब हाथ समाप्त हो चुका हो..." />
