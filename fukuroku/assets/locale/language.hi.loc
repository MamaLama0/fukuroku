      <add key="AUTOBET_PREFLOP_Add_BBs_Limper_Help_Body" value="लिम्पर का मतलब है हर वह खिलाड़ी जिसने फ्लॉप देखने के लिए BB दिया, इससे ऊपर जो भी होगा वह कॉल माना जाता है, लिम्प नहीं। हर लिम्पर के लिए कुल राशि इस बॉक्स की वैल्यू से गुणा की जाएगी।" />
      <add key="AUTOBET_PREFLOP_Add_X_Times_Cold_Caller_Help_Title" value="प्रति कोल्ड कॉलर" />
      <add key="AUTOBET_PREFLOP_Add_X_Times_Cold_Caller_Help_Body" value="कोल्ड कॉल का मतलब है दो या अधिक राइज़ के बाद कॉल, या एक बेट और राइज़। प्रति कोल्ड कॉलर, कुल राशि इस बॉक्स के मान से गुणा होगी।" />
      <add key="AUTOBET_PREFLOP_Label_Multiply_X_Times_Open_Raise" value="ओपन राइज़ को X गुना करें" />
