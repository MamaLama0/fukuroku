    <sub id="1" name="Tab - Hotkey Configuration">
      <add key="HOTKEYS_NL_Tab_Header_Hotkey_Configuration" value="Hotkey कॉन्फ़िगरेशन" />
      <add key="HOTKEYS_NL_Label_Send_The_Hotkey_To" value="Hotkey भेजें" />
      <add key="HOTKEYS_NL_Check_Table_Below_Mouse_Pointer" value="माउस पॉइंटर के नीचे टेबल" />
      <add key="HOTKEYS_NL_Check_Focused_Table" value="फोकस किया गया table" />
      <add key="HOTKEYS_NL_Label_Override_Poker_Site_Wheel_Betting" value="व्हील बेट साइज समायोजन" />
      <add key="HOTKEYS_NL_Tooltip_Wheel_Betting_Title" value="व्हील बेट साइज समायोजन" />
      <add key="HOTKEYS_NL_Tooltip_Wheel_Betting_Body" value="इसे ऑन करने पर Jurojin माउस व्हील से बेट साइज समायोजित कर सकता है। आप स्लाइडर को BB या SB से मूव करने का चयन कर सकते हैं। यहाँ चुनी गई विकल्प Increment और Decrement hotkeys के व्यवहार को भी प्रभावित करेगी।" />
      <add key="HOTKEYS_NL_Label_Small_Blinds" value="Small Blinds" />
      <add key="HOTKEYS_NL_Label_Big_Blinds" value="Big Blinds" />
      <add key="HOTKEYS_NL_Label_Toggle_BB_Mode" value="BB Mode टॉगल करें" />
      <add key="HOTKEYS_NL_Label_BB_Convertion_On_Bodog_Bovada" value="Bodog/Iggy पर BB कन्वर्शन" />
      <add key="HOTKEYS_NL_Button_Click_Here" value="यहाँ क्लिक करें" />
      <add key="HOTKEYS_NL_Label_Instantly_Shove_Bet_When_Pressing_Hotkey" value="जब Bet-Size Hotkey का उपयोग करें" />
      <add key="HOTKEYS_NL_Label_Also_Instantly_Shove_When_Using_Betting_Overlay" value="जब Betting HUD पर Bet-Size Button का उपयोग करें" />
      <add key="HOTKEYS_NL_Label_Instant_Shove_Only_All_In" value="" />
      <add key="HOTKEYS_NL_Label_AutoBet" value="तुरंत चिप्स लगाएं" />
      <add key="HOTKEYS_NL_Label_Geometric_Betsizing" value="Geometric Betsizing" />
      <add key="HOTKEYS_NL_Label_Convert_This_Betsize_Into_A_Geometric_Bet_Size" value="इस betsize बटन को geometric bet size (2e, 3e) में बदलें" />
      <add key="HOTKEYS_NL_Banner_When_Using_Betsize_Overlay_You_Can_Use_Ctrl_Key" value="जब betsize overlay का उपयोग करें, तो 3e और 2e के बीच चुनने के लिए CTRL key का उपयोग करें" />
      <add key="HOTKEYS_NL_Tooltip_Geometric_Betsizing_Title" value="GEOMETRIC BETSIZING" />
      <add key="HOTKEYS_NL_Tooltip_Geometric_Betsizing_Body" value="इस फीचर से आप betsize बटन को geometric bet की तरह व्यवहार करने के लिए बदल सकते हैं। Geometric betsizes आपको flop/turn पर इस तरह दांव लगाने देते हैं कि अगले street पर इसी % दांव लगाने पर आप River में ऑल-इन तक पहुंच सकें।" />
    </sub>
