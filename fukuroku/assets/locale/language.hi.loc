    <sub id="2" name="Page - Edit Layout">
      <add key="EDIT_LAYOUT_NL_Title_Edit_Layout" value="Layout संपादित करें" />
      <add key="EDIT_LAYOUT_NL_Label_Layout_Name" value="Layout नाम" />
      <add key="EDIT_LAYOUT_NL_Label_Hotkey_To_Switch_Layout_During_Session" value="सेशन के दौरान Layout बदलने के लिए हॉटकी" />
      <add key="EDIT_LAYOUT_NL_Label_Dynamic_Slots" value="Dynamic Slots" />
      <add key="EDIT_LAYOUT_NL_Label_Resize_Every_Slot" value="हर slot का आकार बदलें" />
      <add key="EDIT_LAYOUT_NL_Label_Scale" value="स्केल:" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Playing_Area_Slot" value="PLAYING Slot जोड़ें" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Observer_Area_Slot" value="OBSERVER Slot जोड़ें" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Replay_Area_Slot" value="REPLAY Slot जोड़ें" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Lobby_Slot" value="LOBBY Slot जोड़ें" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Action_Required_Slot" value="ACTION REQUIRED Slot जोड़ें" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Title_Action_Required" value="कार्रवाई आवश्यक" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Body_Action_Required" value="यह slots स्क्रीन के उस क्षेत्र का प्रतिनिधित्व करते हैं जहां टेबल तब जाएंगी जब आपका खेलने का समय होगा। इस प्रकार के slots में एक समय में केवल एक टेबल होगी, जब ये सभी slots टेबल से भरे होंगे, तो टेबल Queue slots में चले जाएंगे, और जैसे ही action required slot खाली होगा, सबसे जरूरी टेबल Queue slot से भेजी जाएगी।" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Queue_Slot" value="QUEUE Slot जोड़ें" />
      <add key="EDIT_LAYOUT_NL_Button_Add_In_Hand_Slot" value="IN HAND Slot जोड़ें" />
      <add key="EDIT_LAYOUT_NL_Button_Save_Changes" value="परिवर्तन सहेजें" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Title" value="कुछ slots हटाए जाएँगे" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Message" value="लाल बॉर्डर्स वाले slots डिस्प्ले की सीमा के बाहर हैं या अन्य slots के साथ ओवरलैप कर रहे हैं और इन्हें हटा दिया जाएगा। क्या आप जारी रखना चाहते हैं?" />
      <add key="EDIT_LAYOUT_NL_Label_Stack_Tables_In_Ar_Slot" value="जैसे ही आपकी बारी आती है, AR Slot में टेबल्स को स्टैक करें" />
      <add key="EDIT_LAYOUT_Tooltip_Title_In_Hand" value="In Hand Slots" />
      <add key="EDIT_LAYOUT_Tooltip_Body_In_Hand" value="In Hand Slots महत्वपूर्ण हाथों पर ध्यान केंद्रित करने का सबसे अच्छा तरीका हैं, जब आप VPIP करेंगे तो टेबल्स यहाँ आ जाएँगी। आप इस व्यवहार को प्रत्येक साइट कॉन्फ़िगरेशन में सेट कर सकते हैं।" />
