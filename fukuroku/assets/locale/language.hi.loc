    <sub id="8" name="Dialog - Max Slots Reached">
      <add key="DIALOG_MAX_SLOTS_REACHED_NL_Title_Oops_You_Reached_The_Maximum" value="उफ़! आपने अधिकतम सीमा पहुँच ली है" />
      <add key="DIALOG_MAX_SLOTS_REACHED_NL_Body_Segment1" value="आपने अपने सभी Slots/Layouts का उपयोग कर लिया है। सक्रिय करें " />
      <add key="DIALOG_MAX_SLOTS_REACHED_NL_Body_Segment2" value="Tilling Bundle" />
