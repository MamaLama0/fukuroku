  <area id="105" name="Page - Settings">
    <add key="SETTINGS_NL_Tab_Title" value="सेटिंग्स" />
    <add key="SETTINGS_NL_Tab_Header_Global_Setting" value="वैश्विक सेटिंग्स" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Playing_Area" value="खेल क्षेत्र को मैग्नेटाइज़ करें" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Playing_Area" value="खेल क्षेत्र/slots को मैग्नेटाइज़ करें" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Playing_Area" value="खेल क्षेत्र मैग्नेटाइज़ किया जा सकता है, इसका मतलब है कि आप टेबल्स को ड्रैग और ड्रॉप कर सकते हैं और वे तुरंत slots में फिट हो जाएंगे। आप CTRL कुंजी दबाकर ड्रैग और ड्रॉप कर सकते हैं ताकि टेबल्स बदलने के बजाय वे स्टैक हों।" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Observer_Area" value="निरीक्षक क्षेत्र को मैग्नेटाइज़ करें" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Observer_Area" value="निरीक्षक क्षेत्र/slots को मैग्नेटाइज़ करें" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Observer_Area" value="निरीक्षक slots भी मैग्नेटाइज़ किए जा सकते हैं" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Lobby_Slots" value="लॉबी slots को मैग्नेटाइज़ करें" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Lobby_Slots" value="लॉबी slots को मैग्नेटाइज़ करें" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Lobby_Slots" value="जैसे कि लॉबी slots। जब तक लॉबी slots में स्टैक साइट्स का विकल्प हो" />
    <add key="SETTINGS_NL_CheckBox_Invert_Ctrl_Key" value="मैग्नेटाइज़ेशन के लिए CTRL कुंजी उपयोग उलटें" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Observer_Area_When_Table_Closed" value="जब टेबल बंद हो तो निरीक्षक क्षेत्र पुन: व्यवस्थित करें" />
    <add key="SETTINGS_NL_Tooltip_Title_Reoder_Observer_Area_When_Table_Closed" value="टेबल बंद होने पर निरीक्षक क्षेत्र पुन: व्यवस्थित करें" />
    <add key="SETTINGS_NL_Tooltip_Body_Reoder_Observer_Area_When_Table_Closed" value="जब कोई टेबल बंद हो, तो आप निरीक्षक slots में टेबल्स को पुन: व्यवस्थित कर सकते हैं" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Playing_Area_When_Table_Closed" value="जब टेबल बंद हो तो खेल क्षेत्र पुन: व्यवस्थित करें" />
    <add key="SETTINGS_NL_Tooltip_Title_Reorder_Playing_Area_When_Table_Closed" value="टेबल बंद होने पर खेल क्षेत्र पुन: व्यवस्थित करें" />
    <add key="SETTINGS_NL_Tooltip_Body_Reorder_Playing_Area_When_Table_Closed" value="जब कोई टेबल बंद हो, तो आप playing slots में टेबल्स को पुन: व्यवस्थित कर सकते हैं" />
    <add key="SETTINGS_NL_CheckBox_Keep_Most_Urgent_On_Top" value="स्टैक की तात्कालिकता प्रबंधित करें" />
    <add key="SETTINGS_NL_Tooltip_Title_Keep_Most_Urgent_On_Top" value="स्टैक की तात्कालिकता प्रबंधित करें" />
    <add key="SETTINGS_NL_Tooltip_Body_Keep_Most_Urgent_On_Top" value="जब टेबल एक स्लॉट (स्टैक) साझा करती हैं, Jurojin सबसे जरूरी टेबल (एक्ट करने का सबसे कम समय) को उस स्टैक के ऊपर लाता है। यह केवल स्टैक के अंदर दृश्यता प्रबंधित करता है — कीबोर्ड फ़ोकस नहीं हिलाता।" />
    <add key="SETTINGS_NL_CheckBox_Auto_Focus_Most_Urgent_Always" value="हमेशा सबसे जरूरी टेबल पर ऑटो फ़ोकस" />
    <add key="SETTINGS_NL_Tooltip_Title_Auto_Focus_Most_Urgent_Always" value="हमेशा सबसे जरूरी टेबल पर ऑटो फ़ोकस" />
    <add key="SETTINGS_NL_Tooltip_Body_Auto_Focus_Most_Urgent_Always" value="जब पहली टेबल पर एक्शन चाहिए (या एक्ट के बाद भी कोई और बाकी हो), Jurojin वैश्विक रूप से सबसे जरूरी टेबल पर फ़ोकस करता है ताकि माउस के बिना खेल सकें।" />
    <add key="SETTINGS_NL_CheckBox_Also_Force_Move_Mouse" value="माउस भी ज़बरदस्ती हिलाएँ" />
    <add key="SETTINGS_NL_Tooltip_Title_Also_Force_Move_Mouse" value="माउस भी ज़बरदस्ती हिलाएँ" />
    <add key="SETTINGS_NL_Tooltip_Body_Also_Force_Move_Mouse" value="फ़ोकस की गई टेबल पर माउस कर्सर भी ले जाता है। गेमपैड या उन साइटों के लिए उपयोगी जहाँ कर्सर टेबल पर होना चाहिए।" />
    <add key="SETTINGS_NL_CheckBox_Minimize_App_To_System_Tray" value="ऐप को सिस्टम ट्रे में मिनिमाइज़ करें" />
    <add key="SETTINGS_NL_CheckBox_Save_Jurojin_Location_On_Close" value="" />
    <add key="SETTINGS_NL_Tooltip_Title_Alarm_For_Action_Required" value="" />
    <add key="SETTINGS_NL_Tooltip_Title_Delayed_Alarm_Action_Enabled" value="कार्य आवश्यक होने पर विलंबित अलार्म" />
    <add key="SETTINGS_NL_Tooltip_Subtitle_Delayed_Alarm_Action_Enabled" value="आपकी बारी शुरू होने के 10 सेकंड बाद बजता है" />
    <add key="SETTINGS_NL_Tooltip_Body_Delayed_Alarm_Action_Required" value="आप Jurojin से आपकी बारी शुरू होने के बाद सेट किए गए सेकंड बीतने पर अलार्म बजवा सकते हैं, जब तक कार्रवाई अभी भी आवश्यक हो." />
    <add key="SETTINGS_NL_Tooltip_Body_Minimize_Application_To_System_Tray" value="जब आप यह फीचर चालू करके मिनिमाइज़ बटन दबाएंगे, तो ऐप विंडोज के निचले दाएं कोने के सिस्टम ट्रे में चले जाएगा।" />
    <add key="SETTINGS_NL_Tooltip_Title_Minimize_Application_To_System_Tray" value="ट्रे में मिनिमाइज़ करें" />
    <add key="SETTINGS_NL_CheckBox_Show_RNG" value="RNG दिखाएं" />
    <add key="SETTINGS_NL_CheckBox_Sub_Show_RNG" value="रैंडम नंबर जनरेटर" />
    <add key="SETTINGS_NL_Tooltip_Title_Show_Random_Number_Generator" value="RNG" />
    <add key="SETTINGS_NL_Tooltip_Body_Show_Random_Number_Generator" value="यह स्क्रीन पर एक RNG दिखाएगा (टेबल्स के ऊपर नहीं, यह स्वतंत्र है!)" />
    <add key="SETTINGS_NL_CheckBox_Drag_Table_Clicking_Anywhere" value="टेबल को कहीं भी क्लिक करके ड्रैग करें" />
    <add key="SETTINGS_NL_CheckBox_Focus_Table_Under_Mouse" value="माउस के नीचे टेबल पर फोकस करें" />
    <add key="SETTINGS_NL_Tooltip_Title_Focus_Table_Under_Mouse" value="माउस के नीचे टेबल पर फोकस करें" />
    <add key="SETTINGS_NL_Tooltip_Body_Focus_Table_Under_Mouse" value="यह फीचर माउस को टेबल पर होवर करने पर उसे सामने लाता है" />
    <add key="SETTINGS_NL_CheckBox_Bring_Only_Tables_In_Playing_Slot_To_Front" value="सिर्फ़ playing slot में टेबल्स को सामने लाएं" />
    <add key="SETTINGS_NL_Tab_Header_Global_Hotkeys" value="वैश्विक हॉटकीज़" />
    <add key="SETTINGS_NL_Label_Reorder_Playing_Area" value="खेल क्षेत्र पुनः व्यवस्थित करें" />
    <add key="SETTINGS_NL_Label_Reorder_Observer_Area" value="Observer Area को पुनः क्रमित करें" />
    <add key="SETTINGS_NL_Label_Send_Table_To_Playing_Area" value="Table को Playing Area में भेजें" />
    <add key="SETTINGS_NL_Tooltip_Title_Send_Table_To_Playing_Area" value="TABLES को PLAYING SLOTS में भेजें" />
    <add key="SETTINGS_NL_Tooltip_Body_Send_Table_To_Playing_Area" value="जब आप माउस से किसी table पर hover करें और यह hotkey दबाएं, तो यह अगले उपलब्ध playing slot में चला जाएगा। यह unsupported sites और emulators के लिए भी काम करता है! unsupported sites को हमारे forums में रिपोर्ट करना न भूलें!" />
    <add key="SETTINGS_NL_Label_Send_Table_To_Observer_Area" value="Table को Observer Area में भेजें" />
    <add key="SETTINGS_NL_Move_Tables_Clicking_Anywhere" value="Client area में कहीं भी क्लिक कर tables को मूव करें" />
    <add key="SETTINGS_NL_Tooltip_Title_Move_Tables_Clicking_Anywhere" value="कहीं भी क्लिक करके Tables मूव करें" />
    <add key="SETTINGS_NL_Tooltip_Body_Move_Tables_Clicking_Anywhere" value="यह फीचर आपको बिना विंडो के title bar पर क्लिक किए table ड्रैग करने देगा। ध्यान रखें कि आप table पर क्लिक करें, HUD की किसी child पर नहीं। table area के निचले 20% हिस्से में यह काम नहीं करेगा, हमने यह पोकर साइट्स के इन-बिल्ट bet sliders की समस्याओं से बचने के लिए किया है।" />
    <add key="SETTINGS_NL_Hide_Title_Bar_Of_Tables" value="Tables के title bar को छुपाएं" />
    <add key="SETTINGS_NL_Tooltip_Title_Send_Table_To_Observer_Area" value="TABLES को OBSERVE SLOTS में भेजें" />
    <add key="SETTINGS_NL_Tooltip_Body_Send_Table_To_Observer_Area" value="जब आप माउस से किसी table पर hover करें और यह hotkey दबाएं, तो यह अगले उपलब्ध observe slot में चला जाएगा। यह unsupported sites और emulators के लिए भी काम करता है! unsupported sites को हमारे forums में रिपोर्ट करना न भूलें!" />
    <add key="SETTINGS_NL_Label_Preview_Active_Layout" value="सक्रिय layout का पूर्वावलोकन" />
    <add key="SETTINGS_NL_Label_Cycle_Through_Tables" value="slot में tables के बीच चक्र लगाएं" />
