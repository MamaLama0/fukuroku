      <add key="SITE_CONFIGURATION_DETAILS_MODAL_Label_Action_To_Advanced_Configuration" value="उन्नत कॉन्फ़िगरेशन" />
      <add key="SITE_CONFIGURATION_DETAILS_MODAL_Label_Filter_All_Modals_That_Contain" value="सभी मोडल्स फ़िल्टर करें जो शामिल करते हैं..." />
      <add key="SITE_CONFIGURATION_DETAILS_MODAL_Button_Ok" value="ठीक है" />
