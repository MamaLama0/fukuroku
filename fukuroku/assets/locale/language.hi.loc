    <add key="OVERLAY_SETTINGS_PAGE_NL_Button_Save_Changes" value="परिवर्तन सहेजें" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_RNG" value="RNG" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Report_Table" value="रिपोर्ट टेबल" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Pot_Odds" value="पॉट ऑड्स" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Pot_Odds_Tooltip_Title" value="पॉट ऑड्स" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Pot_Odds_Tooltip_Body" value="इस ओवरले के साथ आप जोखिम और इनाम के बीच संबंध जान सकेंगे। इसे गणितीय संबंध reward:risk या प्रतिशत के रूप में दर्शाया जा सकता है।" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Stack_To_Pot_Ratio" value="SPR" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Tooltip_Title" value="SPR" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Tooltip_Body" value="इस ओवरले से आप प्रभावी स्टैक (सबसे कम चिप्स वाले खिलाड़ी का स्टैक) और पॉट साइज के बीच के संबंध को जान पाएंगे।" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Effective_Stack" value="EFFECTIVE STACK" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_EFFS_Tooltip_Title" value="EFF. S" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_EFFS_Tooltip_Body" value="इस ओवरले से आप देख सकते हैं कि हाथ में सबसे कम चिप्स वाला खिलाड़ी के पास कितनी चिप्स हैं" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bet_Buttons" value="बेट बटन" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Bet_Buttons_Tooltip_Title" value="बेट बटन" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Bet_Buttons_Tooltip_Body" value="यह ओवरले आपके हॉटकीज/बेटसाइज पेज पर सेट किए गए बेट मान दिखाएगा! यदि आप CTRL दबाकर ओवरले पर क्लिक करेंगे, तो आप अन्य आठ बेटसाइज देख पाएंगे" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Action_History" value="एक्शन इतिहास" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Action_History_Tooltip_Title" value="एक्शन इतिहास ओवरले" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Action_History_Tooltip_Body" value="यह ओवरले आपको खेलने के दौरान विरोधियों की मंशाओं को समझने में मदद करेगा, आप उनके हर एक्शन को देख पाएंगे" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Position" value="पोजीशन्स" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Positions_Tooltip_Title" value="पोजीशन्स ओवरले" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Positions_Tooltip_Body" value="इस ओवरले से आप टेबल पर हर खिलाड़ी की स्थिति देख पाएंगे" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_AR_Tables_Counter" value="एक्शन आवश्यक टेबल काउंटर" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Hand_Tables_Counter" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_ST_Tables_Counter" value="स्टैक्ड टेबल काउंटर" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_TOASTER_Check_Guide" value="सीट आधारित ओवरले के लिए आपका ब्राउज़र में गाइड खुलेगा ताकि आप सब कुछ सही ढंग से कॉन्फिगर कर सकें। फीचर टेस्ट करने से पहले सभी साइट्स पर सीट सेंटरिंग ठीक होना सुनिश्चित करें!" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_SPR_Next_Street" value="SPR N.S." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_POT_Next_Street" value="POT N.S." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Next_Street_Tooltip_Title" value="SPR अगली स्ट्रीट ओवरले" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Next_Street_Tooltip_Body" value="यह ओवरले आपकी बेटफील्ड वैल्यू पढ़ेगा, और मान लेगा कि आपका विरोधी कॉल करेगा, फिर अगली स्ट्रीट का SPR कैलकुलेट करेगा" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ON_DISABLE_Actions_Title" value="ओवरले डिसेबल करें" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ON_DISABLE_Actions_Message" value="क्या आप सुनिश्चित हैं? यदि यह ओवरले डिसेबल किया गया तो आप टेबल या हैंड समस्याओं की रिपोर्ट नहीं कर पाएंगे।" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_AR_Counter_Tooltip_Title" value="एक्शन आवश्यक टेबल काउंटर" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_AR_Counter_Tooltip_Body" value="यह overlay आपको बताएगा कि उस specific slot पर उस समय कितनी tables को action लेने की जरूरत है। इसका cycle button केवल उन tables के बीच घूमेगा जिन्हें action की आवश्यकता है।" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ST_Counter_Tooltip_Title" value="Stacked Tables Counter" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ST_Counter_Tooltip_Body" value="इस overlay का उपयोग करके जानें कि किसी specific slot पर कितनी tables हैं।" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Hand_Counter_Tooltip_Title" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Hand_Counter_Tooltip_Body" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Save_Location_Title" value="स्थान सहेजें" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Save_Location_Body" value="सुनिश्चित करें कि आप Jurojin के home screen पर हैं और फिर अपनी overlays को डॉटेड area पर क्लिक करके जहाँ चाहें व्यवस्थित करें। फिर उस table पर hotkey दबाएं।" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Outs" value="MINIMUM OUTS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Minimum_Outs_Tooltip_Title" value="MINIMUM OUTS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency" value="MDF" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency_Tooltip_Title" value="न्यूनतम रक्षा आवृत्ति" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency_Tooltip_Body" value="यह overlay दिखाता है कि आपको अपने opponent की एक specific bet size को न्यूनतम कितने प्रतिशत हाथों में कॉल करना चाहिए ताकि आपके opponent आपको exploit न कर सकें।" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity" value="BLUFF EQUITY" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity_Tooltip_Title" value="BLUFF EQUITY" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity_Tooltip_Body" value="यह दर्शाता है, एक bet size के आधार पर (जो आपके betbox से पढ़ा जाता है किसी भी bet से पहले), कि आपके opponent को कितनी बार fold करना चाहिए आपकी उनकी खेलने की शैली की जानकारी के आधार पर, एक दिए गए स्थिति में ताकि वह bet आपके लिए लाभदायक हो, खासकर bluff करते समय उपयोगी।" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_POT_Next_Street_Tooltip_Title" value="POT Next Street Overlay" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_POT_Next_Street_Tooltip_Body" value="यह HUD स्वचालित रूप से अगले betting round के लिए अपेक्षित pot size की गणना करता है, वर्तमान bet-box value को ध्यान में रखते हुए (raise submit करने से पहले) और यह मानते हुए कि opponent कॉल करेगा।" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Minimum_Outs_Tooltip_Body" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Take_Screenshot" value="SCREENSHOT लें" />
