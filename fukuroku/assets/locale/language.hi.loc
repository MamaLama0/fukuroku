      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_All_In" value="ALL IN" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Button1" value="BUTTON 1" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Button2" value="BUTTON 2" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Button3" value="BUTTON 3" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Button4" value="BUTTON 4" />
