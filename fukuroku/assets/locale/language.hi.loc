    <sub id="9" name="Dialog - Auto Layout Switch">
      <add key="DIALOG_AUTO_LAYOUT_SWITCH_NL_Title" value="स्वचालित Layout स्विच" />
      <add key="DIALOG_AUTO_LAYOUT_SWITCH_NL_Body" value="मैन्युअली Layout सक्रिय करने से स्वचालित Layout स्विच बंद हो जाएगा। क्या आप वाकई यह फीचर बंद करके यह Layout सक्रिय करना चाहते हैं?" />
    </sub>
    <sub id="10" name="Faulty Layout Messages">
      <add key="ON_LAYOUT_FAULT_1" value="इस Layout में कोई डिस्प्ले जानकारी सहेजी नहीं गई है। हम सुझाव देते हैं कि आप इसे कम से कम एक बार संपादित करें ताकि डिस्प्ले जानकारी सहेज ली जाए।" />
      <add key="ON_LAYOUT_FAULT_2" value="आपके डिस्प्ले कॉन्फ़िगरेशन इस Layout को बनाने के बाद से बदल गए हैं। कृपया इसे संपादित करें या हटा दें।" />
      <add key="ON_LAYOUT_FAULT_4" value="इस Layout को बनाने के बाद आपने अपना DPI% बदला है। कृपया इसे संपादित करें या हटा दें।" />
      <add key="ON_LAYOUT_FAULT_8" value="आपके डिस्प्ले उस समय से बदल गए हैं जब आपने यह Layout बनाया था। यह Layout ठीक से काम नहीं कर सकता।" />
      <add key="ON_LAYOUT_FAULT_16" value="Layout में कुछ त्रुटिपूर्ण slots हैं। हम सुझाव देते हैं कि आप इसे अब संपादित करें।" />
      <add key="ON_SLOT_FAULT_1" value="" />
      <add key="ON_SLOT_FAULT_2" value="" />
      <add key="ON_SLOT_FAULT_4" value="" />
    </sub>
    <sub id="11" name="Dialog - Confirm Swap">
      <add key="DIALOG_CONFIRM_SWAP_Title" value="स्वैप की पुष्टि करें" />
      <add key="DIALOG_CONFIRM_SWAP_Body_Do_You_Want_To_Swap" value="क्या आप स्वैप करना चाहते हैं" />
      <add key="DIALOG_CONFIRM_SWAP_Body_With" value="के साथ" />
