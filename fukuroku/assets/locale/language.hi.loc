      <add key="NEWS_WINDOW_Label_We_Have_An_Insane_Offer_For_All_Annual_Bundles" value="सभी वार्षिक बंडलों के लिए हमारे पास एक शानदार ऑफर है!" />
      <add key="NEWS_WINDOW_Label_Get_Off_1" value="प्राप्त करें" />
