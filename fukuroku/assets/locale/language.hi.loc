    <sub id="1" name="Tab - Comfort Features">
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tab_Header_Confort_Features" value="सुविधा सुविधाएँ" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_BB_Conversion" value="BB रूपांतरण" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Show_BB_On_Stacks" value="Stacks पर “BB” दिखाएं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Check_Add_BB_To_Stacks" value="Stacks में &quot;BB&quot; जोड़ें" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Dont_Add_BB_To_Stacks" value="Stacks में “BB” न जोड़ें" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Ammount_Of_Decimals" value="दशमलव की संख्या" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Show_One_Decimal" value="एक दशमलव दिखाएं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Show_Two_Decimals" value="दो दशमलव दिखाएं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Font_Size" value="फ़ॉन्ट आकार" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Auto_Timebank" value="Auto Timebank" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Avoid_Sitting_Out" value="बैठने से बचें" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Title_Avoid_Sitting_Out" value="बैठने से बचें" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Body_Avoid_Sitting_Out" value="यदि आपका समय खत्म हो जाता है, चाहे आपका timebank हो या न हो, यह फीचर अपने आप पोकर रूम को बताएगा कि आप टेबल पर वापस आ गए हैं।" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Keep_The_Spins_Rolling" value="Spins को चालू रखें" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Hide_Hero_Balance" value="Hero Balance छिपाएं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Title_Hide_Hero_Balance" value="Balance छिपाएं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Body_Hide_Hero_Balance" value="इस फीचर के साथ आप पोकर साइट पर अपनी बैंकрол छिपा सकते हैं, आपकी बैलेंस के बगल में एक क्लिक करने योग्य आइकन दिखेगा जिससे आप इसकी दृश्यता चालू या बंद कर सकते हैं।" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Title_Keep_Spins_Rolling" value="स्पिन्स को चलते रहना" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Body_Keep_Spins_Rolling" value="एक स्पिन खत्म होने के बाद, Jurojin तुरंत नया स्पिन शुरू करने के लिए आपके लिए एक और टिकट खरीद लेगा! खेल खत्म होने पर इसे बंद करना न भूलें!" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Copy_Player_Name" value="प्लेयर का नाम कॉपी करें" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Dont_Remove" value="इस फंक्शन के काम करने के लिए &lt;PLAYER&gt; में &lt;&gt; को न हटाएं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Custom_Link" value="कस्टम लिंक" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Copy_Player_Name_To_Clipboard_Double_Clicking_Player_Seat_Stack" value="प्लेयर के सीट स्टैक पर डबल क्लिक करने पर प्लेयर का नाम क्लिपबोर्ड पर कॉपी करें" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Hide_Board_If_All_In" value="अगर ऑल इन हो तो बोर्ड छुपाएं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Title_Hide_Board" value="बोर्ड छुपाएं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Body_Hide_Board" value="टिल्ट और घबराहट से बचने के लिए जब आप ऑल इन जाएं तो बोर्ड छुपा सकते हैं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Color_Stacks" value="स्टैक्स को रंग दें" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Set_A_Specific_Color_On_Stacks_Based_On_Amount" value="प्लेयर के स्टैक साइज के आधार पर स्टैक्स पर एक विशिष्ट रंग सेट करें" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Title_BB_Conversion" value="BB कन्वर्शन" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tooltip_Body_BB_Conversion" value="इस फीचर से आप स्टैक्स और बेटसाइज़ को BB वैल्यूज़ में बदल सकते हैं। अपने स्टैक पर क्लिक करके इन्हें स्विच कर सकते हैं, और वैल्यू में दशमलव की संख्या भी बदल सकते हैं। इस फीचर का उपयोग करने के लिए Bodog की बिल्ट-इन कन्वर्शन बंद करें!" />
    </sub>
    <sub id="2" name="Tab - Hoytkeys Baypassing">
      <add key="SITE_CONFIGURATION_DETAILS_NL_Tab_Header_Hoytkeys_Baypassing" value="Hoytkeys बायपासिंग" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Tell_Jurojin_Your_Hotkey_Bindings" value="Jurojin को अपने होटकी बाइंडिंग्स बताएं" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Description_Proxying_Hotkeys" value="क्या आप इस साइट पर कंट्रोलर से खेलना चाहते हैं, या माउस से fold/check/bet करना चाहते हैं? बस Jurojin को अपने पोकर रूम में सेट किए गए होटकी बताएं और हम कीबोर्ड स्ट्रोक्स आपके लिए सिम्यूलेट करेंगे।" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Fold" value="FOLD" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Check_Call" value="CHECK/CALL" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Toggle_BB_Mode" value="BB मोड चालू/बंद करें" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Increment_Decrement_Bet" value="बाठी बढ़ाएँ/घटाएँ" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Increment" value="बाठी बढ़ाएँ/घटाएँ" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Decrement" value="घटाएँ" />
