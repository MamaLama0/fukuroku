      <add key="LAYOUT_CONFIGURATION_NL_Button_Create_New_Layout" value="नया Layout बनाएं" />
      <add key="LAYOUT_CONFIGURATION_NL_Tab_Header_Automatic_Layout_Switch" value="स्वचालित Layout स्विच" />
      <add key="LAYOUT_CONFIGURATION_NL_Switch_Feature_Enabled" value="फीचर सक्षम" />
      <add key="LAYOUT_CONFIGURATION_NL_Switch_Feature_Disabled" value="फीचर अक्षम" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Auto_Switch_Options" value="स्वचालित स्विच विकल्प" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Initial_Layout" value="प्रारंभिक" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Go_Back_To_Previous_Layout_If_Table_Decrease" value="यदि टेबल कम हो तो पिछले layout पर वापस जाएं" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Ask_Before_Switching_Layout_Automatically" value="स्वचालित रूप से layout स्विच करने से पहले पूछें" />
      <add key="LAYOUT_CONFIGURATION_NL_Info_Automatically_Switch_From_An_Initial_Layout" value="Jurojin का उपयोग करते हुए हमेशा एक सक्रिय layout होगा, हालांकि हम आपको प्रारंभिक layout से स्वचालित रूप से स्विच करने की सुविधा भी देते हैं।" />
      <add key="LAYOUT_CONFIGURATION_NL_Button_Save_Changes" value="परिवर्तन सहेजें" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_LAYOUT_SWITCH_Title" value="LAYOUT स्विच करें" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_LAYOUT_SWITCH_Message" value="क्या आप स्वचालित रूप से इस LAYOUT पर स्विच करना चाहते हैं " />
      <add key="LAYOUT_CONFIGURATION_NL_Help_Layout_Switch_Title" value="स्वचालित Layout स्विच" />
      <add key="LAYOUT_CONFIGURATION_NL_Help_Layout_Switch_Body" value="यह फीचर खुले हुए टेबल्स की संख्या के आधार पर सक्रिय layout को स्वचालित रूप से बदल देगा। शुरू करने के लिए पहले layout स्विच के नीचे पेंसिल आइकन पर क्लिक करें।" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_TABLES_LAYOUT_CONFIGURATION_Auto_Swap_Caption" value="स्वचालित Layout स्विच" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_TABLES_LAYOUT_CONFIGURATION_Auto_Swap_Message" value="मैन्युअली Layout सक्रिय करने से Automatic Layout Switch अक्षम हो जाएगा। क्या आप सुनिश्चित हैं कि आप यह फीचर बंद करके यह Layout सक्रिय करना चाहते हैं?" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_Title" value="चेतावनी!" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_Message" value="हमने आपके डिस्प्ले कॉन्फ़िगरेशन में बदलाव का पता लगाया है और आपका वर्तमान सक्रिय layout में slots सीमा के बाहर हैं। क्या आप अभी Active Layout संपादित करना चाहते हैं?" />
      <add key="LAYOUT_CONFIGURATION_NL_Tab_Header_Layout_Hotkeys" value="Layout हॉटकीज़" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Playing_Slot" value="Playing Slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Send_Table_To_Playing_Slot" value="टेबल को एक playing slot में भेजें" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Observer_Slot" value="Observer Slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Send_Table_To_Observer_Slot" value="टेबल को एक observer slot में भेजें" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Playing_Slot_No" value="Playing Slot #" />
      <add key="LAYOUT_CONFIGURATION_NL_Hotkeys_Label_Observer_Slot_No" value="Observer Slot #" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Lock_Table_Of_Dynamic_Flow" value="डायनामिक फ्लो से बाहर टेबल लॉक करें" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Move_Table_To_Next_Slot" value="टेबल को अगले slot में ले जाएं" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Move_Table_To_Previous_Slot" value="टेबल को पिछले slot में ले जाएं" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Help_Title_Lock_Table" value="टेबल लॉक/पुनः डालें" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Help_Body_Lock_Table" value="इस हॉटकी का उपयोग डायनेमिक slots फ्लो (AR/In Hand) से टेबल को निकालने या पुनः डालने के लिए करें। मूल रूप से, आपकी टेबल जिस भी slot में है, वहाँ बनी रहेगी। आप इस टेबल पर हॉटकी फिर से दबाकर डायनेमिक फ्लो में वापस जा सकते हैं।" />
    </sub>
    <sub id="1" name="Page - Create New Layout">
      <add key="CREATE_NEW_LAYOUT_NL_Title_Create_New_Layout" value="नया Layout बनाएं" />
      <add key="CREATE_NEW_LAYOUT_NL_Button_Create_Manually" value="मैन्युअली बनाएं" />
      <add key="CREATE_NEW_LAYOUT_NL_Button_Create_Automatically" value="स्वचालित रूप से बनाएं" />
      <add key="CREATE_NEW_LAYOUT_NL_Button_Start_Form_Preset_Layout" value="PRESET LAYOUT से प्रारंभ करें" />
      <add key="CREATE_NEW_LAYOUT_NL_Button_Clone_Existing_Layout" value="मौजूदा LAYOUT क्लोन करें" />
      <add key="CREATE_NEW_LAYOUT_NL_Help_Option_Unavaliable_For_Your_Screen_Resolution" value="यह विकल्प आपकी स्क्रीन रिज़ॉल्यूशन के लिए उपलब्ध नहीं है" />
