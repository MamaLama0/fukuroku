  <area id="122" name="Dialogs - Report Issue">
    <sub id="0" name="Dialog - Report Issue">
      <add key="DIALOG_REPORT_ISSUE_NL_Title" value="समस्या रिपोर्ट करें" />
      <add key="DIALOG_REPORT_ISSUE_NL_Label_Thank_You_For_Your_Help" value="आपकी मदद के लिए धन्यवाद!" />
      <add key="DIALOG_REPORT_ISSUE_NL_Label_Write_The_Issue_Here" value="यहाँ समस्या लिखें..." />
      <add key="DIALOG_REPORT_ISSUE_NL_Button_Send_Report_To_Jurojin_Servers" value="रिपोर्ट Jurojin Servers को भेजें" />
      <add key="DIALOG_REPORT_ISSUE_NL_Button_Sending" value="भेजा जा रहा है..." />
      <add key="DIALOG_REPORT_ISSUE_NL_Button_Add_Hand_To_Report" value="हैंड सबमिट करें" />
    </sub>
    <sub id="1" name="Dialog - Replied Issue">
      <add key="DIALOG_REPLIED_ISSUE_NL_Title" value="हमने आपकी समस्या रिपोर्ट का जवाब दिया है" />
      <add key="DIALOG_REPLIED_ISSUE_NL_Label_Your_Report" value="आपकी रिपोर्ट" />
      <add key="DIALOG_REPLIED_ISSUE_NL_Button_Close" value="बंद करें" />
    </sub>
    <sub id="2" name="Dialog - Follow up issue">
      <add key="DIALOG_FOLLOW_UP_ISSUE_NL_Title" value="क्या आप इस समस्या पर हमसे बात जारी रखना चाहते हैं?" />
      <add key="DIALOG_FOLLOW_UP_ISSUE_NL_Label_Reply_To_The_Email_We_Sent_You" value="हमने जो ईमेल भेजा है, उसका जवाब दें" />
      <add key="DIALOG_FOLLOW_UP_ISSUE_NL_Label_Just_Reply_To_Our_Email_And_We_Will_Answer_You_As_Soon_As_Possible" value="बस हमारे ईमेल का जवाब दें और हम जल्द से जल्द आपको उत्तर देंगे" />
      <add key="DIALOG_FOLLOW_UP_ISSUE_NL_Button_Got_It" value="समझ गया" />
      <add key="DIALOG_FOLLOW_UP_ISSUE_NL_Label_Join_Our_Discord_Community" value="हमारे Discord समुदाय में शामिल हों" />
      <add key="DIALOG_FOLLOW_UP_ISSUE_NL_Label_Where_You_Can_Talk_About_This_Issue_And_Many_Other_Things" value="जहाँ आप इस समस्या और कई अन्य बातों पर चर्चा कर सकते हैं" />
      <add key="DIALOG_FOLLOW_UP_ISSUE_NL_Join_Discord" value="Discord में शामिल हों" />
    </sub>
    <sub id="3" name="Dialog - Pending Reports">
      <add key="DIALOG_PENDING_REPORTS_Title" value="लंबित रिपोर्ट्स" />
      <add key="DIALOG_PENDING_REPORTS_Body_1" value="रुकें! आपके पास" />
      <add key="DIALOG_PENDING_REPORTS_Body_2" value="लंबित हाथ की रिपोर्ट्स हैं जो हमारे सर्वर पर नहीं भेजी गई हैं! क्या आप उन्हें ऐप बंद करने से पहले भेजना चाहते हैं?" />
      <add key="DIALOG_PENDING_REPORTS_Button_Send_Reports" value="हाँ, रिपोर्ट्स भेजें" />
      <add key="DIALOG_PENDING_REPORTS_Button_Sending_Reports" value="रिपोर्ट्स भेजी जा रही हैं" />
      <add key="DIALOG_PENDING_REPORTS_Button_Exit_Jurojin" value="नहीं, Jurojin बंद करें" />
    </sub>
    <sub id="4" name="Dialog - Get AI Help Report Issue">
      <add key="DIALOG_AI_HELP_REPORT_ISSUE_Title" value="मद्दद लें या समस्या रिपोर्ट करें – आपके लिए क्या बेहतर है?" />
      <add key="DIALOG_AI_HELP_REPORT_ISSUE_Label_Talk_To_Your_Ai_Assistant" value="अभी अपने AI सहायक से बात करें" />
      <add key="DIALOG_AI_HELP_REPORT_ISSUE_Get_Quick_Personalized_Answers_To_Resolve_Issue" value="अपने समस्या को हल करने के लिए त्वरित, व्यक्तिगत उत्तर प्राप्त करें।" />
      <add key="DIALOG_AI_HELP_REPORT_ISSUE_Button_Chat_With_AI" value="AI से चैट करें" />
      <add key="DIALOG_AI_HELP_REPORT_ISSUE_Label_Contact_The_Jurojin_Team_Directly" value="सीधे Jurojin टीम से संपर्क करें" />
      <add key="DIALOG_AI_HELP_REPORT_ISSUE_Label_Report_Issue_To_Our_Team_We_Handle_It_ASAP" value="समस्या सीधे हमारी टीम को रिपोर्ट करें, और हम इसे जल्द से जल्द संभालेंगे।" />
      <add key="DIALOG_AI_HELP_REPORT_ISSUE_Button_Report_Issue" value="समस्या रिपोर्ट करें" />
    </sub>
  </area>
  <area id="123" name="Feature Showcase">
    <sub id="0" name="Highlight Callouts">
      <add key="FEATURE_SHOWCASE_NL_Body_Action_History_Settings" value="नई शानदार थीम्स देखें। स्पॉइलर अलर्ट: &quot;Minimal&quot; आपकी अगली पसंदीदा थीम होगी!" />
      <add key="FEATURE_SHOWCASE_NL_Body_Keep_Most_Urgent_On_Top" value="&quot;स्टैक की तात्कालिकता प्रबंधित करें&quot; चालू करें, ताकि एक ही स्लॉट में कई टेबल रखने पर Jurojin सबसे जरूरी टेबल को सबसे ऊपर रखे। अपनी पोकर साइट का अपना टेबल फ़ोकस/तात्कालिकता विकल्प भी बंद करें, ताकि वह Jurojin से न टकराए।" />
      <add key="FEATURE_SHOWCASE_NL_Body_Auto_Focus_Most_Urgent" value="&quot;हमेशा सबसे जरूरी टेबल पर ऑटो फ़ोकस&quot; चालू करें, और Jurojin हमेशा सबसे जरूरी टेबल को सबसे ऊपर रखेगा, भले ही आपकी टेबल एक-दूसरे पर चढ़ी हों। अपनी पोकर साइट का अपना टेबल फ़ोकस/तात्कालिकता विकल्प भी बंद करें, ताकि वह Jurojin से न टकराए।" />
      <add key="FEATURE_SHOWCASE_TOAST_Configuration_Suggestion" value="Jurojin के पास आपके लिए एक कॉन्फ़िगरेशन सुझाव है!" />
    </sub>
  </area>
</locale>
