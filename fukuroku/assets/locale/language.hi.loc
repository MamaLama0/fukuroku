      <add key="EULA_Button_Resign_And_Close" value="अस्वीकार करें और बंद करें" />
      <add key="EULA_Text_You_Cannot_Use_The_App_Until_Terms_Conditions" value="क्षमा करें, आप ऐप का उपयोग तब तक नहीं कर सकते जब तक शर्तें और नियम स्वीकार नहीं किए जाते" />
      <add key="EULA_Text_You_Cannot_Create_Account_Until_Terms_Conditions" value="क्षमा करें, जब तक आप शर्तें और नियम स्वीकार नहीं करते, आप खाता नहीं बना सकते।" />
      <add key="EULA_Text_There_Was_A_Problem" value="शर्तें और नियम पर हस्ताक्षर करने के लिए सर्वर से कनेक्ट करने में समस्या हुई, कृपया बाद में पुनः प्रयास करें या हमसे संपर्क करें!" />
      <add key="EULA_Check_Join_Jurojin_Newsletter_1" value="Jurojin न्यूज़लेटर से जुड़ें" />
      <add key="EULA_Check_Join_Jurojin_Newsletter_2" value="विशेष छूट और ऐप समाचार" />
    </sub>
    <sub id="7" name="News">
