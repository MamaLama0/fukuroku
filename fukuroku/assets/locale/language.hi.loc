  <area id="120" name="Toasters">
    <add key="ACTIVE_LAYOUT_TOASTER_TEXT" value="सक्रिय layout: " />
    <add key="NO_ACCESS_TO_FEATURE_MESSAGE" value="#game# में #name# तक पहुँच नहीं! कृपया हमारी Discord समुदाय में पूछें!" />
    <add key="HOTKEYS_DISABLED_FOR_SITE" value="याद रखें, आपने #game# साइट के लिए hotkeys अक्षम कर दिए हैं! आप उन्हें hotkeys सेक्शन में वापस चालू कर सकते हैं!" />
    <add key="OVERLAYS_POSITION_SAVED" value="आपकी overlays की स्थिति अब सेव कर दी गई है!" />
    <add key="APP_LOCATION_RESTORED" value="ऐप का स्थान पुनस्थापित किया गया" />
    <add key="INJECTION_AVOIDED_VIA_BACKOFFICE_NOTIF" value="कृपया ऐप दोबारा खोलें! आपके पोकयरूम में से एक अब diagnosis मोड में है और हमें समस्या को जल्द से जल्द हल करने के लिए सभी से ऐप फिर से खोलने की आवश्यकता है!" />
    <add key="INJECTION_AVOIDED_VIA_BACKOFFICE" value="कृपया ऐप दोबारा खोलें! आपके पोकयरूम में से एक अब diagnosis मोड में है और हमें समस्या को जल्द से जल्द हल करने के लिए सभी से ऐप फिर से खोलने की आवश्यकता है!" />
    <add key="HOSTS_FILE_BLOCKS_HELP_REPORT" value="hosts फ़ाइल के कारण सहायता अवरुद्ध है। सपोर्ट से संपर्क करें।" />
    <add key="COINPOKER_ALT_STUCK_UNJAMMED" value="CoinPoker Alt Stucked was Unjammed" />
    <add key="NEW_APP_VERSION_NOTIFICATION" value="आपके पास नया पेंडिंग अपडेट है! नवीनतम संस्करण पाने के लिए Jurojin को पुनः खोलना सुझाव दिया जाता है!" />
    <add key="MOVE_ARROUND_HOTKEYS_DISCLAIMER" value="यदि आप कीबोर्ड से खेल रहे हैं तो &quot;Focus Table Under Mouse&quot; को बंद करें या माउस पॉइंटर को कोने में छोड़ दें!" />
    <add key="SPACEBAR_NOT_RECOMMENDED" value="आपको #game# पर spacebar को hotkey के रूप में उपयोग नहीं करना चाहिए क्योंकि यह कई बग्स उत्पन्न करता है!" />
    <add key="KEEP_MOST_URGENT_MESSAGE" value="हमने आपके ब्राउज़र में एक मार्गदर्शिका खोली है ताकि आप प्रत्येक साइट को 'Keep Most Urgent on Top' फीचर के लिए ठीक से कॉन्फ़िगर कर सकें" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_TITLE" value="माउस के बिना खेलें?" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_BODY" value="Auto Focus कीबोर्ड फ़ोकस को सबसे जरूरी टेबल पर ले जाता है। माउस के बिना fold, check या bet के लिए टेबल हॉटकी फ़ोकस की गई टेबल पर लगनी चाहिए।" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_YES" value="हाँ, बदलें" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_IGNORE" value="नज़रअंदाज़ करें" />
    <add key="ONE_TABLE_HOTKEYS_MESSAGE" value="आप एक बार में केवल एक टेबल पर ही hotkeys का उपयोग कर सकते हैं! यदि आप सभी टेबल्स पर उन्हें उपयोग करना चाहते हैं तो कृपया हमारे स्टोर को देखें!" />
    <add key="CONNECTION_COLLIDED" value="यह ऐप एक समय में केवल एक पीसी पर चल सकता है, आपकी ऐप दूसरी पीसी पर खुली रहेगी" />
    <add key="PACIFIC_POKER_X64" value="आपके पास 888Poker का x64 संस्करण है जहाँ केवल tiling काम करेगा। आप हमारे गाइड का पालन कर सकते हैं, x86 संस्करण इंस्टॉल करना इसे ठीक कर देगा।" />
    <add key="PACIFIC_POKER_X64_WORKING" value="Jurojin अब पूरी तरह से 888 (x64) संस्करण का समर्थन करता है, कृपया अपने क्षेत्र के लिए नवीनतम 888 सॉफ़्टवेयर डाउनलोड और इंस्टॉल करें। परिणामस्वरूप, x86 समर्थन अब बंद कर दिया गया है।" />
    <add key="TABLE_BURIED_IN_STACK_DIALOG" value="आपकी कुछ जरूरी टेबल्स एक स्टैक में दबी हुई हैं! जब आप यह संवाद बंद करेंगे तो आपका ब्राउज़र एक बहुत उपयोगी लेख खोलेगा, कृपया 'Keep Most Urgent on Top' फीचर चालू करें" />
    <add key="TABLE_BURIED_IN_STACK_TOASTER" value="आपकी कुछ जरूरी टेबल्स एक स्टैक में दबी हुई हैं, 'Keep Most Urgent on Top' फीचर चालू करने पर विचार करें।" />
    <add key="STACK_GUIDANCE_STACKING_OFF" value="उफ़ — एक स्लॉट में कई टेबल हैं और स्टैकिंग सुविधाएँ बंद हैं। हम दिखाएँगे कैसे ठीक करें। इस डायलॉग को बंद करने पर ब्राउज़र में गाइड खुलेगी।" />
    <add key="STACK_GUIDANCE_ENHANCE_STACK" value="स्टैक्ड प्ले में आप सही रास्ते पर हैं। कुछ और सुविधाएँ दिखाते हैं जो फ़र्क़ लाएँगी। इस डायलॉग को बंद करने पर ब्राउज़र में गाइड खुलेगी।" />
    <add key="APP_LIMITATIONS_FREE_TIER_STAKE_NOT_COVERED" value="Free Tier प्लान स्टेक्स के कारण इस टेबल को कवर नहीं करता। सब्सक्राइब करें और अनलॉक करें!" />
    <add key="APP_LIMITATIONS_FREE_TIER_STAKE_NOT_COVERED_ACTION" value="सब्सक्राइब करें और अनलॉक करें!" />
    <add key="APP_LIMITATIONS_FREE_TIER_EXEMPT_ROOM_NOT_COVERED" value="#game# टेबल Free प्लान पर समर्थित नहीं हैं।" />
    <add key="APP_LIMITATIONS_FREE_TIER_EXEMPT_ROOM_NOT_COVERED_ACTION" value="Tiling सब्सक्राइब करें" />
    <add key="APP_LIMITATIONS_LOW_STAKES_QUOTA_REACHED" value="ओह, आपने Low-Stakes से ऊपर की कोटा पूरी कर ली है। अनलॉक करने के लिए अपग्रेड करें!" />
    <add key="APP_LIMITATIONS_LOW_STAKES_QUOTA_REACHED_ACTION" value="अनलॉक करने के लिए अपग्रेड करें!" />
    <add key="APP_LIMITATIONS_CLUBGG_FULL_ACCESS_ONLY" value="ClubGG केवल Full Access में शामिल है" />
    <add key="APP_LIMITATIONS_CLUBGG_FULL_ACCESS_ONLY_ACTION" value="Full Access प्राप्त करें" />
    <add key="APP_LIMIATIONS_MAX_TILED_TABLES_REACHED" value="आप उच्च स्टेक्स की केवल दो टेबल टाइल कर सकते हैं, और माइक्रोस्टेक्स हो तो असीमित!" />
    <add key="APP_LIMIATIONS_MAX_TILED_TABLES_REACHED_ACTION" value="Tiling Bundle लें" />
    <add key="APP_LIMITATIONS_NEW_TABLE_GAINED_HOTKEY_RIGHTS" value="यह अब वह उच्च-स्टेक्स टेबल है जहाँ मुफ़्त हॉटकी उपलब्ध हैं!" />
    <add key="APP_LIMITATIONS_NEW_TABLE_GAINED_HOTKEY_RIGHTS_ACTION" value="सभी टेबल पर हॉटकी सक्षम करें" />
    <add key="APP_LIMITATIONS_TABLE_DOESNT_HAVE_HOTKEY_RIGHTS" value="इस टेबल पर हॉटकी इस्तेमाल नहीं कर सकते" />
    <add key="APP_LIMITATIONS_TABLE_DOESNT_HAVE_HOTKEY_RIGHTS_ACTION" value="सभी टेबल पर हॉटकी सक्षम करें" />
    <add key="APP_LIMITATIONS_TABLE_DOESNT_HAVE_HOTKEY_RIGHTS_SHOW_FREE_TABLE" value="यह वह उच्च-स्टेक्स टेबल है जहाँ मुफ़्त हॉटकी उपलब्ध हैं!" />
    <add key="APP_LIMITATIONS_NEW_TABLE_GAINED_OVERLAY_RIGHTS" value="यह अब मुफ़्त ओवरले वाली टेबल है" />
    <add key="APP_LIMITATIONS_NEW_TABLE_GAINED_OVERLAY_RIGHTS_ACTION" value="सभी टेबल के लिए ओवरले अनलॉक करें" />
    <add key="APP_LIMITATIONS_TABLE_DOESNT_HAVE_OVERLAY_RIGHTS" value="इस टेबल पर ओवरले नहीं होंगे! उच्च स्टेक्स की केवल एक टेबल पर मिल सकते हैं!" />
    <add key="APP_LIMITATIONS_TABLE_DOESNT_HAVE_OVERLAY_RIGHTS_ACTION" value="सभी टेबल के लिए ओवरले अनलॉक करें" />
    <add key="ERROR_PLAYGROUND" value="यदि आप Playground mode चालू रखते हैं तो Winamax पर कोई भी फ़ंक्शन काम नहीं करेगा! कृपया इसे बंद करना सुनिश्चित करें" />
    <add key="WINAMAX_OLD" value="" />
    <add key="DEACTIVATE_TABLE_UNDER_MOUSE" value="यदि आप टेबल्स के बीच घुमने के लिए कंट्रोलर या कीबोर्ड का उपयोग करने जा रहे हैं, तो &quot;Focus Table Under Mouse&quot; को बंद करना सुनिश्चित करें&quot;" />
  </area>
