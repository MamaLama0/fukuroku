  <area id="119" name="Custom Controls">
    <add key="WORKS_FOR_SITES_CONTROL_Title" value="यह सुविधा केवल के लिए काम करती है" />
    <add key="ENABLE_FOR_SITES_CONTROL_Title" value="साइट्स को ऑन/ऑफ करने के लिए ड्रैग और ड्रॉप करें" />
    <add key="ENABLE_FOR_SITES_CONTROL_Popup_Body" value="विशिष्ट साइट्स के लिए यह सुविधा सक्षम करने के लिए क्लिक करें" />
    <add key="ACTIVATE_SLOT_FEATURE_TOOL_TIP_Title" value="उफ़! आपने अधिकतम सीमा तक पहुँच गए हैं" />
    <add key="ACTIVATE_SLOT_FEATURE_TOOL_TIP_Body" isFormatted="true" value="&lt;p style=&quot;font-weight: 700;&quot;&gt;आपने पहले ही सभी अनुमत slots का उपयोग कर लिया है।&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-weight: 600;&quot;&gt;सक्रिय करें&lt;/span&gt; &lt;span style=&quot;font-weight: 600;&quot;&gt;BUNDLE FULL TILLING&lt;/span&gt; ताकि आप &lt;span style=&quot;font-weight: 600;&quot;&gt;असीमित slots&lt;/span&gt; जोड़ सकें!&lt;/p&gt;" />
    <add key="LEARN_MORE_Text_Learn_More_About_This_Subject" value="इस विषय के बारे में अधिक जानने के लिए क्लिक करें!" />
    <add key="ENABLE_FOR_SITES_CONTROL_Button_Save" value="सेव करें" />
    <add key="WORKS_FOR_SITES_CONTROL_Button_Cancel" value="रद्द करें" />
    <add key="SITE_HEX_CONTROL_Label_Read_Review" value="समीक्षा पढ़ें" />
