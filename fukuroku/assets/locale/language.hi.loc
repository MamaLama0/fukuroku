<?xml version="1.0" encoding="utf-8"?>
<locale xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://jurojinpoker.com/locale">
  <area id="100" name="App Window">
    <add key="APP_WINDOW_NL_Popup_Signup_Title" value="साइन अप" />
    <add key="APP_WINDOW_NL_Popup_Signup_Subtitle" value="अपना फ्री ट्रायल शुरू करें!!" />
    <add key="APP_WINDOW_NL_" value="साइन अप" />
    <sub id="0" name="Error Messages">
      <add key="ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_NL_MESSAGE" value="हमने आपके डिस्प्ले कॉन्फ़िगरेशन में बदलाव का पता लगाया है और आपका वर्तमान सक्रिय layout में slots सीमा के बाहर हैं। क्या आप अभी Active Layout संपादित करना चाहते हैं?" />
      <add key="ON_APPLICATION_ERROR_Title" value="सर्वर त्रुटि" />
      <add key="ON_SERVER_FATAL_ERROR_MESSAGE" value="कनेक्शन खो गया। अपने इंटरनेट कनेक्शन की जांच करें।" />
      <add key="ON_ERROR" value="सर्वर त्रुटि" />
      <add key="ON_APPLICATION_MAINTENANCE_Title" value="सर्वर रखरखाव" />
      <add key="ON_APPLICATION_MAINTENANCE_Text" value="हमें अभी आपको Jurojin पुनः खोलने की आवश्यकता है, पुनः खोलने के बाद आप संभवतः एप में सामान्य उपयोगकर्ता के रूप में वापस आ जाएंगे!" />
      <add key="DLL_MISSING_ERROR_TITLE" value="फ़ाइलें गायब हैं" />
      <add key="DLL_MISSING_ERROR_MESSAGE" value="आपके पास कुछ आवश्यक फ़ाइलें गायब हैं जो एप्लिकेशन चलाने के लिए ज़रूरी हैं! यह आमतौर पर एंटीवायरस द्वारा हटाए जाने के कारण होता है! कृपया अपने एंटीवायरस या Windows Defender में Jurojin इंस्टॉलेशन फोल्डर को अप्रत्याशित के रूप में जोड़ें और फिर से ऐप का उपयोग करने का प्रयास करें। यदि इसके बाद भी यह त्रुटि संदेश आता रहे, तो कृपया हमारा नवीनतम इंस्टॉलर https://jurojinpoker.com/download?v=345789/ से डाउनलोड करें।" />
      <add key="INSTALLATION_INTEGRITY_ERROR_TITLE" value="इंस्टॉलेशन में बदलाव" />
      <add key="INSTALLATION_INTEGRITY_ERROR_MESSAGE" value="Jurojin ने आपकी इंस्टॉलेशन फ़ाइलों में अप्रत्याशित बदलाव पाया। आपकी सुरक्षा के लिए ऐप बंद हो जाएगा। कृपया https://jurojinpoker.com/download से पुनः इंस्टॉल करें।" />
      <add key="UNHANDLED_EX_ERROR_OUTOFMEMORY" value="आपके PC में प्रोग्राम चलाने के लिए RAM या GPU मेमोरी खत्म हो गई है। कुछ अनइस्तेमाल किए गए ऐप्स जैसे ब्राउज़र बंद करने पर विचार करें, या शायद अपने PC को अपग्रेड करें।" />
      <add key="GLOBALFEATURE_ERROR" value="आपकी Comfort Features में से एक को सक्रिय करने में त्रुटि हुई है, कृपया इस जानकारी के साथ सपोर्ट से संपर्क करें: #ex#" />
      <add key="PLAYINGSESSIONHANDLER_ERROR" value="आपके layout में टेबल्स की जानकारी सहेजने में समस्या आई है, कृपया इस जानकारी के साथ सपोर्ट से संपर्क करें: #ex#" />
      <add key="HOOKCONTROLLER_ERROR" value="आपके कंट्रोलर से कनेक्ट करने में समस्या आई है, कृपया इस जानकारी के साथ सपोर्ट से संपर्क करें: #ex#" />
      <add key="EMERGENCY_SHUTDOWN_CANNOT_CONNECT_TO_SERVERS_MESSAGE" value="" />
      <add key="KEEP_ALIVE_RECONNECT_ENTITLEMENTS_REVOKED_TOAST" value="आपका PC अभी हमारे सर्वर से कनेक्ट नहीं हो पा रहा। इंटरनेट कनेक्शन और फ़ायरवॉल/एंटीवायरस जाँचें" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Title" value="कनेक्शन समस्या" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Body" isFormatted="true" value="&lt;p&gt;आपकी सदस्यता अभी भी सक्रिय है, लेकिन Jurojin आपके PC से हमारे सर्वर तक नहीं पहुँच पा रहा। सुरक्षा के लिए सुविधाएँ अस्थायी रूप से बंद कर दी गई हैं।&lt;/p&gt;&lt;p&gt;अपना इंटरनेट कनेक्शन, फ़ायरवॉल और एंटीवायरस जाँचें, फिर Jurojin के स्वचालित रूप से फिर से कनेक्ट होने की प्रतीक्षा करें।&lt;/p&gt;" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Open_Guide" value="समस्या निवारण गाइड खोलें" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Got_It" value="समझ गया" />
    </sub>
