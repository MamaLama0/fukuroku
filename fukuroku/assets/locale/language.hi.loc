    <sub id="3" name="Dialog - Your Trial Ending Soon">
      <add key="DIALOG_YOUR_TRIAL_ENDING_SOON_Title" value="आपका ट्रायल जल्द ही समाप्त होने वाला है!" />
      <add key="DIALOG_YOUR_TRIAL_ENDING_SOON_Details" value="क्या आपने फैसला कर लिया है? यदि आप तैयार हैं, तो अब स्टोर पर जाएं और वे फीचर्स प्राप्त करें जिन्हें आप पसंद करते हैं" />
      <add key="DIALOG_YOUR_TRIAL_ENDING_SOON_Button_Reopen_Checkout_In_Browser" value="ब्राउज़र में चेकआउट फिर से खोलें" />
      <add key="DIALOG_YOUR_TRIAL_ENDING_SOON_Button_Reopen_Checkout_In_Browser_Description" value="यदि आपने गलती से चेकआउट पेज बंद कर दिया है" />
      <add key="DIALOG_YOUR_TRIAL_ENDING_SOON_Button_Finish_Purchase" value="खरीद पूरी करें" />
      <add key="DIALOG_YOUR_TRIAL_ENDING_SOON_Button_Finish_Purchase_Description" value="यदि आपको पहले ही भुगतान पुष्टि ईमेल मिल चुका है" />
      <add key="DIALOG_YOUR_TRIAL_ENDING_SOON_Button_Go_To_Discord" value="Discord पर जाएं" />
      <add key="DIALOG_YOUR_TRIAL_ENDING_SOON_Button_Go_To_Jurojin_Store" value="Jurojin Store पर जाएं" />
