      <add key="DIALOG_GET_ALL_POWER_OF_JUROJIN_Label_Visit_Our_Store_And_Get_Any_Bundles" value="हमारे Store पर जाएं और जो भी bundles चाहें प्राप्त करें। अपनी सबसे अच्छी योजना चुनें और कभी भी रद्द करें" />
      <add key="DIALOG_GET_ALL_POWER_OF_JUROJIN_Button_Visit_Jurojin_Store" value="Jurojin Store पर जाएं" />
      <add key="DIALOG_GET_ALL_POWER_OF_JUROJIN_Label_Ask_Juro_Bot_How_To_Use_Jurojin_For_Free" value="Juro Bot से पूछें कि microstakes पर Jurojin कैसे मुफ्त में उपयोग करें — सभी सुविधाएँ अनलॉक!" />
      <add key="DIALOG_GET_ALL_POWER_OF_JUROJIN_Button_Learn_More" value="और जानें" />
    </sub>
    <sub id="19" name="Dialog - Trial Alredy Used">
      <add key="DIALOG_TRIAL_ALREADY_USED_Title" value="Trial पहले ही उपयोग किया जा चुका है" />
      <add key="DIALOG_TRIAL_ALREADY_USED_Body" isFormatted="true" value="&lt;p&gt;उफ़, आपने अपना trial पहले ही किसी अन्य device/account पर उपयोग किया है, यदि आपको नया trial चाहिए, तो &lt;a href=&quot;mailto:support@jurojinpoker.com&quot;&gt;help@jurojinpoker.com&lt;/a&gt; पर ईमेल भेजें&lt;/p&gt;" />
    </sub>
    <sub id="20" name="Dialog - Store Network Fees">
      <add key="DIALOG_STORE_NETWORK_FEES_Title_This_Is_Your_Final_Amount" value="यह आपकी अंतिम राशि है। यदि यह ठीक लगता है, तो जारी रखें दबाएं।" />
      <add key="DIALOG_STORE_NETWORK_FEES_Label_Network_Fees" value="Network Fees:" />
      <add key="DIALOG_STORE_NETWORK_FEES_Label_We_Recommend_Purchasing_Annual_Bundles" value="Network Fees का अधिकतम लाभ उठाने के लिए हम वार्षिक bundles खरीदने की सलाह देते हैं, या हमारे विभिन्न non-crypto payment विकल्पों के साथ Verifone का उपयोग करें।" />
      <add key="DIALOG_STORE_NETWORK_FEES_Button_Continue" value="जारी रखें" />
      <add key="DIALOG_STORE_NETWORK_FEES_Button_Cancel" value="रद्द करें" />
    </sub>
    <sub id="21" name="Dialog - Store upgrade item warning">
      <add key="DIALOG_STORE_UPGRADE_CART_Warning_Title" value="" />
      <add key="DIALOG_STORE_UPGRADE_CART_Warning_Upgrade_Product_Will_Be_Removed" value="" />
      <add key="DIALOG_STORE_UPGRADE_CART_Warning_Other_Products_Will_Be_Removed" value="" />
