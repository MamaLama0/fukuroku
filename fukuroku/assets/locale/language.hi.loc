    <add key="FEATURE_LOCK_NL_Label_This_Feature_Is_Locked" value="यह फीचर लॉक है!" />
    <add key="FEATURE_LOCK_Label_Request_Access_In_Discord" value="इस बीटा फीचर के लिए हमारे Discord में एक्सेस का अनुरोध करें!" />
    <add key="FEATURE_LOCK_NL_Button_Unlock_Now" value="अब अनलॉक करें" />
    <add key="FEATURE_LOCK_NL_Button_Learn_More" value="और जानें" />
    <add key="FEATURE_LOCK_LABEL_NL_Label_Tiling_Sub_Not_Cover_Betting_Tools_Huds" value="Tiling Sub doesn't cover Betting Tools/Huds" />
  </area>
  <area id="115" name="Walkthrough">
    <sub id="0" name="Intro">
      <add key="WALK_INTRO_SKIP_OPTION_Label_Intro" value="Walkthrough बीच में रुका। क्या आप फिर से शुरू करना चाहते हैं?" />
      <add key="WALK_INTRO_SKIP_OPTION_Label_Button_Skip" value="छोड़ें" />
      <add key="WALK_INTRO_SKIP_OPTION_Label_Button_Continue" value="शुरू करें" />
    </sub>
    <sub id="1" name="Language Selection">
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Welcome" value="स्वागत है!" />
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Intro" value="अब हम आपको सबसे बुनियादी सेटिंग्स और उन्हें कैसे कॉन्फ़िगर करें, यह बताएंगे" />
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Choose_Language" value="अपनी भाषा चुनें" />
      <add key="WALK_INTRO_FINISH_Label_Button_LetsStart" value="चलिए शुरू करते हैं!" />
    </sub>
    <sub id="2" name="Finish">
      <add key="WALK_INTRO_FINISH_Label_Welcome" value="समाप्त" />
      <add key="WALK_INTRO_FINISH_Label_Line1" value="बहुत बढ़िया! अब आप Jurojin का उपयोग कर सकते हैं" />
      <add key="WALK_INTRO_FINISH_Label_Line2" value="खेलें और आनंद लें! टेबल्स पर शुभकामनाएँ!" />
      <add key="WALK_INTRO_FINISH_Label_Button_PlayNow" value="अभी खेलें" />
    </sub>
    <sub id="3" name="Layouts">
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Layout" value="चलो एक Layout कॉन्फ़िगर करके शुरू करते हैं। Layout कॉन्फ़िगरेशन मेनू आइटम पर क्लिक करें" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Create_New_Layout" value="Layout आपको Jurojin को यह बताने का तरीका है कि आप अपने टेबल्स कहाँ भेजना चाहते हैं। नया Layout बनाने के लिए यहां क्लिक करें" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Intro" value="यह विकल्प आपको मैन्युअल रूप से layout बनाने देता है" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Automatically" value="यदि आप layout जल्दी बनाना चाहते हैं, तो आप ऑटोमैटिक क्रिएशन फीचर का उपयोग कर सकते हैं" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_From_Preset" value="या आप हमारे layout टेम्पलेट्स में से कोई विकल्प चुन सकते हैं" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Clone_Existing" value="या आप मौजूदा layout को क्लोन कर सकते हैं। यह पहले से बने layout जैसा बनाना और समय बचाने में उपयोगी है।" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Action" value="अभी के लिए, आइए एक मैन्युअली बनाएं ताकि आप सभी विकल्प जान सकें" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Slot" value="यह बटन एक Playing Slot जोड़ता है। आपके टेबल्स डिफ़ॉल्ट रूप से यहां भेजे जाएंगे" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Observer_Slot" value="इसी तरह, आप एक Observer Slot जोड़ सकते हैं। आप इन slots का उपयोग उन टेबल्स को देखने के लिए कर सकते हैं जहाँ आप नहीं खेल रहे हैं" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Replay_Slot" value="Replay slots केवल हाथ की replay के लिए हैं (यह फीचर हर साइट पर समर्थित नहीं है)" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Lobby_Slot" value="Lobby विंडोज़ को भी Jurojin पहचान सकता है और उन्हें lobby slot में भेजा जा सकता है। ध्यान दें कि lobby विंडोज़ टेबल्स की तरह आकार में बदले नहीं जाते, इसलिए आप केवल उनकी जगह निर्धारित कर सकते हैं" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_CopyBottom" value="यह बटन दबाएं अब एक नया slot बनाने के लिए जिसका आकार मौजूदा slot के ठीक नीचे समान हो" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_DeleteSlot" value="यदि आपको कोई slot हटाना है, तो कूड़ेदान आइकन पर क्लिक करें। इस slot को हटाएं" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Slots_Create_Layout" value="अब जब आप slots जोड़ना जानते हैं, अपना layout बनाएं। खत्म करने पर, जारी रखने और layout सहेजने के लिए बटन पर क्लिक करें" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Save_Layout" value="सब कुछ हो गया! अब अपना layout सहेजें ताकि हम जारी रख सकें" />
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Back" value="अब चलिए वापस चलते हैं और कुछ और फीचर्स देखते हैं" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Tab_Header_Automatic_Layout_Switch" value="यहाँ आप Jurojin को layouts ऑटोमैटिक रूप से स्विच करने के लिए कॉन्फ़िगर कर सकते हैं" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Select_Automatic_Layout_Options" value="अब अपनी पसंद के अनुसार automatic layout switch कॉन्फ़िगर करें!" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Or_Observer_Slot" value="इन बटनों से आप अपने layout में playing या observer slots जोड़ सकते हैं, general settings की 'Keep Most Urgent on top' फीचर के साथ आप एक ही slot में टेबल्स को स्टैक कर सकते हैं और वे क्रम से दिखेंगे!" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Dynamic_Slots" value="इन दो बटनों से आप dynamic slots जोड़ सकते हैं, आप इन दो प्रकारों में से केवल एक ही अपने layout में जोड़ सकते हैं क्योंकि वे आपके टेबल्स के लिए अलग flow देते हैं" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Action_Required_Slots" value="action required slot के साथ, टेबल्स हर बार आपकी कार्रवाई की बारी पर इसमें भेजे जाएंगे" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_InHand_Slots" value="in hand slot के साथ, टेबल्स तब स्थानांतरित होंगे जब भी आप hand में एंटर करें, vpip करें, blind पोस्ट करें आदि। इसे हर साइट कॉन्फ़िग में सेट किया जा सकता है" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys_Tab" value="अब चलिए layout hotkeys टैब देखें.." />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys" value="अब चलिए layout hotkeys टैब देखें.." />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkey_Dynamic_Slots" value="इस hotkey से आप किसी टेबल को dynamic slots फ्लो से लॉक कर सकते हैं, ताकि वह जहाँ है वहीं रहे। यह तब बहुत उपयोगी है जब आप बड़ा हाथ या फाइनल टेबल खेल रहे हों" />
    </sub>
    <sub id="4" name="Sites Config">
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Sites" value="Sites Configuration पर जाने के लिए यहां क्लिक करें" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATIONS_Party_Poker_Hex" value="Pokerstars के लिए उपलब्ध कॉन्फ़िगरेशंस देखने के लिए क्लिक करें (यदि आप Stars में नहीं खेलते, चिंता न करें। आप बाद में अपनी साइट्स कॉन्फ़िगर कर पाएंगे)" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Toggle_Tiling_Status" value="इस बटन से आप tiling को सक्रिय/निष्क्रिय कर सकते हैं (केवल इस साइट के लिए)।" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Tiling_Options_Details" value="यहाँ आप एक विशेष पोकर साइट के लिए टेबल्स को स्वचालित रूप से कैसे move/tiling किया जाए, यह कॉन्फ़िगर कर पाएंगे।" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Check_Auto_Play_On_Launch" value="जब इसे चालू किया जाता है, Jurojin खोलने पर आपके सभी टेबल्स ऊपर सेटिंग के अनुसार स्थानांतरित होंगे। यह विकल्प Jurojin में PLAY दबाने का समय बचाता है ताकि यह टेबल्स का पता लगाना शुरू कर सके। हम इस फीचर का उपयोग करने की जोरदार सलाह देते हैं।" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Save_Settings" value="यदि आपके पास कुछ सहेजने के लिए है तो अभी करें! नहीं तो बस skip दबाएं" />
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Back" value="चलो फिर से वापस चलते हैं और कुछ और फीचर्स देखें" />
    </sub>
    <sub id="5" name="General Configuration">
      <add key="WALK_SCENARIO_GENCONFIG_HAMBURGER_MENU_ITEM_Configuration" value="यह बटन आपको General Configuration पर ले जाता है" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Playing_Area" value="Playing area को magnetize किया जा सकता है, इसका मतलब है कि आप टेबल्स को ड्रैग और ड्रॉप कर सकते हैं और वे तुरंत slots से चिपक जाएंगे। आप CTRL की दबाकर ड्रैग और ड्रॉप कर सकते हैं ताकि टेबल्स स्वैप न हों, बल्कि वे स्टैक हों।" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Observer_Area" value="Observer slots को भी magnetize किया जा सकता है" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tooltip_Magnetize_Playing_Area" value="यह आइकन आपको प्रत्येक फीचर का एक छोटा सा विवरण देगा" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Lobby_Slots" value="जैसे कि lobby slots भी। जब तक lobby slots में stack sites विकल्प दोनों हो" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Observer_Area_Table_Closed" value="जब किसी टेबल को बंद किया जाता है तब आप observer slots में टेबल्स को पुनः क्रमबद्ध कर सकते हैं" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Playing_Area_Table_Closed" value="जब किसी टेबल को बंद किया जाता है तब आप playing slots में टेबल्स को पुनः क्रमबद्ध कर सकते हैं" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Focus_Table_Under_Mouse" value="यह फीचर टेबल को सामने लाता है जब आप माउस को उसके ऊपर ले जाते हैं" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Highlight_Table_Under_Focus" value="यह फोकस किए गए टेबल के बॉर्डर को हाइलाइट करेगा।" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Show_Random_Number_Generator" value="यह ऐप के शुरू में random number generator दिखाएगा। यदि आप यह फीचर चालू रखते हैं, तो RNG इस गाइड के खत्म होने पर तुरंत दिखाई देगा!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Minimize_To_System_Tray" value="जब आप minimize बटन दबाएंगे, तो ऐप केवल system tray में दिखाई देगा (Windows के नीचे दाएँ छोटे आइकन)" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Keep_Most_Urgent_On_Top" value="जब एक ही slot में एक से अधिक टेबल स्टैक हों, तो Jurojin सबसे जरूरी को ऊपर रखेगा। जब आप कार्रवाई करते हैं, तो अगला सबसे जरूरी ऊपर आएगा।" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_WorksFor_Keep_Most_Urgent_On_Top" value="कुछ फीचर्स सभी साइट्स के लिए काम नहीं करते! इस आइकन से आप जांच सकते हैं कौन सा सपोर्ट करता है!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Global" value="आप इन विकल्पों को ऑन या ऑफ कर सकते हैं ताकि Jurojin आदर्श हो सके!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Global_Hotkeys" value="ये Jurojin में उपलब्ध सामान्य हॉटकीज़ हैं" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Set_HotKeys" value="आप फील्ड को सेलेक्ट करके और कीबोर्ड शॉर्टकट दबाकर हॉटकी सेट कर सकते हैं" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Table_Border" value="यहाँ आप अपने टेबल्स के लिए रंगीन बॉर्डर्स कंफिगर कर सकते हैं! कुछ सेक्शन्स में ऐसे टैब होते हैं, चेक करना न भूलें!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Table_Border" value="आप इस विकल्प को ऑन कर सकते हैं ताकि फोकस्ड टेबल पर वायलेट बॉर्डर दिखे" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Save_Changes" value="अपनी सेटिंग्स सेव करें या सीधे Skip Saving दबाएं" />
    </sub>
    <sub id="6" name="HotKeys Config">
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_HAMBURGER_MENU_ITEM_HotKeys" value="यहाँ आप टेबल्स पर चेक/फोल्ड/बेट/रेज जैसे एक्शन के लिए हॉटकीज़ डिफाइन कर पाएंगे!" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Intro" value="अपने बेटसाइज़ और एक्शंस के लिए माउस या कीबोर्ड से कीबाइंडिंग सेट करें! कुछ साइट्स जैसे GGPoker में आपको एक्स्ट्रा कॉन्फिग करनी पड़ती है, अधिक जानकारी के लिए हमारा FAQ देखें!" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Discord_Intro" value="ऐसा लगता है आपके पास इस फीचर का एक्सेस नहीं है! इस बटन पर क्लिक करके आप एक्सेस का अनुरोध कर सकते हैं, अपनी Jurojin यूजरनेम चैट में छोड़कर" />
    </sub>
    <sub id="7" name="Controller Config">
      <add key="WALK_SCENARIO_CONTROLLER_HAMBURGER_MENU_ITEM_Controller" value="हमने कुछ पोकर साइट्स के लिए कंट्रोलर सपोर्ट भी जोड़ा है!" />
      <add key="WALK_SCENARIO_CONTROLLER_Page_Intro" value="कुछ बीयर लें, सोफ़े पर बैठें और हमारे नए कंट्रोलर सपोर्ट के साथ स्पिन्स का आनंद लें!" />
    </sub>
    <sub id="8" name="Overlays Config">
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_HAMBURGER_MENU_ITEM_Overlays" value="इस व्यू में आप अपने टेबल्स पर दिखने वाले overlays कंफिगर कर सकते हैं!" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Page_Intro" value="जो भी आइटम हर टेबल पर दिखता है वो इस व्यू में होता है, यहाँ आप उन्हें ऑन या ऑफ कर सकते हैं और कुछ पहलुओं को कंफिगर भी कर सकते हैं!" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Table_Overlays_Contents" value="यहाँ आप अपने टेबल्स के अंदर दिखने वाले overlays कंफिगर कर सकते हैं। ये overlays गेम में उपयोगी विभिन्न स्टैट्स दिखाएंगे। प्रत्येक overlay के पास 'Learn More' पर क्लिक करें, इन्हें समझने के लिए गाइड्स देखने को मिलेंगे" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Tab_Seats_Overlays_Intro" value="चलिए सीट overlays सेक्शन पर चलते हैं" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Seats_Overlays_Contents" value="सीट overlays हमेशा प्लेयर सीट के बगल में रहते हैं और पोजीशन व एक्शन लाइन जैसी बातें दिखाते हैं, सुनिश्चित करें कि साइट्स कंफिग में हीरो सेंटर में हो" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Tab_Table_Counters_Intro" value="अब चलिए काउंटर overlays चेक करते हैं" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Table_Counters_Contents" value="काउंटर overlays उस स्लॉट में टेबल से संबंधित जानकारी दिखाएंगे जहाँ टेबल स्थित है (यदि कोई हो)" />
    </sub>
    <sub id="9" name="Changelog">
      <add key="WALK_SCENARIO_CHANGELOG_HAMBURGER_MENU_ITEM_Changelog" value="इस सेक्शन में आप ऐप की नवीनतम खबरें पढ़ पाएंगे! जब नई चीज़ें होंगी तो यह लाल हो जाएगा!" />
      <add key="WALK_SCENARIO_CHANGELOG_Page_Intro" value="यहाँ नवीनतम खबरों के बारे में जानें!" />
    </sub>
    <sub id="10" name="Outro">
      <add key="WALK_SCENARIO_GENOUTRO_REPORT_ISSUE" value="यदि आपको कोई समस्या हो तो रिपोर्ट बटन का उपयोग करें ताकि हम आपकी मदद कर सकें, या हमारा डिस्कॉर्ड चैनल जॉइन करें!" />
      <add key="WALK_SCENARIO_GENOUTRO_WALKTHROUGH_ON_DEMAND" value="इस गाइड को आप किसी भी समय इस बटन को दबाकर फिर से देख सकते हैं।" />
    </sub>
    <sub id="11" name="Others">
      <add key="WALK_Common_Label_User_Action_Complete" value="सब पूरा!" />
      <add key="WALK_Common_Label_User_Intro_Acknowledge" value="समझ गया" />
      <add key="WALK_Common_Skip_Saving" value="सेविंग छोड़ें" />
      <add key="WALK_Button_See_Walkthrough_Again" value="गाइड फिर से देखें" />
      <add key="WALK_Button_Guide" value="गाइड" />
      <add key="WALK_Button_Skip_To_End" value="मैं इस गाइड को बाद में पूरा करूंगा" />
    </sub>
  </area>
  <area id="116" name="Walkthrough V2">
    <sub id="0" name="Intro">
      <add key="WALKV2_INTRO_Title_Welcome_To_Jurojin_Poker" value="Jurojin Poker में आपका स्वागत है!" />
      <add key="WALKV2_INTRO_Label_Choose_Your_Language_To_Begin" value="शुरू करने के लिए अपनी भाषा चुनें" />
      <add key="WALKV2_INTRO_Button_Lets_Start" value="चलो शुरू करें" />
    </sub>
    <sub id="1" name="Mini Intro">
      <add key="WALKV2_MINI_INTRO_Title_Lets_Learn_The_Basics" value="आइए बेसिक्स सीखते हैं..." />
      <add key="WALKV2_MINI_INTRO_Description_I_Will_Be_Guiding_You_Through_The_App" value="मैं आपको ऐप के माध्यम से मार्गदर्शन दूंगा ताकि आप हमारे सबसे महत्वपूर्ण फीचर्स के बारे में सीख सकें! Jurojin में आपको तीन मुख्य कार्यक्षमताएँ मिलेंगी। आप इनमें से किसी पर भी क्लिक करके सीख सकते हैं।" />
      <add key="WALKV2_MINI_INTRO_Button_Tiling" value="Tiling" />
      <add key="WALKV2_MINI_INTRO_Button_Hotkeys" value="Hotkeys" />
      <add key="WALKV2_MINI_INTRO_Button_Overlays" value="Overlays" />
      <add key="WALKV2_MINI_INTRO_Button_I_Will_Go_Through_Jurojin_Myself" value="मैं खुद Jurojin के जरिए जाऊँगा" />
    </sub>
    <sub id="2" name="Mini Finish">
      <add key="WALKV2_MINI_FINISH_Title_Well_Done" value="बहुत बढ़िया!" />
      <add key="WALKV2_MINI_FINISH_Description_Great_You_Finished_One_Of_Our_Miniguides" value="बहुत बढ़िया! आपने हमारे मिनीगाइड्स में से एक पूरा कर लिया है! यदि आप कोई अन्य देखना चाहते हैं या इसे दोहराना चाहते हैं तो आप अभी कर सकते हैं!" />
      <add key="WALKV2_MINI_FINISH_Button_Tiling" value="Tiling" />
      <add key="WALKV2_MINI_FINISH_Button_Hotkeys" value="Hotkeys" />
      <add key="WALKV2_MINI_FINISH_Button_Overlays" value="Overlays" />
      <add key="WALKV2_MINI_FINISH_Button_I_Will_Go_Through_Jurojin_Myself" value="मैं खुद Jurojin के जरिए जाऊँगा" />
    </sub>
  </area>
