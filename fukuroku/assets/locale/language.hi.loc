      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Advanced_Configuration" value="उन्नत कॉन्फ़िगरेशन" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Close_Or_Accept_All_Popups_With_A_Single_Option" value="सभी पॉपअप्स को एक विकल्प से बंद या स्वीकार करें" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_Jurojin_Will_Close_Any_Popup_That_Appears_Which_Only_Has_One_Option_To_Take" value="Jurojin किसी भी पॉपअप को बंद कर देगा जिसमें केवल एक विकल्प हो। ध्यान दें कि कोई पॉपअप फ़िल्टर नहीं होगा और Jurojin को पता नहीं होगा कि क्या दबाया जाएगा। इसे सावधानी से उपयोग करें।" />
      <add key="SITE_CONFIGURATION_DETAILS_NL_Label_My_Popups" value="मेरे पॉपअप्स" />
