      <add key="DIALOG_ACTIVATE_LAYOUT_PAYWALL_NL_Title" value="Free Mode - 1 Layout" />
      <add key="DIALOG_ACTIVATE_LAYOUT_PAYWALL_NL_Body" value="Free Mode कई Layout सक्रिय करने को कवर नहीं करता। आप अपना वर्तमान Active Layout संपादित कर सकते हैं। अनलॉक करने के लिए सक्रिय करें!" />
