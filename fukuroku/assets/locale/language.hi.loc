      <add key="FILL_CART_NL_Label_We_Noticed_Your_Selection_More_Expensive_Do_You_Want_Only_Full_Access" value="हमने देखा कि आपका चयन हमारे फुल एक्सेस बंडल से महंगा है, जिसमें कम कीमत में सभी फीचर्स हैं। क्या आप अपना कार्ट केवल फुल एक्सेस बंडल पर बदलना चाहते हैं?" />
      <add key="FILL_CART_NL_Label_Remaining_Months" value="बचे हुए महीने" />
