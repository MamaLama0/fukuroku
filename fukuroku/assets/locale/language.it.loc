  <area id="123" name="Feature Showcase">
    <sub id="0" name="Highlight Callouts">
      <add key="FEATURE_SHOWCASE_NL_Body_Action_History_Settings" value="Scopri i nuovi eleganti Temi. Allerta spoiler: &quot;Minimal&quot; sarà il tuo prossimo preferito!" />
      <add key="FEATURE_SHOWCASE_NL_Body_Keep_Most_Urgent_On_Top" value="Attiva &quot;Gestisci urgenza dello stack&quot; così Jurojin tiene in primo piano il tavolo più urgente quando impili più tavoli nello stesso slot. Disattiva anche l'opzione nativa di focus/urgenza dei tavoli della tua room, così non entra in conflitto con Jurojin." />
      <add key="FEATURE_SHOWCASE_NL_Body_Auto_Focus_Most_Urgent" value="Attiva &quot;Auto-focus sempre sul tavolo più urgente&quot; e Jurojin terrà sempre in primo piano il tavolo più urgente, anche quando i tuoi tavoli si sovrappongono. Disattiva anche l'opzione nativa di focus/urgenza dei tavoli della tua room, così non entra in conflitto con Jurojin." />
      <add key="FEATURE_SHOWCASE_TOAST_Configuration_Suggestion" value="Jurojin ha un suggerimento di configurazione per te!" />
    </sub>
  </area>
