    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency_Tooltip_Title" value="FREQUENZA MINIMA DI DIFESA" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency_Tooltip_Body" value="Questa overlay mostra la % minima di mani con cui dovresti chiamare una specifica dimensione di puntata del tuo avversario per non essere sfruttabile da loro" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity" value="BLUFF EQUITY" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity_Tooltip_Title" value="BLUFF EQUITY" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity_Tooltip_Body" value="Rappresenta, data una dimensione di puntata (lettura dal tuo betbox prima di fare qualsiasi puntata), quanto spesso il tuo avversario dovrebbe foldare basandosi sulla tua conoscenza del suo stile di gioco, in una situazione data per rendere la puntata redditizia per te, particolarmente utile quando fai bluff" />
