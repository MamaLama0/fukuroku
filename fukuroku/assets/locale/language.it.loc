      <add key="CREATE_NEW_LAYOUT_AUTOMATICALLY_NL_Label_Slot_Sizes_And_Maximum_Slots_Segment_4" value="Se vuoi cambiare la dimensione dello slot o dello schermo, per favore torna indietro." />
