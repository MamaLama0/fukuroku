      <add key="AUTOBET_PREFLOP_Add_BBs_Limper_Help_Title" value="Per Limper" />
      <add key="AUTOBET_PREFLOP_Add_BBs_Limper_Help_Body" value="Limper indica ogni giocatore che ha appena pagato la BB per vedere il flop, tutto ciò che supera questo importo è considerato call, non limp. Per ogni limper, l'importo totale sarà moltiplicato per il valore in questa casella" />
      <add key="AUTOBET_PREFLOP_Add_X_Times_Cold_Caller_Help_Title" value="Per Cold Caller" />
      <add key="AUTOBET_PREFLOP_Add_X_Times_Cold_Caller_Help_Body" value="Un cold call è una chiamata dopo due o più rilanci, o una puntata seguita da un rilancio. Per ogni cold caller, l'importo totale sarà moltiplicato per il valore in questa casella" />
      <add key="AUTOBET_PREFLOP_Label_Multiply_X_Times_Open_Raise" value="Moltiplica X volte il raise iniziale" />
      <add key="AUTOBET_PREFLOP_Label_Multiply_X_Times_3Bet" value="Moltiplica X volte il 3bet quando l'hero è in posizione" />
