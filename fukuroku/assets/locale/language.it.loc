      <add key="LAYOUT_CONFIGURATION_NL_Label_Go_Back_To_Previous_Layout_If_Table_Decrease" value="Torna al layout precedente se i tavoli diminuiscono" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Ask_Before_Switching_Layout_Automatically" value="Chiedi prima di cambiare layout automaticamente" />
      <add key="LAYOUT_CONFIGURATION_NL_Info_Automatically_Switch_From_An_Initial_Layout" value="Usando Jurojin ci sarà sempre un layout attivo, tuttavia ti offriamo la possibilità di passare automaticamente da un layout iniziale." />
      <add key="LAYOUT_CONFIGURATION_NL_Button_Save_Changes" value="Salva Modifiche" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_LAYOUT_SWITCH_Title" value="CAMBIA LAYOUT" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_LAYOUT_SWITCH_Message" value="VUOI PASSARE AUTOMATICAMENTE AL LAYOUT " />
      <add key="LAYOUT_CONFIGURATION_NL_Help_Layout_Switch_Title" value="Cambio Automatico Layout" />
      <add key="LAYOUT_CONFIGURATION_NL_Help_Layout_Switch_Body" value="Questa funzione cambierà automaticamente il layout attivo basandosi sul numero di tavoli aperti. Clicca l'icona della matita sotto il primo cambio layout per iniziare." />
      <add key="LAYOUT_CONFIGURATION_NL_ON_TABLES_LAYOUT_CONFIGURATION_Auto_Swap_Caption" value="CAMBIO AUTOMATICO DEL LAYOUT" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_TABLES_LAYOUT_CONFIGURATION_Auto_Swap_Message" value="Attivare manualmente un layout disabiliterebbe il Cambio Automatico Layout. Sei sicuro di disattivare questa funzione e attivare questo layout?" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_Title" value="ATTENZIONE!" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_Message" value="Abbiamo rilevato una modifica nella configurazione dei tuoi display e il tuo active layout ha degli slots fuori dai limiti. Vuoi modificare ora l'Active Layout?" />
      <add key="LAYOUT_CONFIGURATION_NL_Tab_Header_Layout_Hotkeys" value="Hotkey Layout" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Playing_Slot" value="Playing Slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Send_Table_To_Playing_Slot" value="Invia tavolo ad uno playing slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Observer_Slot" value="Observer Slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Send_Table_To_Observer_Slot" value="Invia tavolo ad un observer slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Playing_Slot_No" value="Playing Slot #" />
      <add key="LAYOUT_CONFIGURATION_NL_Hotkeys_Label_Observer_Slot_No" value="Observer Slot #" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Lock_Table_Of_Dynamic_Flow" value="Blocca tavolo fuori dal flusso dinamico" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Move_Table_To_Next_Slot" value="Sposta tavolo allo slot successivo" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Move_Table_To_Previous_Slot" value="Sposta tavolo allo slot precedente" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Help_Title_Lock_Table" value="Blocca/Reinserisci tavolo" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Help_Body_Lock_Table" value="Usa questo tasto rapido per escludere o reinserire un tavolo nel flusso dinamico degli slots (AR/In Hand). In pratica, il tavolo resterà nello slot in cui si trova. Puoi premere di nuovo il tasto rapido su questo tavolo per tornare al flusso dinamico." />
    </sub>
