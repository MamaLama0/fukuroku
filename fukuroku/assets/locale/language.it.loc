    <add key="OVERLAY_SETTINGS_PAGE_NL_Hand_Counter_Tooltip_Body" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Save_Location_Title" value="Salva Posizione" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Save_Location_Body" value="Assicurati di essere nella schermata principale di Jurojin e poi sistema le tue overlays dove vuoi cliccando sull'area tratteggiata. Poi premi il tasto rapido sopra quel tavolo" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Outs" value="MINIMUM OUTS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Minimum_Outs_Tooltip_Title" value="MINIMUM OUTS" />
