      <add key="HOTKEYS_NL_Banner_When_Using_Betsize_Overlay_You_Can_Use_Ctrl_Key" value="Quando usi l'overlay delle dimensioni di puntata, puoi usare il tasto CTRL per scegliere tra 3e e 2e" />
      <add key="HOTKEYS_NL_Tooltip_Geometric_Betsizing_Title" value="DIMENSIONI DI PUNTATA GEOMETRICHE" />
      <add key="HOTKEYS_NL_Tooltip_Geometric_Betsizing_Body" value="Con questa funzione puoi modificare un pulsante di dimensione puntata per comportarsi come una puntata geometrica. Le dimensioni di puntata geometriche ti permettono di fare una puntata su flop/turn in modo che puntando la stessa % sulla street successiva arriveresti a un all-in al River" />
    </sub>
