    <sub id="15" name="Dialog - Store Binance Warning">
      <add key="DIALOG_STORE_BINANCE_WARNING_Title" value="Quasi fatto..." />
      <add key="DIALOG_STORE_BINANCE_WARNING_Body" isFormatted="true" value="&lt;p&gt;Se vuoi ritirare da &lt;span style=&quot;font-weight: 700;&quot;&gt;Binance&lt;/span&gt;, devi &lt;span style=&quot;font-weight: 700;&quot;&gt;aggiungere 1 USDT extra al tuo prelievo&lt;/span&gt;, se usi altre piattaforme, controlla le loro tariffe di prelievo prima di inviare gli USDT a noi per evitare pagamenti parziali.&lt;/p&gt;" />
      <add key="DIALOG_STORE_BINANCE_WARNING_Button_Continue" value="Continua" />
      <add key="DIALOG_STORE_BINANCE_WARNING_Button_Cancel" value="Annulla" />
      <add key="DIALOG_STORE_BINANCE_WARNING_Btc_Body" value="Quando ritiri direttamente dagli exchange, viene applicata una tariffa per il prelievo dei fondi. Assicurati di inviare l'importo corretto all'indirizzo! Su Binance devi premere questo pulsante per assicurarti che l'importo del prelievo sia corretto, altrimenti riceveremo fondi insufficienti e i tuoi prodotti non verranno attivati." />
    </sub>
