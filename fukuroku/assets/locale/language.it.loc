  <area id="100" name="App Window">
    <add key="APP_WINDOW_NL_Popup_Signup_Title" value="ISCRIVITI" />
    <add key="APP_WINDOW_NL_Popup_Signup_Subtitle" value="PER INIZIARE LA TUA PROVA GRATUITA!!" />
    <add key="APP_WINDOW_NL_" value="ISCRIVITI" />
    <sub id="0" name="Error Messages">
      <add key="ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_NL_MESSAGE" value="Abbiamo rilevato una modifica nella configurazione dei tuoi display e il tuo active layout ha degli slots fuori dai limiti. Vuoi modificare ora l'Active Layout?" />
      <add key="ON_APPLICATION_ERROR_Title" value="Errore del Server" />
      <add key="ON_SERVER_FATAL_ERROR_MESSAGE" value="Connessione persa. Controlla la tua connessione internet." />
      <add key="ON_ERROR" value="Errore del Server" />
      <add key="ON_APPLICATION_MAINTENANCE_Title" value="Manutenzione del Server" />
      <add key="ON_APPLICATION_MAINTENANCE_Text" value="Abbiamo bisogno che riapri Jurojin immediatamente, molto probabilmente tornerai al tuo utente normale nell'app dopo il riavvio!" />
      <add key="DLL_MISSING_ERROR_TITLE" value="File Mancanti" />
      <add key="DLL_MISSING_ERROR_MESSAGE" value="Mancano file necessari per eseguire l'app! Di solito è l'antivirus che li cancella! Aggiungi una eccezione alla cartella di installazione di Jurojin sul tuo antivirus o Windows Defender e poi prova a usare di nuovo l'app. Se continui a vedere questo messaggio d'errore, scarica il nostro ultimo installer da https://jurojinpoker.com/download?v=345789/" />
      <add key="INSTALLATION_INTEGRITY_ERROR_TITLE" value="Installazione modificata" />
      <add key="INSTALLATION_INTEGRITY_ERROR_MESSAGE" value="Jurojin ha rilevato una modifica imprevista ai file di installazione. Per la tua sicurezza l'app verrà chiusa. Reinstalla da https://jurojinpoker.com/download" />
      <add key="UNHANDLED_EX_ERROR_OUTOFMEMORY" value="Il tuo PC ha esaurito la RAM o la memoria GPU per eseguire il programma. Considera di chiudere alcune app inutilizzate come il browser, o magari di aggiornare il PC." />
      <add key="GLOBALFEATURE_ERROR" value="Si è verificato un errore durante l'attivazione di una delle tue Comfort Features, contatta il supporto con queste informazioni: #ex#" />
      <add key="PLAYINGSESSIONHANDLER_ERROR" value="Si è verificato un problema salvando le informazioni dei tavoli nel tuo layout, contatta il supporto con queste informazioni: #ex#" />
      <add key="HOOKCONTROLLER_ERROR" value="Si è verificato un problema nella connessione con il controller, contatta il supporto con queste informazioni: #ex#" />
      <add key="EMERGENCY_SHUTDOWN_CANNOT_CONNECT_TO_SERVERS_MESSAGE" value="" />
      <add key="KEEP_ALIVE_RECONNECT_ENTITLEMENTS_REVOKED_TOAST" value="Il tuo PC non riesce a connettersi ai nostri server. Controlla la connessione internet e il firewall/antivirus" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Title" value="Problema di connessione" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Body" isFormatted="true" value="&lt;p&gt;Il tuo abbonamento è ancora attivo, ma Jurojin non riesce a raggiungere i nostri server dal tuo PC. Le funzionalità sono state temporaneamente disabilitate per sicurezza.&lt;/p&gt;&lt;p&gt;Controlla connessione internet, firewall e antivirus, poi attendi che Jurojin si riconnetta automaticamente.&lt;/p&gt;" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Open_Guide" value="Apri la guida alla risoluzione" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Got_It" value="Capito" />
    </sub>
