    <sub id="2" name="Page - Edit Layout">
      <add key="EDIT_LAYOUT_NL_Title_Edit_Layout" value="Modifica Layout" />
      <add key="EDIT_LAYOUT_NL_Label_Layout_Name" value="Nome Layout" />
      <add key="EDIT_LAYOUT_NL_Label_Hotkey_To_Switch_Layout_During_Session" value="Tasto rapido per cambiare layout durante la sessione" />
