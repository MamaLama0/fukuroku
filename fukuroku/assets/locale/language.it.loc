    <add key="SETTINGS_NL_Tooltip_Title_Send_Table_To_Playing_Area" value="INVIA TAVOLI AI PLAYING SLOTS" />
    <add key="SETTINGS_NL_Tooltip_Body_Send_Table_To_Playing_Area" value="Quando passi con il mouse sopra un tavolo e premi questo hotkey, verrà spostato al prossimo playing slot disponibile. Funziona anche per siti non supportati ed emulatori! Non dimenticare di segnalare i siti non supportati nei nostri forum!" />
    <add key="SETTINGS_NL_Label_Send_Table_To_Observer_Area" value="Invia Tavolo all'Area Osservatore" />
    <add key="SETTINGS_NL_Move_Tables_Clicking_Anywhere" value="Sposta i tavoli cliccando in qualsiasi punto dell'area client" />
    <add key="SETTINGS_NL_Tooltip_Title_Move_Tables_Clicking_Anywhere" value="Sposta i Tavoli Cliccando Ovunque" />
    <add key="SETTINGS_NL_Tooltip_Body_Move_Tables_Clicking_Anywhere" value="Questa funzione ti permette di trascinare un tavolo senza dover cliccare fastidiosamente sulla barra del titolo della finestra. Assicurati di cliccare il tavolo e non un suo elemento figlio come uno degli HUD. Il 20% inferiore dell'area del tavolo non funzionerà, abbiamo fatto così per evitare problemi con gli slider delle puntate integrati nei siti di poker" />
    <add key="SETTINGS_NL_Hide_Title_Bar_Of_Tables" value="Nascondi la barra del titolo dei tavoli" />
    <add key="SETTINGS_NL_Tooltip_Title_Send_Table_To_Observer_Area" value="INVIA TAVOLI A OBSERVE SLOTS" />
    <add key="SETTINGS_NL_Tooltip_Body_Send_Table_To_Observer_Area" value="Quando passi con il mouse sopra un tavolo e premi questo hotkey, verrà spostato al prossimo observe slot disponibile. Funziona anche per siti non supportati ed emulatori! Non dimenticare di segnalare i siti non supportati nei nostri forum!" />
