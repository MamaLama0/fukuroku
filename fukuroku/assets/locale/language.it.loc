    <add key="OVERLAY_SETTINGS_PAGE_NL_Pot_Odds_Tooltip_Body" value="Con questo overlay potrai conoscere il rapporto rischio vs. ricompensa. Può essere espresso come rapporto matematico reward:risk o come percentuale." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Stack_To_Pot_Ratio" value="SPR" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Tooltip_Title" value="SPR" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Tooltip_Body" value="Con questo overlay potrai conoscere il rapporto tra lo stack effettivo (lo stack del giocatore con meno chips) e la dimensione del piatto." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Effective_Stack" value="STACK EFFETTIVO" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_EFFS_Tooltip_Title" value="STACK EFF." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_EFFS_Tooltip_Body" value="Con questo overlay puoi vedere quante chips ha il giocatore con meno chips nella mano" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bet_Buttons" value="PULSANTI SCOMMESSE" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Bet_Buttons_Tooltip_Title" value="PULSANTI SCOMMESSE" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Bet_Buttons_Tooltip_Body" value="Questo overlay mostrerà i valori delle scommesse che hai configurato per i tuoi hotkeys sulla pagina Hotkeys/Betsizes! Se premi CTRL sull'overlay vedrai le altre otto dimensioni di scommessa" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Action_History" value="STORIA AZIONI" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Action_History_Tooltip_Title" value="OVERLAY STORIA AZIONI" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Action_History_Tooltip_Body" value="Questo overlay ti aiuterà a notare le intenzioni che gli avversari cercano di mostrarti durante il gioco, vedrai ogni azione che compiono durante una mano" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Position" value="POSIZIONI" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Positions_Tooltip_Title" value="OVERLAY POSIZIONI" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Positions_Tooltip_Body" value="Con questo overlay potrai vedere la posizione di ogni giocatore al tavolo" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_AR_Tables_Counter" value="CONTATORE TAVOLI CON AZIONE" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Hand_Tables_Counter" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_ST_Tables_Counter" value="CONTATORE TAVOLI IMPIILATI" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_TOASTER_Check_Guide" value="Si aprirà una guida nel tuo browser per overlay basati sui sedili così da configurare tutto correttamente. Assicurati che il centraggio dei sedili sia ok su tutti i siti prima di testare la funzionalità!" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_SPR_Next_Street" value="SPR N.S." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_POT_Next_Street" value="POT N.S." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Next_Street_Tooltip_Title" value="Overlay SPR prossima street" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Next_Street_Tooltip_Body" value="Questo overlay leggerà il valore della tua scommessa, presumendo che il tuo avversario chiamerà, quindi calcolerà quale sarà lo SPR alla prossima street" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ON_DISABLE_Actions_Title" value="Disabilita overlay" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ON_DISABLE_Actions_Message" value="Sei sicuro? Potresti non riuscire a segnalare problemi di tavolo o mano se questo overlay è disabilitato." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_AR_Counter_Tooltip_Title" value="Contatore tavoli in attesa di azione" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_AR_Counter_Tooltip_Body" value="Questa overlay ti dirà quante tavoli richiedono azione in quel preciso momento su quello specifico slot. Il suo pulsante di ciclo scorrerà solo tra i tavoli che necessitano di azione" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ST_Counter_Tooltip_Title" value="Contatore Tavoli Sovrapposti" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ST_Counter_Tooltip_Body" value="Usa questa overlay per sapere quanti tavoli sono in uno specifico slot" />
