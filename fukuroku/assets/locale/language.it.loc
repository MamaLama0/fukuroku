      <add key="WALK_INTRO_FINISH_Label_Line1" value="Ottimo! Ora puoi usare Jurojin" />
      <add key="WALK_INTRO_FINISH_Label_Line2" value="Gioca e divertiti! Buona fortuna ai tavoli!" />
      <add key="WALK_INTRO_FINISH_Label_Button_PlayNow" value="GIOCA ORA" />
    </sub>
    <sub id="3" name="Layouts">
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Layout" value="Iniziamo configurando un Layout. Clicca sulla voce del menu di configurazione Layout" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Create_New_Layout" value="Il layout è il modo per dire a Jurojin dove vuoi che vengano inviati i tuoi tavoli. Clicca qui per creare un nuovo Layout" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Intro" value="Questa opzione ti permette di creare un layout manualmente" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Automatically" value="Se vuoi creare il layout rapidamente, puoi usare la funzione di creazione automatica" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_From_Preset" value="Oppure puoi scegliere un'opzione dai nostri template di layout" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Clone_Existing" value="Oppure puoi clonare un layout esistente. Utile per creare un layout simile a uno già creato e risparmiare tempo." />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Action" value="Per ora facciamone uno manualmente così conosci tutte le opzioni" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Slot" value="Questo pulsante aggiunge un Playing Slot. I tuoi tavoli saranno inviati qui di default" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Observer_Slot" value="Allo stesso modo, puoi aggiungere un Observer Slot. Puoi usare questi slot per osservare tavoli dove non stai giocando" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Replay_Slot" value="I Replay slot sono solo per le repliche delle mani (non tutti i siti supportano questa funzione)" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Lobby_Slot" value="Le finestre della lobby possono essere riconosciute da Jurojin e assegnate a un Lobby Slot. Nota che le finestre della lobby non vengono ridimensionate come i tavoli, quindi puoi solo definire la loro posizione" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_CopyBottom" value="Premi questo pulsante ora per creare un nuovo slot della stessa dimensione di quello attuale esattamente sotto di esso" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_DeleteSlot" value="Se hai bisogno di eliminare uno slot, premi semplicemente sull'icona del cestino. Elimina questo slot" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Slots_Create_Layout" value="Ora che sai come aggiungere slot, crea il tuo layout. Una volta finito, clicca sul pulsante per continuare e salvare il layout" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Save_Layout" value="Tutto fatto! Ora salva il tuo layout così possiamo continuare" />
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Back" value="Ora torniamo indietro per vedere altre funzionalità" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Tab_Header_Automatic_Layout_Switch" value="Qui puoi configurare Jurojin per cambiare i layouts automaticamente" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Select_Automatic_Layout_Options" value="Configura ora il cambio automatico di layout come desideri!" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Or_Observer_Slot" value="Con questi pulsanti puoi aggiungere playing o observer slots al tuo layout, con la funzione Keep Most Urgent on top dalle impostazioni generali puoi impilare i tavoli nello stesso slot e appariranno in ordine!" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Dynamic_Slots" value="Con questi due pulsanti puoi aggiungere dynamic slots, puoi scegliere solo uno di questi due tipi da aggiungere al tuo layout poiché offrono un flusso diverso per i tuoi tavoli" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Action_Required_Slots" value="Con lo slot action required, i tavoli saranno spostati lì ogni volta che è il tuo turno di agire" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_InHand_Slots" value="Con lo slot in hand, i tavoli saranno spostati ogni volta che entri in mano, fai vpip, posti la blind, ecc. Questo può essere configurato in ogni configurazione sito" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys_Tab" value="Ora diamo un'occhiata alla scheda dei hotkeys del layout.." />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys" value="Ora diamo un'occhiata alla scheda dei hotkeys del layout.." />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkey_Dynamic_Slots" value="Con questo hotkey, puoi bloccare un tavolo fuori dal flusso dei dynamic slots, così rimane dov'è. Molto utile quando stai giocando una mano importante o a un final table" />
    </sub>
    <sub id="4" name="Sites Config">
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Sites" value="Clicca qui per andare alla Configurazione dei Siti" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATIONS_Party_Poker_Hex" value="Clicca per vedere quali configurazioni sono disponibili per Pokerstars (se non giochi su Stars, non preoccuparti. Potrai configurare i tuoi siti più tardi)" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Toggle_Tiling_Status" value="Con questo pulsante puoi abilitare/disabilitare il tiling (solo per questo sito)." />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Tiling_Options_Details" value="Qui potrai configurare come i tavoli vengono automaticamente spostati/e organizzati a tiling per un sito di poker specifico." />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Check_Auto_Play_On_Launch" value="Quando è attivato, una volta aperto Jurojin tutti i tuoi tavoli saranno spostati secondo ciò che hai configurato sopra. Questa opzione ti fa risparmiare il tempo di premere PLAY in Jurojin per iniziare a rilevare i tavoli. Ti consigliamo vivamente di usare questa funzione" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Save_Settings" value="Se hai qualcosa da salvare questo è il momento! Altrimenti premi semplicemente salta" />
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Back" value="Torniamo indietro e vediamo altre funzionalità" />
    </sub>
    <sub id="5" name="General Configuration">
      <add key="WALK_SCENARIO_GENCONFIG_HAMBURGER_MENU_ITEM_Configuration" value="Questo pulsante ti porta alla Configurazione Generale" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Playing_Area" value="L'area di gioco può essere magnetizzata, questo significa che puoi trascinare i tavoli e si agganceranno immediatamente agli slot. Puoi anche trascinare premendo il tasto CTRL per evitare lo scambio dei tavoli, invece si impileranno" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Observer_Area" value="Anche gli Observer slots possono essere magnetizzati" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tooltip_Magnetize_Playing_Area" value="Questa icona ti darà una breve spiegazione di cosa fa ogni funzione" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Lobby_Slots" value="Così come gli lobby slots. Finché gli lobby slots hanno entrambe le opzioni di stack sui siti" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Observer_Area_Table_Closed" value="Puoi fare in modo che i tavoli vengano riordinati negli observer slots quando uno di essi viene chiuso" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Playing_Area_Table_Closed" value="Puoi far riordinare i tavoli nelle slots di gioco quando uno di essi viene chiuso" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Focus_Table_Under_Mouse" value="Questa funzione porta il tavolo in primo piano quando ci passi sopra con il mouse" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Highlight_Table_Under_Focus" value="Evidenzierà il bordo del tavolo attivo." />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Show_Random_Number_Generator" value="Mostrerà il generatore di numeri casuali all'avvio dell'app. Se lasci attiva questa funzione, il RNG apparirà appena finisci questa guida!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Minimize_To_System_Tray" value="Quando premi il pulsante riduci a icona, l'app apparirà solo nella system tray (piccole icone in basso a destra di Windows)" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Keep_Most_Urgent_On_Top" value="Quando hai più di un tavolo impilato nello stesso slot, Jurojin terrà in cima il più urgente. Quando agisci, il tavolo più urgente successivo sale in cima." />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_WorksFor_Keep_Most_Urgent_On_Top" value="Ci sono alcune funzionalità che non funzionano per tutti i siti! Con questa icona puoi verificare quali le supportano!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Global" value="Puoi attivare o disattivare queste opzioni per rendere Jurojin ideale!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Global_Hotkeys" value="Queste sono le scorciatoie generali disponibili in Jurojin" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Set_HotKeys" value="Puoi impostare le hotkey selezionando il campo e premendo la scorciatoia da tastiera" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Table_Border" value="Qui puoi configurare i bordi colorati per le tue tables! Alcune sezioni hanno tab come questa, non dimenticare di controllare!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Table_Border" value="Puoi attivare questa opzione per avere un bordo viola sulla table in focus" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Save_Changes" value="Salva le tue impostazioni o semplicemente premi su skip saving" />
    </sub>
    <sub id="6" name="HotKeys Config">
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_HAMBURGER_MENU_ITEM_HotKeys" value="Qui potrai definire le hotkey per compiere azioni sulle tables come check/fold/bet/raise!" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Intro" value="Imposta i tuoi keybindings con mouse o tastiera per betsizes e azioni! Alcuni siti come GGPoker richiedono una configurazione extra, consulta la nostra FAQ per maggiori info!" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Discord_Intro" value="Sembra che tu non abbia accesso a questa funzione! Cliccando su questo pulsante puoi richiedere l'accesso lasciando il tuo username Jurojin nella chat" />
    </sub>
    <sub id="7" name="Controller Config">
      <add key="WALK_SCENARIO_CONTROLLER_HAMBURGER_MENU_ITEM_Controller" value="Abbiamo anche aggiunto il supporto controller per alcuni siti di poker!" />
      <add key="WALK_SCENARIO_CONTROLLER_Page_Intro" value="Prendi qualche birra, siediti sul divano e goditi qualche spin con il nostro nuovo supporto controller!" />
    </sub>
    <sub id="8" name="Overlays Config">
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_HAMBURGER_MENU_ITEM_Overlays" value="In questa vista puoi configurare le overlays che appaiono sopra le tue tables!" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Page_Intro" value="Ogni elemento che appare sopra ogni table è in questa vista, qui puoi attivarli o disattivarli oltre a configurare alcuni aspetti!" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Table_Overlays_Contents" value="Qui puoi configurare le overlays che appaiono dentro le tue tables. Le overlays mostrano varie statistiche molto utili in game. Clicca su learn more accanto a ogni overlay per vedere guide relative" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Tab_Seats_Overlays_Intro" value="Andiamo alla sezione delle overlays dei seats" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Seats_Overlays_Contents" value="Le overlays dei seats sono sempre attaccate accanto al posto del giocatore e mostrano cose come posizione e linea di azioni, assicurati di avere l'eroe centrato nelle configurazioni dei siti" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Tab_Table_Counters_Intro" value="Ora diamo un'occhiata alle overlays dei contatori" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Table_Counters_Contents" value="Le overlays dei contatori mostreranno informazioni relative alle tables sullo slot dove la table si trova (se presente)" />
    </sub>
    <sub id="9" name="Changelog">
      <add key="WALK_SCENARIO_CHANGELOG_HAMBURGER_MENU_ITEM_Changelog" value="In questa sezione potrai leggere le ultime novità per l'app! Diventa rosso quando ci sono nuovi contenuti!" />
      <add key="WALK_SCENARIO_CHANGELOG_Page_Intro" value="Scopri le ultime novità qui!" />
    </sub>
    <sub id="10" name="Outro">
      <add key="WALK_SCENARIO_GENOUTRO_REPORT_ISSUE" value="Se hai problemi usa il pulsante report così possiamo aiutarti, oppure unisciti al nostro canale Discord!" />
      <add key="WALK_SCENARIO_GENOUTRO_WALKTHROUGH_ON_DEMAND" value="Puoi vedere questa guida di nuovo in qualsiasi momento premendo questo pulsante." />
    </sub>
    <sub id="11" name="Others">
      <add key="WALK_Common_Label_User_Action_Complete" value="TUTTO COMPLETATO!" />
      <add key="WALK_Common_Label_User_Intro_Acknowledge" value="CAPITO" />
      <add key="WALK_Common_Skip_Saving" value="Salta salvataggio" />
      <add key="WALK_Button_See_Walkthrough_Again" value="VEDI GUIDA DI NUOVO" />
      <add key="WALK_Button_Guide" value="GUIDA" />
      <add key="WALK_Button_Skip_To_End" value="Finirò questa guida più tardi" />
    </sub>
  </area>
  <area id="116" name="Walkthrough V2">
    <sub id="0" name="Intro">
      <add key="WALKV2_INTRO_Title_Welcome_To_Jurojin_Poker" value="Benvenuto in Jurojin Poker!" />
      <add key="WALKV2_INTRO_Label_Choose_Your_Language_To_Begin" value="Scegli la tua lingua per iniziare" />
      <add key="WALKV2_INTRO_Button_Lets_Start" value="Iniziamo" />
    </sub>
    <sub id="1" name="Mini Intro">
      <add key="WALKV2_MINI_INTRO_Title_Lets_Learn_The_Basics" value="Impariamo le basi..." />
      <add key="WALKV2_MINI_INTRO_Description_I_Will_Be_Guiding_You_Through_The_App" value="Ti guiderò attraverso l'app così potrai imparare le nostre funzionalità più importanti! In Jurojin troverai tre funzionalità principali. Puoi cliccare su una qualsiasi per imparare." />
      <add key="WALKV2_MINI_INTRO_Button_Tiling" value="Tiling" />
      <add key="WALKV2_MINI_INTRO_Button_Hotkeys" value="Hotkeys" />
      <add key="WALKV2_MINI_INTRO_Button_Overlays" value="Overlays" />
      <add key="WALKV2_MINI_INTRO_Button_I_Will_Go_Through_Jurojin_Myself" value="Esplorerò Jurojin da solo" />
    </sub>
    <sub id="2" name="Mini Finish">
      <add key="WALKV2_MINI_FINISH_Title_Well_Done" value="Ben fatto!" />
      <add key="WALKV2_MINI_FINISH_Description_Great_You_Finished_One_Of_Our_Miniguides" value="Ottimo! Hai finito una delle nostre miniguide! Se vuoi vedere un'altra o ripetere questa puoi farlo subito!" />
      <add key="WALKV2_MINI_FINISH_Button_Tiling" value="Tiling" />
      <add key="WALKV2_MINI_FINISH_Button_Hotkeys" value="Hotkeys" />
      <add key="WALKV2_MINI_FINISH_Button_Overlays" value="Overlays" />
      <add key="WALKV2_MINI_FINISH_Button_I_Will_Go_Through_Jurojin_Myself" value="Esplorerò Jurojin da solo" />
    </sub>
  </area>
