    <add key="SETTINGS_NL_Tooltip_Body_Reoder_Observer_Area_When_Table_Closed" value="Puoi far riordinare i tavoli nelle slots osservatore quando uno viene chiuso" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Playing_Area_When_Table_Closed" value="Riordina area di gioco quando un tavolo viene chiuso" />
    <add key="SETTINGS_NL_Tooltip_Title_Reorder_Playing_Area_When_Table_Closed" value="Riordina area di gioco alla chiusura del tavolo" />
    <add key="SETTINGS_NL_Tooltip_Body_Reorder_Playing_Area_When_Table_Closed" value="Puoi far riordinare i tavoli nelle slots di gioco quando uno viene chiuso" />
    <add key="SETTINGS_NL_CheckBox_Keep_Most_Urgent_On_Top" value="Gestisci urgenza dello stack" />
    <add key="SETTINGS_NL_Tooltip_Title_Keep_Most_Urgent_On_Top" value="Gestisci urgenza dello stack" />
    <add key="SETTINGS_NL_Tooltip_Body_Keep_Most_Urgent_On_Top" value="Quando più tavoli condividono uno slot (stack), Jurojin porta in alto il tavolo più urgente (meno tempo per agire). Gestisce solo la visibilità nello stack — non sposta il focus della tastiera." />
    <add key="SETTINGS_NL_CheckBox_Auto_Focus_Most_Urgent_Always" value="Auto-focus sempre sul tavolo più urgente" />
    <add key="SETTINGS_NL_Tooltip_Title_Auto_Focus_Most_Urgent_Always" value="Auto-focus sempre sul tavolo più urgente" />
    <add key="SETTINGS_NL_Tooltip_Body_Auto_Focus_Most_Urgent_Always" value="Quando il primo tavolo richiede azione (o dopo aver agito e ne resta un altro), Jurojin mette a fuoco globalmente il tavolo più urgente così puoi giocare senza usare il mouse." />
    <add key="SETTINGS_NL_CheckBox_Also_Force_Move_Mouse" value="Forza anche lo spostamento del mouse" />
    <add key="SETTINGS_NL_Tooltip_Title_Also_Force_Move_Mouse" value="Forza anche lo spostamento del mouse" />
    <add key="SETTINGS_NL_Tooltip_Body_Also_Force_Move_Mouse" value="Sposta anche il cursore del mouse sul tavolo in focus. Utile per gamepad o siti che richiedono il cursore sul tavolo." />
    <add key="SETTINGS_NL_CheckBox_Minimize_App_To_System_Tray" value="Minimizza app nella system tray" />
