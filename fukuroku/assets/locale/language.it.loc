      <add key="EDIT_LAYOUT_NL_Label_Resize_Every_Slot" value="Ridimensiona ogni slot" />
      <add key="EDIT_LAYOUT_NL_Label_Scale" value="Scala:" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Playing_Area_Slot" value="Aggiungi PLAYING Slot" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Observer_Area_Slot" value="Aggiungi OBSERVER Slot" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Replay_Area_Slot" value="Aggiungi REPLAY Slot" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Lobby_Slot" value="Aggiungi LOBBY Slot" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Action_Required_Slot" value="Aggiungi ACTION REQUIRED Slot" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Title_Action_Required" value="Azione Richiesta" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Body_Action_Required" value="Questi slots rappresentano l'area dello schermo dove i tavoli andranno quando è il tuo turno di giocare. Ci sarà un solo tavolo alla volta in questo tipo di slots, quando tutti questi slots sono occupati da un tavolo, i tavoli vanno negli slots della coda, e una volta liberato l'action required slot, il tavolo più urgente dalla coda viene inviato." />
      <add key="EDIT_LAYOUT_NL_Button_Add_Queue_Slot" value="Aggiungi QUEUE Slot" />
      <add key="EDIT_LAYOUT_NL_Button_Add_In_Hand_Slot" value="Aggiungi IN HAND Slot" />
      <add key="EDIT_LAYOUT_NL_Button_Save_Changes" value="Salva Modifiche" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Title" value="Alcuni slot saranno eliminati" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Message" value="Gli slot contrassegnati con bordi rossi sono fuori dai limiti del display o sovrapposti ad altri slot e saranno rimossi. Vuoi procedere?" />
      <add key="EDIT_LAYOUT_NL_Label_Stack_Tables_In_Ar_Slot" value="Impila i tavoli nello slot AR quando arriva il tuo turno in ciascuno di essi" />
      <add key="EDIT_LAYOUT_Tooltip_Title_In_Hand" value="In Hand Slots" />
      <add key="EDIT_LAYOUT_Tooltip_Body_In_Hand" value="Gli In Hand Slots sono il modo migliore per concentrarsi solo sulle mani importanti, i tavoli si sposteranno qui quando fai VPIP. Puoi configurare questo comportamento in ogni configurazione del sito" />
    </sub>
