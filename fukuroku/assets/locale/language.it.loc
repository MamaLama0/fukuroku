      <add key="HOTKEYS_NL_Label_Also_Instantly_Shove_When_Using_Betting_Overlay" value="Quando usi un pulsante per la dimensione della puntata sull'HUD di puntata" />
      <add key="HOTKEYS_NL_Label_Instant_Shove_Only_All_In" value="Con tasto All-In" />
      <add key="HOTKEYS_NL_Label_AutoBet" value="Punta le chips immediatamente" />
