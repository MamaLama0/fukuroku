    <sub id="10" name="Faulty Layout Messages">
      <add key="ON_LAYOUT_FAULT_1" value="Il layout non ha informazioni sul display salvate. Ti consigliamo di modificarlo almeno una volta così che le informazioni sul display vengano salvate." />
