    <add key="SETTINGS_NL_CheckBox_Invert_Ctrl_Key" value="Inverti uso del tasto CTRL per magnetizzazione" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Observer_Area_When_Table_Closed" value="Riordina area osservatore quando un tavolo viene chiuso" />
