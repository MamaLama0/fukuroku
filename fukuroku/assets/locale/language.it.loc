    <add key="SETTINGS_NL_CheckBox_Magnetize_Playing_Area" value="Magnetizza l'area di gioco" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Playing_Area" value="Magnetizza l'area di gioco/slots" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Playing_Area" value="L'area di gioco può essere magnetizzata, cioè puoi trascinare e rilasciare i tavoli che si agganceranno subito alle slots. Puoi anche trascinare tenendo premuto CTRL per evitare lo scambio dei tavoli, verranno invece impilati" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Observer_Area" value="Magnetizza l'area osservatore" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Observer_Area" value="Magnetizza l'area/slots dell'osservatore" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Observer_Area" value="Anche le slots osservatore possono essere magnetizzate" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Lobby_Slots" value="Magnetizza le lobby slots" />
