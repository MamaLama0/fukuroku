  <area id="100" name="App Window">
    <add key="APP_WINDOW_NL_Popup_Signup_Title" value="注册" />
    <add key="APP_WINDOW_NL_Popup_Signup_Subtitle" value="开始您的免费试用！！" />
    <add key="APP_WINDOW_NL_" value="注册" />
    <sub id="0" name="Error Messages">
      <add key="ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_NL_MESSAGE" value="我们检测到您的显示配置发生了变化，当前活动的layout有slot超出边界。您现在想编辑活动layout吗？" />
      <add key="ON_APPLICATION_ERROR_Title" value="服务器错误" />
      <add key="ON_SERVER_FATAL_ERROR_MESSAGE" value="连接丢失。请检查您的网络连接。" />
      <add key="ON_ERROR" value="服务器错误" />
      <add key="ON_APPLICATION_MAINTENANCE_Title" value="服务器维护" />
      <add key="ON_APPLICATION_MAINTENANCE_Text" value="请您立即重新打开 Jurojin，重新打开后您很可能会恢复到正常用户状态！" />
      <add key="DLL_MISSING_ERROR_TITLE" value="文件缺失" />
      <add key="DLL_MISSING_ERROR_MESSAGE" value="您缺少运行该应用所需的文件！通常是杀毒软件删除了它们！请在您的杀毒软件或 Windows Defender 中给 Jurojin 安装文件夹添加例外，然后再试一次。如果仍然看到此错误消息，请从 https://jurojinpoker.com/download?v=345789/ 下载我们的最新安装程序。" />
      <add key="INSTALLATION_INTEGRITY_ERROR_TITLE" value="安装已被修改" />
      <add key="INSTALLATION_INTEGRITY_ERROR_MESSAGE" value="Jurojin 检测到安装文件发生意外更改。为保障安全，应用将关闭。请从 https://jurojinpoker.com/download 重新安装。" />
      <add key="UNHANDLED_EX_ERROR_OUTOFMEMORY" value="您的电脑内存（RAM）或显存（GPU memory）不足以运行程序。建议关闭一些未使用的应用程序（如浏览器），或考虑升级电脑。" />
      <add key="GLOBALFEATURE_ERROR" value="激活某个 Comfort Feature 时发生错误，请携带此信息联系支持：#ex#" />
      <add key="PLAYINGSESSIONHANDLER_ERROR" value="将桌子信息保存到您的layout时出现问题，请携带此信息联系支持：#ex#" />
      <add key="HOOKCONTROLLER_ERROR" value="连接您的controller时出现问题，请携带此信息联系支持：#ex#" />
      <add key="EMERGENCY_SHUTDOWN_CANNOT_CONNECT_TO_SERVERS_MESSAGE" value="" />
      <add key="KEEP_ALIVE_RECONNECT_ENTITLEMENTS_REVOKED_TOAST" value="您的电脑目前无法连接到我们的服务器。请检查网络连接以及防火墙/杀毒软件" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Title" value="连接问题" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Body" isFormatted="true" value="&lt;p&gt;您的订阅仍然有效，但 Jurojin 无法从您的电脑连接我们的服务器。出于安全原因，功能已暂时禁用。&lt;/p&gt;&lt;p&gt;请检查网络连接、防火墙和杀毒软件，然后等待 Jurojin 自动重新连接。&lt;/p&gt;" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Open_Guide" value="打开故障排除指南" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Got_It" value="知道了" />
    </sub>
