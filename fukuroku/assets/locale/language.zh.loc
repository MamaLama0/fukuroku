      <add key="EDIT_LAYOUT_NL_Tooltip_Title_Action_Required" value="需要操作" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Body_Action_Required" value="此slot代表屏幕上桌子在您回合时的位置。在这类slot中一次只会有一张桌子；当所有这些slot都被桌子占用时，桌子会进入排队slot，一旦需要动作的slot空出，排队slot中最紧急的桌子会被调入。" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Queue_Slot" value="添加 QUEUE slot" />
      <add key="EDIT_LAYOUT_NL_Button_Add_In_Hand_Slot" value="添加 IN HAND slot" />
      <add key="EDIT_LAYOUT_NL_Button_Save_Changes" value="保存更改" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Title" value="部分 slots 将被删除" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Message" value="带红色边框的 slots 要么超出显示范围，要么与其他 slots 重叠，将被移除。您要继续吗？" />
      <add key="EDIT_LAYOUT_NL_Label_Stack_Tables_In_Ar_Slot" value="在 AR slot 中堆叠牌桌，当轮到你时显示它们" />
      <add key="EDIT_LAYOUT_Tooltip_Title_In_Hand" value="In Hand slots" />
      <add key="EDIT_LAYOUT_Tooltip_Body_In_Hand" value="In Hand slots 是专注重要牌局的最佳方式，当你 VPIP 时牌桌会移动到这里。你可以在每个站点的配置中设置此行为" />
    </sub>
