    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bet_Buttons" value="ベットボタン" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Bet_Buttons_Tooltip_Title" value="ベットボタン" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Bet_Buttons_Tooltip_Body" value="このオーバーレイはホットキー/ベットサイズページで設定したベット値を表示します！ CTRLを押しながらオーバーレイ上で押すと、他の8つのベットサイズが見えます" />
