  <area id="100" name="App Window">
    <add key="APP_WINDOW_NL_Popup_Signup_Title" value="サインアップ" />
    <add key="APP_WINDOW_NL_Popup_Signup_Subtitle" value="無料トライアルを始めましょう!!" />
    <add key="APP_WINDOW_NL_" value="サインアップ" />
    <sub id="0" name="Error Messages">
      <add key="ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_NL_MESSAGE" value="ディスプレイの設定変更を検出しました。現在のアクティブなlayoutには範囲外のslotがあります。今すぐActive Layoutを編集しますか？" />
      <add key="ON_APPLICATION_ERROR_Title" value="サーバーエラー" />
      <add key="ON_SERVER_FATAL_ERROR_MESSAGE" value="接続が失われました。インターネット接続を確認してください。" />
      <add key="ON_ERROR" value="サーバーエラー" />
      <add key="ON_APPLICATION_MAINTENANCE_Title" value="サーバーメンテナンス" />
      <add key="ON_APPLICATION_MAINTENANCE_Text" value="すぐにJurojinを再起動してください。再起動後、通常のユーザー状態に戻る可能性が高いです！" />
      <add key="DLL_MISSING_ERROR_TITLE" value="ファイルが見つかりません" />
      <add key="DLL_MISSING_ERROR_MESSAGE" value="アプリを起動するために必要なファイルが不足しています！通常はアンチウイルスが削除している場合があります。アンチウイルスまたはWindows DefenderにJurojinインストールフォルダを例外として追加し、もう一度アプリを使用してみてください。それでもエラーメッセージが表示される場合は、最新のインストーラーを https://jurojinpoker.com/download?v=345789/ からダウンロードしてください。" />
      <add key="INSTALLATION_INTEGRITY_ERROR_TITLE" value="インストールが変更されました" />
      <add key="INSTALLATION_INTEGRITY_ERROR_MESSAGE" value="Jurojin はインストールファイルの予期しない変更を検出しました。安全のためアプリを終了します。https://jurojinpoker.com/download から再インストールしてください。" />
      <add key="UNHANDLED_EX_ERROR_OUTOFMEMORY" value="PCのRAMまたはGPUメモリが不足しています。ブラウザなど使っていないアプリを閉じるか、PCのアップグレードを検討してください。" />
      <add key="GLOBALFEATURE_ERROR" value="Comfort Featuresの一つの有効化にエラーが発生しました。この情報をサポートへ連絡してください: #ex#" />
      <add key="PLAYINGSESSIONHANDLER_ERROR" value="テーブル情報をlayoutに保存する際に問題が発生しました。この情報をサポートへ連絡してください: #ex#" />
      <add key="HOOKCONTROLLER_ERROR" value="コントローラとの接続に問題が発生しました。この情報をサポートへ連絡してください: #ex#" />
      <add key="EMERGENCY_SHUTDOWN_CANNOT_CONNECT_TO_SERVERS_MESSAGE" value="" />
      <add key="KEEP_ALIVE_RECONNECT_ENTITLEMENTS_REVOKED_TOAST" value="PCがサーバーに接続できません。インターネット接続とファイアウォール/アンチウイルスを確認してください" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Title" value="接続の問題" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Body" isFormatted="true" value="&lt;p&gt;サブスクリプションは有効ですが、お使いのPCからJurojinがサーバーに接続できません。安全のため、機能は一時的に無効化されています。&lt;/p&gt;&lt;p&gt;インターネット接続、ファイアウォール、アンチウイルスを確認し、Jurojinが自動的に再接続するまでお待ちください。&lt;/p&gt;" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Open_Guide" value="トラブルシューティングガイドを開く" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Got_It" value="了解" />
    </sub>
