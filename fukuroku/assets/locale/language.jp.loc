  <area id="116" name="Walkthrough V2">
    <sub id="0" name="Intro">
      <add key="WALKV2_INTRO_Title_Welcome_To_Jurojin_Poker" value="Jurojin Pokerへようこそ！" />
      <add key="WALKV2_INTRO_Label_Choose_Your_Language_To_Begin" value="始める言語を選択してください" />
      <add key="WALKV2_INTRO_Button_Lets_Start" value="始めましょう" />
    </sub>
    <sub id="1" name="Mini Intro">
      <add key="WALKV2_MINI_INTRO_Title_Lets_Learn_The_Basics" value="基本を学びましょう..." />
      <add key="WALKV2_MINI_INTRO_Description_I_Will_Be_Guiding_You_Through_The_App" value="アプリの重要な機能を学べるように案内します！Jurojinでは3つの主な機能があります。どれでもクリックして学んでください。" />
