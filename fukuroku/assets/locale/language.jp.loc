      <add key="CREATE_NEW_LAYOUT_AUTOMATICALLY_NL_Label_Playing_Slots" value="プレイ中Slots" />
      <add key="CREATE_NEW_LAYOUT_AUTOMATICALLY_NL_Label_Observer_Slots" value="オブザーバーSlots" />
