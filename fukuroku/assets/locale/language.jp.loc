      <add key="DIALOG_FOLLOW_UP_ISSUE_NL_Button_Got_It" value="了解しました" />
      <add key="DIALOG_FOLLOW_UP_ISSUE_NL_Label_Join_Our_Discord_Community" value="私たちのDiscordコミュニティに参加する" />
      <add key="DIALOG_FOLLOW_UP_ISSUE_NL_Label_Where_You_Can_Talk_About_This_Issue_And_Many_Other_Things" value="ここでこの問題やその他多くのことを話すことができます" />
