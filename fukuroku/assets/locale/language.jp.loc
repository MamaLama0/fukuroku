  <area id="103" name="Pages - Layout">
    <sub id="0" name="Page - Layout Configuration">
      <add key="LAYOUT_CONFIGURATION_NL_Tab_Title" value="layout設定" />
      <add key="LAYOUT_CONFIGURATION_NL_Tab_Header_Configuration" value="設定" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Active_Layout" value="アクティブなlayout:" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Select_Layout" value="layout選択" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Layout_Preview" value="layoutプレビュー" />
      <add key="LAYOUT_CONFIGURATION_NL_Layout_Layout_Actions" value="layout操作" />
      <add key="LAYOUT_CONFIGURATION_NL_Button_Activate_Layout" value="layoutを有効化" />
      <add key="LAYOUT_CONFIGURATION_NL_Button_Edit_Layout" value="layoutを編集" />
      <add key="LAYOUT_CONFIGURATION_NL_Button_Delete_Layout" value="layoutを削除" />
      <add key="LAYOUT_CONFIGURATION_NL_Button_Create_New_Layout" value="新しいlayoutを作成" />
      <add key="LAYOUT_CONFIGURATION_NL_Tab_Header_Automatic_Layout_Switch" value="自動layout切り替え" />
      <add key="LAYOUT_CONFIGURATION_NL_Switch_Feature_Enabled" value="機能が有効" />
      <add key="LAYOUT_CONFIGURATION_NL_Switch_Feature_Disabled" value="機能が無効" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Auto_Switch_Options" value="自動切り替えオプション" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Initial_Layout" value="初期" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Go_Back_To_Previous_Layout_If_Table_Decrease" value="テーブル数が減った場合、前のlayoutに戻る" />
      <add key="LAYOUT_CONFIGURATION_NL_Label_Ask_Before_Switching_Layout_Automatically" value="自動でlayoutを切り替える前に確認する" />
      <add key="LAYOUT_CONFIGURATION_NL_Info_Automatically_Switch_From_An_Initial_Layout" value="Jurojinは常にアクティブなlayoutがありますが、初期layoutから自動的に切り替えることも可能です。" />
      <add key="LAYOUT_CONFIGURATION_NL_Button_Save_Changes" value="変更を保存" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_LAYOUT_SWITCH_Title" value="LAYOUTを切り替え" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_LAYOUT_SWITCH_Message" value="自動的に以下のlayoutに切り替えますか？ " />
      <add key="LAYOUT_CONFIGURATION_NL_Help_Layout_Switch_Title" value="自動layout切り替え" />
      <add key="LAYOUT_CONFIGURATION_NL_Help_Layout_Switch_Body" value="この機能は開いているテーブル数に応じてactive layoutを自動的に切り替えます。開始するには最初のlayout切り替えの下にある鉛筆アイコンをクリックしてください。" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_TABLES_LAYOUT_CONFIGURATION_Auto_Swap_Caption" value="自動layout切り替え" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_TABLES_LAYOUT_CONFIGURATION_Auto_Swap_Message" value="layoutを手動で有効にすると自動layout切り替えが無効になります。本当にこの機能をオフにしてこのlayoutを有効にしますか？" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_Title" value="警告！" />
      <add key="LAYOUT_CONFIGURATION_NL_ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_Message" value="ディスプレイ設定の変更を検出しました。現在のアクティブなlayoutに範囲外のslotがあります。今すぐActive Layoutを編集しますか？" />
      <add key="LAYOUT_CONFIGURATION_NL_Tab_Header_Layout_Hotkeys" value="layout用ホットキー" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Playing_Slot" value="Playing Slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Send_Table_To_Playing_Slot" value="テーブルをplaying slotに送る" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Observer_Slot" value="Observer Slot" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Send_Table_To_Observer_Slot" value="テーブルをobserver slotに送る" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Playing_Slot_No" value="Playing Slot #" />
      <add key="LAYOUT_CONFIGURATION_NL_Hotkeys_Label_Observer_Slot_No" value="Observer Slot #" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Lock_Table_Of_Dynamic_Flow" value="テーブルをダイナミックフローからロック" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Move_Table_To_Next_Slot" value="テーブルを次のslotに移動" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Label_Move_Table_To_Previous_Slot" value="テーブルを前のslotに移動" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Help_Title_Lock_Table" value="テーブルのロック/再挿入" />
      <add key="LAYOUT_CONFIGURATION_NL_HOTKEYS_Help_Body_Lock_Table" value="このホットキーはテーブルをダイナミックスロットの流れ（AR/In Hand）から除外または再挿入するために使います。基本的にテーブルがあるslotに留まります。再度このホットキーを押すとダイナミックフローに戻ります。" />
    </sub>
    <sub id="1" name="Page - Create New Layout">
      <add key="CREATE_NEW_LAYOUT_NL_Title_Create_New_Layout" value="新しいlayoutを作成" />
      <add key="CREATE_NEW_LAYOUT_NL_Button_Create_Manually" value="手動で作成" />
      <add key="CREATE_NEW_LAYOUT_NL_Button_Create_Automatically" value="自動で作成" />
      <add key="CREATE_NEW_LAYOUT_NL_Button_Start_Form_Preset_Layout" value="プリセットlayoutから開始" />
      <add key="CREATE_NEW_LAYOUT_NL_Button_Clone_Existing_Layout" value="既存のlayoutを複製" />
      <add key="CREATE_NEW_LAYOUT_NL_Help_Option_Unavaliable_For_Your_Screen_Resolution" value="このオプションは画面解像度に対応していません" />
    </sub>
    <sub id="2" name="Page - Edit Layout">
      <add key="EDIT_LAYOUT_NL_Title_Edit_Layout" value="layoutを編集" />
      <add key="EDIT_LAYOUT_NL_Label_Layout_Name" value="layout名" />
      <add key="EDIT_LAYOUT_NL_Label_Hotkey_To_Switch_Layout_During_Session" value="セッション中にlayoutを切り替えるホットキー" />
      <add key="EDIT_LAYOUT_NL_Label_Dynamic_Slots" value="Dynamic Slots" />
      <add key="EDIT_LAYOUT_NL_Label_Resize_Every_Slot" value="全slotのサイズ変更" />
      <add key="EDIT_LAYOUT_NL_Label_Scale" value="スケール：" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Playing_Area_Slot" value="PLAYING Slotを追加" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Observer_Area_Slot" value="OBSERVER Slotを追加" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Replay_Area_Slot" value="REPLAY Slotを追加" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Lobby_Slot" value="LOBBY Slotを追加" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Action_Required_Slot" value="ACTION REQUIRED Slotを追加" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Title_Action_Required" value="アクション必要" />
      <add key="EDIT_LAYOUT_NL_Tooltip_Body_Action_Required" value="このslotはあなたの番が来たときにテーブルが移動する画面エリアを表します。このタイプのslotには同時に一つだけテーブルが存在します。すべてのslotが埋まった場合は、テーブルはQueue slotへ移動し、action required slotが空くと、Queue slotの最も優先度の高いテーブルが送られます。" />
      <add key="EDIT_LAYOUT_NL_Button_Add_Queue_Slot" value="QUEUE Slot を追加" />
      <add key="EDIT_LAYOUT_NL_Button_Add_In_Hand_Slot" value="IN HAND Slot を追加" />
      <add key="EDIT_LAYOUT_NL_Button_Save_Changes" value="変更を保存" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Title" value="いくつかのslotsは削除されます" />
      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Message" value="赤枠で囲まれたslotsは画面の範囲外か他のslotsと重なっているため削除されます。続行しますか？" />
      <add key="EDIT_LAYOUT_NL_Label_Stack_Tables_In_Ar_Slot" value="各テーブルのターンが来たらAR Slotにテーブルを積み重ねる" />
      <add key="EDIT_LAYOUT_Tooltip_Title_In_Hand" value="In Hand Slots" />
      <add key="EDIT_LAYOUT_Tooltip_Body_In_Hand" value="In Hand Slotsは重要なハンドにだけ集中する最適な方法です。VPIP時にテーブルがここに移動します。この動作は各サイト設定で調整可能です。" />
    </sub>
