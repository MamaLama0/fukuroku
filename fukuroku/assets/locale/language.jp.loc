    <add key="OVERLAY_SETTINGS_PAGE_NL_Action_History_Tooltip_Title" value="アクション履歴オーバーレイ" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Action_History_Tooltip_Body" value="このオーバーレイは対戦相手の意図が分かりやすくなり、ハンド中のすべてのアクションが見えます" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Position" value="ポジション" />
