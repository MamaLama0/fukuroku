    <sub id="8" name="Dialog - Max Slots Reached">
      <add key="DIALOG_MAX_SLOTS_REACHED_NL_Title_Oops_You_Reached_The_Maximum" value="おっと！最大に到達しました" />
      <add key="DIALOG_MAX_SLOTS_REACHED_NL_Body_Segment1" value="すでに全てのSlots/Layoutsを使用しています。" />
      <add key="DIALOG_MAX_SLOTS_REACHED_NL_Body_Segment2" value="Tilling Bundle" />
