    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency_Tooltip_Title" value="最小防御頻度" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency_Tooltip_Body" value="このオーバーレイは、相手に付け込まれないように特定のベットサイズに対してコールすべき最小の手の割合（％）を表示します。" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity" value="ブラフ・エクイティ" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity_Tooltip_Title" value="ブラフ・エクイティ" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity_Tooltip_Body" value="特定のベットサイズ（ベット前にbetboxから読み取り）に対し、相手のプレイスタイルの知識に基づいて、状況ごとにどのくらいの頻度で相手がフォールドすべきかを示し、特にブラフ時に利益を得るために役立ちます。" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_POT_Next_Street_Tooltip_Title" value="POT次のストリートオーバーレイ" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_POT_Next_Street_Tooltip_Body" value="このHUDは、現在のbet-boxの値（レイズ送信前）を考慮し、相手がコールした場合の次のベットラウンドの予想ポットサイズを自動的に計算します。" />
