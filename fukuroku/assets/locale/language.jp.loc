    <add key="OVERLAY_SETTINGS_PAGE_NL_Pot_Odds_Tooltip_Body" value="このオーバーレイでリスクとリワードの関係がわかります。数学的な報酬:リスクの関係やパーセンテージで表現可能です。" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Stack_To_Pot_Ratio" value="SPR" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Tooltip_Title" value="SPR" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Tooltip_Body" value="このオーバーレイでは、エフェクティブスタック（最少チッププレイヤーのスタック）がポットサイズに対してどのような比率かがわかります。" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Effective_Stack" value="有效スタック" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_EFFS_Tooltip_Title" value="EFF. S" />
