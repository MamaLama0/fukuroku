    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_SPR_Next_Street" value="SPR N.S." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_POT_Next_Street" value="POT N.S." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Next_Street_Tooltip_Title" value="SPR 次のストリートオーバーレイ" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Next_Street_Tooltip_Body" value="このオーバーレイはあなたのベットフィールドの値を読み取り、相手がコールすると仮定し、次のストリートのSPRを計算します" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ON_DISABLE_Actions_Title" value="オーバーレイを無効にする" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ON_DISABLE_Actions_Message" value="よろしいですか？このオーバーレイを無効にすると、テーブルやハンドの問題を報告できない場合があります。" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_AR_Counter_Tooltip_Title" value="アクション必要テーブルカウンター" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_AR_Counter_Tooltip_Body" value="このオーバーレイは、特定のslotでその時点でアクションが必要なテーブルの数を教えてくれます。サイクルボタンはアクションが必要なテーブルのみを切り替えます。" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ST_Counter_Tooltip_Title" value="スタックテーブルカウンター" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ST_Counter_Tooltip_Body" value="このオーバーレイは、特定のslotにあるテーブルの数を確認するために使用します。" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Hand_Counter_Tooltip_Title" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Hand_Counter_Tooltip_Body" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Save_Location_Title" value="保存場所" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Save_Location_Body" value="Jurojinのホーム画面にいることを確認し、点線部分をクリックしてオーバーレイを希望の場所に配置してください。その後、そのテーブル上でホットキーを押します。" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Outs" value="最小Outs" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Minimum_Outs_Tooltip_Title" value="最小アウト数" />
