  <area id="105" name="Page - Settings">
    <add key="SETTINGS_NL_Tab_Title" value="設定" />
    <add key="SETTINGS_NL_Tab_Header_Global_Setting" value="全体設定" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Playing_Area" value="プレイエリアをマグネット化" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Playing_Area" value="プレイエリア／slotsをマグネット化" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Playing_Area" value="プレイエリアはマグネット化可能で、テーブルをドラッグ＆ドロップするとすぐにslotsにスナップします。CTRLキーを押しながらドラッグ＆ドロップすれば、テーブルの入れ替えを防ぎ、スタックします。" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Observer_Area" value="オブザーバーエリアをマグネット化" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Observer_Area" value="オブザーバーエリア／slotsをマグネット化" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Observer_Area" value="オブザーバーslotsもマグネット化できます" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Lobby_Slots" value="ロビーslotsをマグネット化" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Lobby_Slots" value="ロビーslotsをマグネット化" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Lobby_Slots" value="ロビーslotsも同様です。ロビーslotsにスタックサイトオプションが有効な限り" />
    <add key="SETTINGS_NL_CheckBox_Invert_Ctrl_Key" value="マグネット化のためのCTRLキー使用を反転" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Observer_Area_When_Table_Closed" value="テーブル閉鎖時にオブザーバーエリアを再配置" />
    <add key="SETTINGS_NL_Tooltip_Title_Reoder_Observer_Area_When_Table_Closed" value="テーブル閉鎖時にオブザーバーエリアを再配置" />
    <add key="SETTINGS_NL_Tooltip_Body_Reoder_Observer_Area_When_Table_Closed" value="テーブルの1つが閉じられた時にオブザーバーslotsでテーブルを再配置できます" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Playing_Area_When_Table_Closed" value="テーブル閉鎖時にプレイエリアを再配置" />
    <add key="SETTINGS_NL_Tooltip_Title_Reorder_Playing_Area_When_Table_Closed" value="テーブル閉鎖時にプレイエリアを再配置" />
    <add key="SETTINGS_NL_Tooltip_Body_Reorder_Playing_Area_When_Table_Closed" value="テーブルの1つが閉じられた時にプレイングslotsでテーブルを再配置できます" />
    <add key="SETTINGS_NL_CheckBox_Keep_Most_Urgent_On_Top" value="スタックの緊急度を管理" />
    <add key="SETTINGS_NL_Tooltip_Title_Keep_Most_Urgent_On_Top" value="スタックの緊急度を管理" />
    <add key="SETTINGS_NL_Tooltip_Body_Keep_Most_Urgent_On_Top" value="複数テーブルが同じスロット（スタック）を共有する場合、Jurojinは最も緊急なテーブル（残り時間が最も少ない）をそのスタックの最前面にします。スタック内の表示のみを管理し、キーボードフォーカスは移動しません。" />
    <add key="SETTINGS_NL_CheckBox_Auto_Focus_Most_Urgent_Always" value="常に最緊急テーブルへオートフォーカス" />
    <add key="SETTINGS_NL_Tooltip_Title_Auto_Focus_Most_Urgent_Always" value="常に最緊急テーブルへオートフォーカス" />
    <add key="SETTINGS_NL_Tooltip_Body_Auto_Focus_Most_Urgent_Always" value="最初のテーブルがアクションを必要としたとき（またはアクション後に別テーブルがまだ必要なとき）、Jurojinは最も緊急なテーブルへグローバルにフォーカスし、マウスなしでプレイできるようにします。" />
    <add key="SETTINGS_NL_CheckBox_Also_Force_Move_Mouse" value="マウスも強制移動" />
