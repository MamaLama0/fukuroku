  <area id="115" name="Walkthrough">
    <sub id="0" name="Intro">
      <add key="WALK_INTRO_SKIP_OPTION_Label_Intro" value="ウォークスルーが中断されました。最初からやり直しますか？" />
      <add key="WALK_INTRO_SKIP_OPTION_Label_Button_Skip" value="スキップ" />
      <add key="WALK_INTRO_SKIP_OPTION_Label_Button_Continue" value="開始" />
    </sub>
    <sub id="1" name="Language Selection">
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Welcome" value="ようこそ！" />
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Intro" value="これから基本設定とその構成方法をご案内します" />
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Choose_Language" value="言語を選択してください" />
      <add key="WALK_INTRO_FINISH_Label_Button_LetsStart" value="始めましょう！" />
    </sub>
    <sub id="2" name="Finish">
      <add key="WALK_INTRO_FINISH_Label_Welcome" value="完了" />
      <add key="WALK_INTRO_FINISH_Label_Line1" value="完璧です！これでJurojinを使えます" />
      <add key="WALK_INTRO_FINISH_Label_Line2" value="プレイして楽しんで！テーブルでのご健闘を祈ります！" />
      <add key="WALK_INTRO_FINISH_Label_Button_PlayNow" value="今すぐプレイ" />
    </sub>
    <sub id="3" name="Layouts">
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Layout" value="まずはLayoutを設定しましょう。Layout設定メニューをクリックしてください" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Create_New_Layout" value="Layoutは、テーブルをどこに配置するかJurojinに伝える方法です。新しいLayoutを作成するにはここをクリックしてください" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Intro" value="このオプションでレイアウトを手動で作成できます" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Automatically" value="レイアウトを素早く作成したい場合は、自動作成機能を使えます" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_From_Preset" value="またはレイアウトテンプレートから選択することもできます" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Clone_Existing" value="既存のレイアウトをクローンも可能です。既存のものと似たレイアウトを作成して時間を節約するのに便利です。" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Action" value="とりあえず手動で作成して、全オプションを把握しましょう" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Slot" value="このボタンでPlaying Slotを追加します。テーブルはここにデフォルトで送られます" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Observer_Slot" value="同様にObserver Slotも追加できます。プレイしていないテーブルを観戦するために使います" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Replay_Slot" value="Replay Slotはハンドリプレイ専用です（一部サイトでは対応していません）" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Lobby_Slot" value="ロビーウィンドウもJurojinで認識され、lobby slotに送られます。テーブルとは違いサイズ変更されないので、位置のみ指定可能です" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_CopyBottom" value="このボタンを押すと、現在のslotと同じサイズの新しいslotがその真下に作成されます" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_DeleteSlot" value="slotを削除したい場合はゴミ箱アイコンを押してください。このslotを削除します" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Slots_Create_Layout" value="slotの追加方法が分かったので、レイアウトを作成しましょう。終わったら続行ボタンを押して保存します" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Save_Layout" value="すべて完了！レイアウトを保存して続けましょう" />
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Back" value="それでは戻って他の機能を見てみましょう" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Tab_Header_Automatic_Layout_Switch" value="ここでJurojinの自動layout切り替えを設定できます" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Select_Automatic_Layout_Options" value="自動layout切り替えの設定を自由に行いましょう！" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Or_Observer_Slot" value="これらのボタンでplayingまたはobserver slotsをレイアウトに追加できます。一般設定の「Keep Most Urgent on top」で同じslot内でテーブルを重ねて順番に表示可能です！" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Dynamic_Slots" value="この2つのボタンでdynamic slotsを追加できます。どちらか1種類だけ選択可能で、テーブルの流れが異なります" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Action_Required_Slots" value="action required slotでは、自分の番が来るたびにテーブルがここに移動します" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_InHand_Slots" value="in hand slotでは、ハンド参入時、VPIP、ブラインド投稿時などにテーブルが移動します。サイトごとの設定で調整可能です" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys_Tab" value="次にlayout hotkeysタブを見てみましょう" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys" value="次にlayout hotkeysタブを見てみましょう" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkey_Dynamic_Slots" value="このホットキーでテーブルをdynamic slotsの流れから除外し、その位置に固定できます。大きなハンドやファイナルテーブル時に非常に便利です" />
    </sub>
    <sub id="4" name="Sites Config">
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Sites" value="ここをクリックしてサイト設定に進みます" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATIONS_Party_Poker_Hex" value="Pokerstarsの設定を確認するにはクリックしてください（Starsでプレイしなくても大丈夫。あとでサイト設定できます）" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Toggle_Tiling_Status" value="このボタンでこのサイトのtilingを有効/無効にできます。" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Tiling_Options_Details" value="ここで特定のポーカサイト向けにテーブルの自動移動/tiling設定ができます。" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Check_Auto_Play_On_Launch" value="これをオンにすると、Jurojin起動時に上の設定に従ってすべてのテーブルが移動します。PLAYを押して検出開始する手間が省けるので強くおすすめします。" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Save_Settings" value="保存したい設定があればここで保存！なければスキップを押してください" />
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Back" value="戻って他の機能をさらに見てみましょう" />
    </sub>
    <sub id="5" name="General Configuration">
      <add key="WALK_SCENARIO_GENCONFIG_HAMBURGER_MENU_ITEM_Configuration" value="このボタンで一般設定へ進みます" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Playing_Area" value="playing areaはマグネット化可能です。ドラッグ＆ドロップでテーブルがslotにピタッと吸着します。CTRLキーを押しながらドラッグするとテーブルの入れ替えを避けてスタックできます。" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Observer_Area" value="Observer slotsもマグネット化可能です" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tooltip_Magnetize_Playing_Area" value="このアイコンは各機能の簡単な説明を表示します" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Lobby_Slots" value="ロビースロットも同様です。ロビースロットでスタックサイトオプションが有効なら" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Observer_Area_Table_Closed" value="Observer slotsでテーブルが閉じられたときに順序を並べ替えることができます" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Playing_Area_Table_Closed" value="プレイングslotsでテーブルが閉じられたときに順序を並べ替えることができます" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Focus_Table_Under_Mouse" value="マウスをテーブルに合わせると最前面に表示される機能です" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Highlight_Table_Under_Focus" value="フォーカスされたテーブルの枠線をハイライト表示します。" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Show_Random_Number_Generator" value="アプリ起動時に乱数ジェネレーターを表示します。この機能をオンにすると、ガイド完了後すぐにRNGが表示されます！" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Minimize_To_System_Tray" value="最小化ボタンを押すとアプリはシステムトレイ（Windows右下の小さなアイコン）にのみ表示されます" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Keep_Most_Urgent_On_Top" value="同じslotに複数テーブルが重なっている場合、Jurojinは最も緊急のものを上に表示します。アクションを起こすと次に緊急のものが上に来ます。" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_WorksFor_Keep_Most_Urgent_On_Top" value="すべてのサイトで動作しない機能もあります！このアイコンで対応しているサイトを確認できます！" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Global" value="このオプションをオン・オフしてJurojinを理想的にカスタマイズできます！" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Global_Hotkeys" value="これらはJurojinで利用可能な一般ホットキーです" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Set_HotKeys" value="フィールドを選択し、キーボードショートカットを押してホットキーを設定できます" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Table_Border" value="ここでテーブルのカラーボーダーを設定できます！このようなタブがあるセクションもあるので忘れずにチェックしてください！" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Table_Border" value="このオプションをオンにすると、フォーカスされたテーブルにバイオレットのボーダーが付きます" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Save_Changes" value="設定を保存するか、保存せずにスキップを押してください" />
    </sub>
    <sub id="6" name="HotKeys Config">
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_HAMBURGER_MENU_ITEM_HotKeys" value="ここでテーブルのチェック/フォールド/ベット/レイズなどのアクション用ホットキーを設定できます！" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Intro" value="マウスやキーボードでベットサイズやアクションのキー割り当てを設定してください！GGPokerなど一部サイトは追加設定が必要です。詳しくはFAQを確認してください！" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Discord_Intro" value="この機能にアクセスできないようです！このボタンをクリックして、チャットにJurojinユーザー名を残してアクセスをリクエストできます" />
    </sub>
    <sub id="7" name="Controller Config">
      <add key="WALK_SCENARIO_CONTROLLER_HAMBURGER_MENU_ITEM_Controller" value="一部のポーカーサイト向けにコントローラーサポートも追加しました！" />
      <add key="WALK_SCENARIO_CONTROLLER_Page_Intro" value="ビールを手にソファに座り、新しいコントローラーサポートでスピンを楽しみましょう！" />
    </sub>
    <sub id="8" name="Overlays Config">
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_HAMBURGER_MENU_ITEM_Overlays" value="この画面でテーブル上に表示されるオーバーレイを設定できます！" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Page_Intro" value="各テーブル上に表示される項目はこの画面にあり、オンオフや設定の調整ができます！" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Table_Overlays_Contents" value="ここでテーブル内に表示されるオーバーレイを設定できます。オーバーレイはゲーム中に便利な様々な統計を表示します。各オーバーレイ横の「詳しく見る」をクリックしてガイドを確認してください" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Tab_Seats_Overlays_Intro" value="シートオーバーレイのセクションに行きましょう" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Seats_Overlays_Contents" value="シートオーバーレイは常にプレイヤー席の横に貼り付き、ポジションやアクションラインなどを表示します。サイトの設定でヒーローが中央にいるか確認してください" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Tab_Table_Counters_Intro" value="次にカウンターオーバーレイを確認しましょう" />
      <add key="WALK_SCENARIO_OVERLAYS_CONFIG_Table_Counters_Contents" value="カウンターオーバーレイは、テーブルが配置されているslotのテーブルに関連する情報を表示します（ある場合）" />
    </sub>
    <sub id="9" name="Changelog">
      <add key="WALK_SCENARIO_CHANGELOG_HAMBURGER_MENU_ITEM_Changelog" value="このセクションではアプリの最新ニュースを読むことができます！新しい情報があると赤くなります！" />
      <add key="WALK_SCENARIO_CHANGELOG_Page_Intro" value="ここで最新ニュースを学びましょう！" />
    </sub>
    <sub id="10" name="Outro">
      <add key="WALK_SCENARIO_GENOUTRO_REPORT_ISSUE" value="問題があればレポートボタンを使ってサポートを受けるか、Discordチャンネルに参加してください！" />
      <add key="WALK_SCENARIO_GENOUTRO_WALKTHROUGH_ON_DEMAND" value="このボタンを押すといつでもこのガイドを再度見ることができます。" />
    </sub>
    <sub id="11" name="Others">
      <add key="WALK_Common_Label_User_Action_Complete" value="完了！" />
      <add key="WALK_Common_Label_User_Intro_Acknowledge" value="了解" />
      <add key="WALK_Common_Skip_Saving" value="保存をスキップ" />
      <add key="WALK_Button_See_Walkthrough_Again" value="ガイドを再度見る" />
      <add key="WALK_Button_Guide" value="ガイド" />
      <add key="WALK_Button_Skip_To_End" value="このガイドは後で終わらせます" />
    </sub>
