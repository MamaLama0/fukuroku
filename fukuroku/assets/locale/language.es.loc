    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Pot_Odds" value="POT ODDS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Pot_Odds_Tooltip_Title" value="POT ODDS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Pot_Odds_Tooltip_Body" value="Con este overlay podrás saber la relación entre el riesgo y la recompensa. Puede ser expresado como una relación matemática beneficio:riesgo o como un porcentaje." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Stack_To_Pot_Ratio" value="SPR" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Tooltip_Title" value="SPR" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Tooltip_Body" value="Con este overlay podrás saber con facilidad la relacion entre el stack efectivo (el stack del jugador con menos fichas en la mano) dividido por el tamaño del bote." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Effective_Stack" value="STACK EFECTIVO" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_EFFS_Tooltip_Title" value="STACK EF." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_EFFS_Tooltip_Body" value="Con este overlay podrás ver cuántas fichas tiene el jugador con menos fichas en la mano" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bet_Buttons" value="BOTONES DE APUESTA" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Bet_Buttons_Tooltip_Title" value="BOTONES DE APUESTA" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Bet_Buttons_Tooltip_Body" value="Este overlay mostrará los tamaños de apuesta que configures en la pantalla de Hotkeys/Atajos de teclado! Presiona CTRL sobre el overlay para ver los otros 8 tamaños de apuesta" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Action_History" value="HISTORIAL DE ACCIONES" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Action_History_Tooltip_Title" value="OVERLAY DE HISTORIAL DE ACCIONES" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Action_History_Tooltip_Body" value="Este overlay te permitira notar las intenciones que tus oponentes intentan mostrarte en la mesa, podras ver todos las acciones que tomaron a lo largo de la mano" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Position" value="POSICIONES" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Positions_Tooltip_Title" value="OVERLAY DE POSICIONES" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Positions_Tooltip_Body" value="Con este overlay podrás ver cada posición en la mesa de cada jugador" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_AR_Tables_Counter" value="CONTADOR MESAS CON ACCIÓN" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Hand_Tables_Counter" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_ST_Tables_Counter" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_TOASTER_Check_Guide" value="Una guia se abrira en tu explorador para los superpuestos de asiento. Asegurate de configurar todo correctamente antes de utilizar estas funcionalidades" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_SPR_Next_Street" value="SPR N.S." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_POT_Next_Street" value="POT N.S." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Next_Street_Tooltip_Title" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_SPR_Next_Street_Tooltip_Body" value="Este HUD leerá el valor de tu campo de apuestas y asumirá que tu oponente pagará, calculando así cuál será el SPR en la próxima calle antes de subir la apuesta." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ON_DISABLE_Actions_Title" value="Deshabilitar Control" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ON_DISABLE_Actions_Message" value="Estás seguro? Si quitas esto no tendrás forma  de reportar un problema en una mesa o mano" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_AR_Counter_Tooltip_Title" value="Contador de mesas que requieren accion" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_AR_Counter_Tooltip_Body" value="Este overlay te dira cuantas mesas apiladas en ese slot requiren que decidas. Su boton de cycle te permitira navegar entre ellas" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ST_Counter_Tooltip_Title" value="Contador de mesas apiladas" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_ST_Counter_Tooltip_Body" value="Este contador te permitirá saber cuántas mesas se encuentran apiladas en un slot. Con el botón de cycle podrás navegar entre ellas" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Hand_Counter_Tooltip_Title" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Hand_Counter_Tooltip_Body" value="Utiliza este overlay para tener una idea de cuanto volumen tuviste en tu sesion y decidir cuando meter un break o simplemente finalizar tu sesion actual. Cerrar la mesa reseteara el contador!" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Save_Location_Title" value="Guardar posicion" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Save_Location_Body" value="Asegúrate de estar en la pantalla principal de Jurojin. Luego acomoda los superpuestos desde su zona punteada y luego presiona la hotkey para guardar las nuevas posiciones" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Outs" value="OUTS MÍNIMOS" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Minimum_Outs_Tooltip_Title" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency" value="MDF" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency_Tooltip_Title" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Minimum_Defense_Frequency_Tooltip_Body" value="Este HUD muestra el porcentaje mínimo de manos que deberías pagar ante un tamaño de apuesta específico de tu oponente para no ser explotado por ellos." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity_Tooltip_Title" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Bluff_Equity_Tooltip_Body" value="Representa, dado un tamaño de apuesta (leído desde tu campo de apuestas antes de hacer cualquier apuesta), con qué frecuencia tu rival debería retirarse según tu conocimiento de su estilo de juego en una situación dada para que la apuesta sea rentable para ti, especialmente útil al hacer un farol." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_POT_Next_Street_Tooltip_Title" value="" />
    <add key="OVERLAY_SETTINGS_PAGE_NL_POT_Next_Street_Tooltip_Body" value="Este HUD calcula automáticamente el tamaño esperado del bote para la próxima ronda de apuestas, considerando el valor actual del campo de apuestas (antes de confirmar la subida) y asumiendo que el oponente pagará." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Minimum_Outs_Tooltip_Body" value="Este HUD te indicará cuántos outs mínimos debes tener para que un call sea rentable en el flop/turn. Se calcula multiplicando tu porcentaje de Pot Odds por la cantidad de cartas restantes." />
    <add key="OVERLAY_SETTINGS_PAGE_NL_Overlay_Settings_Title_Take_Screenshot" value="" />
