      <add key="EDIT_LAYOUT_NL_ON_EDIT_LAYOUT_SLOT_OUTSIDE_BOUNDS_Message" value="Los slots con los bordes marcados en rojo serán eliminados ya que se encuentran fuera del área del monitor, estás seguro que deseas continuar?" />
      <add key="EDIT_LAYOUT_NL_Label_Stack_Tables_In_Ar_Slot" value="Apilar debajo de la urgente al comenzara el turno en una nueva mesa." />
      <add key="EDIT_LAYOUT_Tooltip_Title_In_Hand" value="" />
      <add key="EDIT_LAYOUT_Tooltip_Body_In_Hand" value="Los In Hand Slots son tu mejor manera de mantener el foco en las manos importantes. Las mesas se moveran a estos slots cuando hagas VPIP. Puedes configurar este comportamiento en la configuracion de cada sala" />
    </sub>
