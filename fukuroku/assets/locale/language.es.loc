    <add key="APP_LOCATION_RESTORED" value="Ubicación de la app restaurada" />
    <add key="INJECTION_AVOIDED_VIA_BACKOFFICE_NOTIF" value="Por favor reabre la aplicación! Una de las salas que utilizas está ahora en modo de diagnóstico por lo que necesitamos a todos en el modo de prueba!" />
    <add key="INJECTION_AVOIDED_VIA_BACKOFFICE" value="La sala #game# no tendrá funcionalidades agregadas ya que fueron deshaiblitadas por el equipo de Jurojin!" />
    <add key="HOSTS_FILE_BLOCKS_HELP_REPORT" value="La ayuda está bloqueada por el archivo hosts. Contacta con soporte." />
    <add key="COINPOKER_ALT_STUCK_UNJAMMED" value="CoinPoker Alt Stucked was Unjammed" />
    <add key="NEW_APP_VERSION_NOTIFICATION" value="Tienes una nueva actualizacion pendiente! Te recomendamos reabrir Jurojin para obtener lo ultimo!" />
    <add key="MOVE_ARROUND_HOTKEYS_DISCLAIMER" value="Asegúrate de desactivar la opción &quot;Activar la mesa debajo del puntero&quot; o de dejar el puntero en una esquina de la pantalla si vas a jugar con el teclado!" />
    <add key="SPACEBAR_NOT_RECOMMENDED" value="No deberias utilizar la barra espaciadora como hotkey en #game# ya que genera muchisimos bugs!" />
    <add key="KEEP_MOST_URGENT_MESSAGE" value="Hemos abierto en el browser una guia para que puedas configurar correctamente cada sala con la funcionalidad &quot;Mantener la mesa mas urgente arriba&quot;" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_TITLE" value="¿Jugar sin el mouse?" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_BODY" value="Auto Focus mueve el foco del teclado a la mesa más urgente. Para fold, check o bet sin el mouse, las hotkeys de mesa deben apuntar a la mesa enfocada." />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_YES" value="Sí, cambiarlo" />
    <add key="AUTO_FOCUS_MOUSE_FREE_DIALOG_IGNORE" value="Ignorar" />
    <add key="ONE_TABLE_HOTKEYS_MESSAGE" value="Sólo puedes utilizar las hotkeys en una mesa! Si deseas utilizarlas en todas tus mesas no dudes en visitar nuestra tienda!" />
    <add key="CONNECTION_COLLIDED" value="La aplicación sólo puede ser utilizada en una PC simultáneamente, la aplicación quedará abierta en tu otra PC" />
    <add key="PACIFIC_POKER_X64" value="Tienes instalado una version x64 de 888. Solo tiling funcionará, puedes seguir la guia abierta para instalar una versión x86 y arreglarlo." />
    <add key="PACIFIC_POKER_X64_WORKING" value="Jurojin ahora es totalmente compatible con la versión 888 (x64), descargue e instale el software 888 más reciente para su región." />
