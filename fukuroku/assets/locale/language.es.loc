  <area id="105" name="Page - Settings">
    <add key="SETTINGS_NL_Tab_Title" value="Opciones" />
    <add key="SETTINGS_NL_Tab_Header_Global_Setting" value="OPCIONES GENERALES" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Playing_Area" value="Magnetizar el Area de Juego" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Playing_Area" value="Magnetizar el área/slots de Juego" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Playing_Area" value="La Playing Area, ó área de juego (todos tus slots verdes), puede ser magnetizada. Esto significa que cuando arrastres una mesa con el mouse hacia un slot, esta se acomodará automáticamente en él. También puedes hacerlo presionando la tecla CTRL para que las mesas se apilen en el slot donde sueltas la mesa en vez de intercambiarse. Te recomendamos tener la magnetización encendida" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Observer_Area" value="Magnetizar el Area de Observación" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Observer_Area" value="Magnetizar el area/slots de Observación" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Observer_Area" value="La Observer area también puede ser magnetizada" />
    <add key="SETTINGS_NL_CheckBox_Magnetize_Lobby_Slots" value="Magnetizar los lobbies" />
    <add key="SETTINGS_NL_Tooltip_Title_Magnetize_Lobby_Slots" value="Magnetizar los Lobby Slots" />
    <add key="SETTINGS_NL_Tooltip_Body_Magnetize_Lobby_Slots" value="Los lobby slots también, simpre y cuando ambos estén en modo apilar" />
    <add key="SETTINGS_NL_CheckBox_Invert_Ctrl_Key" value="Invertir el uso de la tecla CONTROL para magnetización" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Observer_Area_When_Table_Closed" value="Reordenar el area de Observación cuando una mesa es cerrada" />
    <add key="SETTINGS_NL_Tooltip_Title_Reoder_Observer_Area_When_Table_Closed" value="Reordenar mesas de Observación" />
    <add key="SETTINGS_NL_Tooltip_Body_Reoder_Observer_Area_When_Table_Closed" value="Puedes hacer que las mesas de tu area de observación sean reordenadas cuando una de las mesas se cierra" />
    <add key="SETTINGS_NL_CheckBox_Reorder_Playing_Area_When_Table_Closed" value="Reordenar el area de Juego cuando una mesa es cerrada" />
    <add key="SETTINGS_NL_Tooltip_Title_Reorder_Playing_Area_When_Table_Closed" value="Reordenar mesas de juego al cerrar una mesa" />
    <add key="SETTINGS_NL_Tooltip_Body_Reorder_Playing_Area_When_Table_Closed" value="Puedes hacer que las mesas de tus slots de juego sean reordenadas cuando una de las mesas se cierra" />
    <add key="SETTINGS_NL_CheckBox_Keep_Most_Urgent_On_Top" value="Gestionar urgencia del stack" />
    <add key="SETTINGS_NL_Tooltip_Title_Keep_Most_Urgent_On_Top" value="Gestionar urgencia del stack" />
    <add key="SETTINGS_NL_Tooltip_Body_Keep_Most_Urgent_On_Top" value="Cuando varias mesas comparten un slot (stack), Jurojin lleva arriba la mesa más urgente (menos tiempo para actuar). Solo gestiona la visibilidad dentro del stack — no mueve el foco de teclado." />
    <add key="SETTINGS_NL_CheckBox_Auto_Focus_Most_Urgent_Always" value="Auto enfocar siempre la mesa más urgente" />
    <add key="SETTINGS_NL_Tooltip_Title_Auto_Focus_Most_Urgent_Always" value="Auto enfocar siempre la mesa más urgente" />
    <add key="SETTINGS_NL_Tooltip_Body_Auto_Focus_Most_Urgent_Always" value="Cuando aparece la primera mesa que requiere acción (o después de actuar y queda otra pendiente), Jurojin enfoca la mesa más urgente de forma global para que puedas jugar sin usar el mouse." />
    <add key="SETTINGS_NL_CheckBox_Also_Force_Move_Mouse" value="También forzar mover el mouse" />
    <add key="SETTINGS_NL_Tooltip_Title_Also_Force_Move_Mouse" value="También forzar mover el mouse" />
    <add key="SETTINGS_NL_Tooltip_Body_Also_Force_Move_Mouse" value="También mueve el cursor del mouse sobre la mesa enfocada. Útil para gamepad o sitios que requieren el cursor sobre la mesa." />
    <add key="SETTINGS_NL_CheckBox_Minimize_App_To_System_Tray" value="Minimizar al Tray(Bandeja de Íconos)" />
    <add key="SETTINGS_NL_CheckBox_Save_Jurojin_Location_On_Close" value="" />
    <add key="SETTINGS_NL_Tooltip_Title_Alarm_For_Action_Required" value="" />
    <add key="SETTINGS_NL_Tooltip_Title_Delayed_Alarm_Action_Enabled" value="Alarma retrasada para acción requerida" />
    <add key="SETTINGS_NL_Tooltip_Subtitle_Delayed_Alarm_Action_Enabled" value="Suena 10 segundos después de que empieza tu turno" />
    <add key="SETTINGS_NL_Tooltip_Body_Delayed_Alarm_Action_Required" value="Puedes hacer que Jurojin reproduzca una alarma después de la cantidad de segundos configurada desde que empezó tu turno, siempre que todavía tengas acción pendiente." />
    <add key="SETTINGS_NL_Tooltip_Body_Minimize_Application_To_System_Tray" value="Cuando minimizes la aplicación con esta opción encendida, la app se irá al System Tray de abajo a la derecha de Windows" />
    <add key="SETTINGS_NL_Tooltip_Title_Minimize_Application_To_System_Tray" value="Minimizar al tray" />
    <add key="SETTINGS_NL_CheckBox_Show_RNG" value="Mostrar el RNG (Generador de números aleatorios)" />
    <add key="SETTINGS_NL_CheckBox_Sub_Show_RNG" value="" />
    <add key="SETTINGS_NL_Tooltip_Title_Show_Random_Number_Generator" value="Mostrar RNG" />
    <add key="SETTINGS_NL_Tooltip_Body_Show_Random_Number_Generator" value="Si esta opción está encendida,un RNG o generador de números aleatorio aparecerá en tu pantalla (es independiente de los que van sobre las mesas!)" />
    <add key="SETTINGS_NL_CheckBox_Drag_Table_Clicking_Anywhere" value="" />
    <add key="SETTINGS_NL_CheckBox_Focus_Table_Under_Mouse" value="Llevar la mesa al frente cuando el puntero le pase por encima" />
    <add key="SETTINGS_NL_Tooltip_Title_Focus_Table_Under_Mouse" value="Llevar mesa al frente al pasarle el mouse" />
    <add key="SETTINGS_NL_Tooltip_Body_Focus_Table_Under_Mouse" value="Si activas esta opción, cuando pases el puntero por encima de una mesa, esta será enviada al frente" />
    <add key="SETTINGS_NL_CheckBox_Bring_Only_Tables_In_Playing_Slot_To_Front" value="Traer mesas al frente únicamente en slots de juego" />
    <add key="SETTINGS_NL_Tab_Header_Global_Hotkeys" value="HOTKEYS GENERALES" />
    <add key="SETTINGS_NL_Label_Reorder_Playing_Area" value="Reordenar el Area de Juego" />
    <add key="SETTINGS_NL_Label_Reorder_Observer_Area" value="Reordenar el Area de Observación" />
    <add key="SETTINGS_NL_Label_Send_Table_To_Playing_Area" value="Enviar mesa/sitio no soportado/emulador al Area de Juego" />
    <add key="SETTINGS_NL_Tooltip_Title_Send_Table_To_Playing_Area" value="ENVIAR MESAS A UN SLOT DE JUEGO" />
    <add key="SETTINGS_NL_Tooltip_Body_Send_Table_To_Playing_Area" value="Cuando posiciones el puntero encima de una mesa y presiones este atajo de teclado, la  mesa será movida al siguiente slot de juego disponible. También funciona para sitios no soportados y emuladores! No olvides reportar el sitio no soportado en nuestros foros!" />
