      <add key="HOTKEYS_NL_Help_If_You_Leave_The_One_Of_The_Betsizes_Multiplier_Jurojin_Will_Use_The_Bb" value="Sirve para re-subir la apuesta de tu oponente bajo estrategia de multiplicación. Si dejas uno de los multiplicadores de tamaño de apuesta, Jurojin usará el tamaño en BB o en % según corresponda. Cuando las opciones de prioridad están desactivadas, la función de multiplicación es ignorada." />
      <add key="HOTKEYS_NL_Label_Customize_Raise_Mode" value="Modo de subida" />
      <add key="HOTKEYS_NL_Help_Customize_Raise_Mode_Title" value="Modos de subida" />
      <add key="HOTKEYS_NL_Help_Customize_Raise_Mode_Body" value="Selecciona cómo se comportará Jurojin tanto en tus hotkeys de apuesta como en los botones de apuesta al enfrentarte a subidas preflop y postflop" />
    </sub>
    <sub id="1" name="Tab - Hotkey Configuration">
      <add key="HOTKEYS_NL_Tab_Header_Hotkey_Configuration" value="Configuraciones" />
      <add key="HOTKEYS_NL_Label_Send_The_Hotkey_To" value="Enviar la señal.." />
      <add key="HOTKEYS_NL_Check_Table_Below_Mouse_Pointer" value="A la mesa debajo del puntero" />
      <add key="HOTKEYS_NL_Check_Focused_Table" value="A la mesa con foco" />
      <add key="HOTKEYS_NL_Label_Override_Poker_Site_Wheel_Betting" value="Ajuste de apuesta con rueda" />
      <add key="HOTKEYS_NL_Tooltip_Wheel_Betting_Title" value="AJUSTE DE APUESTA CON RUEDA" />
      <add key="HOTKEYS_NL_Tooltip_Wheel_Betting_Body" value="Puedes activarlo para que Jurojin ajuste el tamaño de la apuesta con la rueda del ratón. Puedes elegir mover el deslizador en BB o SB. La opción que elijas aquí también afectará el comportamiento de los atajos Incrementar y Decrementar." />
      <add key="HOTKEYS_NL_Label_Small_Blinds" value="Ciegas chicas" />
      <add key="HOTKEYS_NL_Label_Big_Blinds" value="Ciegas grandes" />
      <add key="HOTKEYS_NL_Label_Toggle_BB_Mode" value="Cambiar BB/Fichas" />
      <add key="HOTKEYS_NL_Label_BB_Convertion_On_Bodog_Bovada" value="Conversión de Ceigas en Bodog/Iggy" />
      <add key="HOTKEYS_NL_Button_Click_Here" value="Activar" />
      <add key="HOTKEYS_NL_Label_Instantly_Shove_Bet_When_Pressing_Hotkey" value="Al presionar un atajo de tamaño de apuesta." />
      <add key="HOTKEYS_NL_Label_Also_Instantly_Shove_When_Using_Betting_Overlay" value="Al presionar un botón de tamaño de apuesta del HUD" />
      <add key="HOTKEYS_NL_Label_Instant_Shove_Only_All_In" value="" />
      <add key="HOTKEYS_NL_Label_AutoBet" value="Enviar la Apuesta Instantaneamente" />
      <add key="HOTKEYS_NL_Label_Geometric_Betsizing" value="Tamaño Geometrico" />
      <add key="HOTKEYS_NL_Label_Convert_This_Betsize_Into_A_Geometric_Bet_Size" value="Convierte este botón de tamaño de apuesta en un tamaño de apuesta geométrico (2e, 3e)." />
      <add key="HOTKEYS_NL_Banner_When_Using_Betsize_Overlay_You_Can_Use_Ctrl_Key" value="Cuando utilices la botonera de apuesta, puedes ver los demas botones con la tecla CTRL" />
      <add key="HOTKEYS_NL_Tooltip_Geometric_Betsizing_Title" value="TAMAÑO GEOMETRICO" />
      <add key="HOTKEYS_NL_Tooltip_Geometric_Betsizing_Body" value="Con esta función, puedes modificar un botón de tamaño de apuesta para que funcione como una apuesta geométrica. Los tamaños de apuesta geométricos te permiten realizar una apuesta en el flop/turn, de modo que al apostar el mismo porcentaje en la siguiente calle, llegarías a un all-in en el river." />
    </sub>
