  <area id="100" name="App Window">
    <add key="APP_WINDOW_NL_Popup_Signup_Title" value="REGISTRATE" />
    <add key="APP_WINDOW_NL_Popup_Signup_Subtitle" value="PARA COMENZAR TU TRIAL!" />
    <add key="APP_WINDOW_NL_" value="" />
    <sub id="0" name="Error Messages">
      <add key="ON_ACTIVE_LAYOUT_SLOTS_OUTSIDE_WORKING_AREA_NL_MESSAGE" value="Detectamos un cambio en tu configuración de monitores y algunos de los slots de tu layout activo se encuentran fuera de pantalla!" />
      <add key="ON_APPLICATION_ERROR_Title" value="Error de servidor" />
      <add key="ON_SERVER_FATAL_ERROR_MESSAGE" value="La conexión con el servidor ha sido perdida. Intentando reconectar" />
      <add key="ON_ERROR" value="Parece que ha habido un error! Por favor contáctanos en discord para ayudarte a solucionarlo https://jurojinpoker.com/discord" />
      <add key="ON_APPLICATION_MAINTENANCE_Title" value="Matenimiento del Server" />
      <add key="ON_APPLICATION_MAINTENANCE_Text" value="Necesitamos que vuelvas a abrir Jurojin ahora. Muy probablemente volveras a tu usuario con normalidad luego de hacerlo!" />
      <add key="DLL_MISSING_ERROR_TITLE" value="Archivos faltantes" />
      <add key="DLL_MISSING_ERROR_MESSAGE" value="Tienes archivos faltantes en tu instalacion de Jurojin! Por favor añade una excepción en tu antivirus o Windows defender para la carpeta de instalación de Jurojin y luego intenta correr la app nuevamente. Si sigues experimentando este problema luego de hacerlo por favor descarga nuestro ultimo instalador de https://jurojinpoker.com/download?v=345789/" />
      <add key="INSTALLATION_INTEGRITY_ERROR_TITLE" value="Instalación modificada" />
      <add key="INSTALLATION_INTEGRITY_ERROR_MESSAGE" value="Jurojin detectó un cambio inesperado en los archivos de instalación. Por tu seguridad, la aplicación se cerrará. Reinstala desde https://jurojinpoker.com/download" />
      <add key="UNHANDLED_EX_ERROR_OUTOFMEMORY" value="" />
      <add key="GLOBALFEATURE_ERROR" value="" />
      <add key="PLAYINGSESSIONHANDLER_ERROR" value="" />
      <add key="HOOKCONTROLLER_ERROR" value="" />
      <add key="EMERGENCY_SHUTDOWN_CANNOT_CONNECT_TO_SERVERS_MESSAGE" value="" />
      <add key="KEEP_ALIVE_RECONNECT_ENTITLEMENTS_REVOKED_TOAST" value="Tu PC no puede conectarse a nuestros servidores. Revisa tu conexión a internet y el firewall/antivirus" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Title" value="Problema de conexión" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Body" isFormatted="true" value="&lt;p&gt;Tu suscripción sigue activa, pero Jurojin no puede conectarse a nuestros servidores desde tu PC. Las funciones se desactivaron temporalmente por seguridad.&lt;/p&gt;&lt;p&gt;Revisa tu conexión a internet, firewall y antivirus, y espera a que Jurojin se reconecte automáticamente.&lt;/p&gt;" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Open_Guide" value="Abrir guía de solución" />
      <add key="DIALOG_CONNECTIVITY_ENTITLEMENTS_REVOKED_Button_Got_It" value="Entendido" />
    </sub>
