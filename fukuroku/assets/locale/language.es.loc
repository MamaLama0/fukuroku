    <add key="SETTINGS_NL_Tooltip_Title_Send_Table_To_Observer_Area" value="ENVIAR MESAS A UN SLOT DE OBSERVACION" />
    <add key="SETTINGS_NL_Tooltip_Body_Send_Table_To_Observer_Area" value="Cuando posiciones el puntero encima de una mesa y presiones este atajo de teclado, la  mesa será movida al siguiente slot de observación disponible. También funciona para sitios no soportados y emuladores! No olvides reportar el sitio no soportado en nuestros foros!" />
