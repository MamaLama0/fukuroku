  <area id="115" name="Walkthrough">
    <sub id="0" name="Intro">
      <add key="WALK_INTRO_SKIP_OPTION_Label_Intro" value="La guía de primer uso de la aplicación fue interrumpida, deseas realizarla ahora?" />
      <add key="WALK_INTRO_SKIP_OPTION_Label_Button_Skip" value="NO REALIZAR" />
      <add key="WALK_INTRO_SKIP_OPTION_Label_Button_Continue" value="COMENZAR" />
    </sub>
    <sub id="1" name="Language Selection">
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Welcome" value="BIENVENIDO!" />
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Intro" value="Ahora te guiaremos por las funcionalidades más básicas y cómo configurarlas" />
      <add key="WALK_INTRO_LANGUAGE_SELECTION_Label_Choose_Language" value="ELIGE TU LENGUAJE" />
      <add key="WALK_INTRO_FINISH_Label_Button_LetsStart" value="COMENCEMOS!" />
    </sub>
    <sub id="2" name="Finish">
      <add key="WALK_INTRO_FINISH_Label_Welcome" value="LISTO!" />
      <add key="WALK_INTRO_FINISH_Label_Line1" value="Genial! Ya puedes usar  Jurojin" />
      <add key="WALK_INTRO_FINISH_Label_Line2" value="Disfrútalo! Buena suerte en las mesas!" />
      <add key="WALK_INTRO_FINISH_Label_Button_PlayNow" value="JUGAR AHORA" />
    </sub>
    <sub id="3" name="Layouts">
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Layout" value="Comencemos por crear un Layout. Haz click en el botón del menú de configuración de Layout" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Create_New_Layout" value="El layout es tu forma de decirle a Jurojin a donde deseas que las mesas sean enviadas. Haz click aquí para crear un Layout" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Intro" value="Esta opción te permitirá crear un Layout manualmente" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Automatically" value="Si deseas crear el Layout más rápidamente, puede utilizar la funcionalidad de creación automática" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_From_Preset" value="O simplemente seleccionar uno de nuestros templates" />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Clone_Existing" value="También tienes la posibilidad de clonar un layout existente en caso de que quieras hacer uno parecido, es simplemente para ahorrar tiempo." />
      <add key="WALK_SCENARIO_LAYOUTS_CREATE_NEW_LAYOUT_Create_Manually_Action" value="Por ahora, hagamos uno de forma manual así te amigas con las funcionalidades" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Slot" value="Este botón agrega un Playing Slot. Tus mesas irán a estos slots por defecto (puedes elegir que se envíen a los observer slots o a ninguno también)" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Observer_Slot" value="De la misma manera, puede agregar un Observer Slot. Te recomendamos utilizar estos slots para poner las mesas donde estás mirando y no jugando" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Replay_Slot" value="Los Replay slots son sólo para los replays de manos (no todos los sitios de poker soportan esta funcionalidad en Jurojin)" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Lobby_Slot" value="Los Lobbies también pueden ser reconocidos por Jurojin y enviados a los slots de Lobby. Ten en cuenta que, a diferencia de las mesas, los lobbies no cambiarán de tamaño al ser movidos, así que sólo puedes determinar su posición X,Y en la pantalla" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_CopyBottom" value="Presiona ahora este botón para crear un slot igual al anterior justo debajo" />
      <add key="WALK_SCENARIO_LAYOUTS_SLOT_AREA_DeleteSlot" value="Si necesitas borrar algún slot, utiliza el tacho. Borra este slot" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Slots_Create_Layout" value="Ahora que ya sabes cómo agregar slots, crea tu propio Layout! Una vez hayas finalizado presiona el botón para continuar con la guía" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Save_Layout" value="Todo listo! Ahora guarda tu Layout para que podamos continuar" />
      <add key="WALK_SCENARIO_LAYOUTS_HAMBURGER_MENU_ITEM_Back" value="Volvamos atrás para ver algunas funcionalidades más" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Tab_Header_Automatic_Layout_Switch" value="Aquí puedes configurar Jurojin para que cambie automáticamente de layout!" />
      <add key="WALK_SCENARIO_LAYOUTS_CONFIG_Select_Automatic_Layout_Options" value="Puedes configurar el cambio automático de layouts ahora!" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Playing_Or_Observer_Slot" value="" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Dynamic_Slots" value="" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_Action_Required_Slots" value="" />
      <add key="WALK_SCENARIO_LAYOUTS_EDIT_LAYOUT_PAGE_Add_InHand_Slots" value="" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys_Tab" value="" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkeys" value="" />
      <add key="WALK_SCENARIO_LAYOUTS_LAYOUT_CONFIG_Layout_Hotkey_Dynamic_Slots" value="" />
    </sub>
    <sub id="4" name="Sites Config">
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Sites" value="Haz click aquí para ir a la configuración de Sitios" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATIONS_Party_Poker_Hex" value="Haz click aquí para ver que configuraciones se pueden hacer para Pokerstars (Si no juegas en Stars, no te preocupes. Podrás configurar los sitios que juegas más tarde)" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Toggle_Tiling_Status" value="" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Tiling_Options_Details" value="" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Check_Auto_Play_On_Launch" value="Cuando esta opción está seleccionada, una vez que Jurojin esté abierto, todas las mesas que sean detectadas serán movidas de acuerdo a la configuración que seleccionaste arriba. Esta opción simplemente te ahorra tener que apretar PLAY en Jurojin para el sitio" />
      <add key="WALK_SCENARIO_SITECONFIG_SITE_CONFIGURATION_DETAILS_Save_Settings" value="Ahora puedes guardar tu configuración! Si no tienes nada por guardar sólo continúa" />
      <add key="WALK_SCENARIO_SITECONFIG_HAMBURGER_MENU_ITEM_Back" value="Vamos atrás una vez más para ver más funcionalidades" />
    </sub>
    <sub id="5" name="General Configuration">
      <add key="WALK_SCENARIO_GENCONFIG_HAMBURGER_MENU_ITEM_Configuration" value="Este botón te lleva a la Configuración General" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Playing_Area" value="La Playing Area, ó área de juego (todos tus slots verdes), puede ser magnetizada. Esto significa que cuando arrastres una mesa con el mouse hacia un slot, esta se acomodará automáticamente en él. También puedes hacerlo presionando la tecla CTRL para que las mesas se apilen en el slot donde sueltas la mesa en vez de intercambiarse. Te recomendamos tener la magnetización encendida" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Observer_Area" value="La Observer area también puede ser magnetizada" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tooltip_Magnetize_Playing_Area" value="Este ícono te dará una breve explicación de cada funcionalidad" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Magnetize_Lobby_Slots" value="Los lobby slots también, simpre y cuando ambos estén en modo apilar" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Observer_Area_Table_Closed" value="Puedes hacer que las mesas de tu area de observación sean reordenadas cuando una de las mesas se cierra" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Reorder_Playing_Area_Table_Closed" value="Puedes hacer que las mesas de tus slots de juego sean reordenadas cuando una de las mesas se cierra" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Focus_Table_Under_Mouse" value="Si activas esta opción, cuando pases el puntero por encima de una mesa, esta será enviada al frente" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Highlight_Table_Under_Focus" value="Cuando una mesa se vuelve activa, resaltarla con un contorno" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Show_Random_Number_Generator" value="Mostrar un generador de números alteatoreos con forma de ficha. Si dejas esta opción encendida, podrás ver la ficha apenas termine esta guía!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Minimize_To_System_Tray" value="Al presionar en el botón de minimizar, la aplicación irá al Tray de Windows (los pequeños íconos abajo a la derecha en Windows)" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Check_Keep_Most_Urgent_On_Top" value="Cuando tengas más de una mesa apilada en un slot, Jurojin mantendrá la  más urgente arriba. Cuando tomas acción la mesa que necesite acción más rápidamente irá al frente." />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_WorksFor_Keep_Most_Urgent_On_Top" value="Hay algunas funcionalidades que no funcionan para cualquier sala! Con este ícono podrás saber para qué salas funciona." />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Global" value="Puedes prender y apagar funcionalidades aquí para hacer Jurojin ideal!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Global_Hotkeys" value="Estas son las Hotkeys(atajos de teclado) generales disponibles en Jurojin" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Set_HotKeys" value="Puedes poner la hotkey que desees seleccionando el campo y presionando el atajo de teclado" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Tab_Table_Border" value="Aquí puedes configurar los bordes de mesa! Algunas secciones tienen tabs como estas!, no olvides fijarte!" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Configure_Table_Border" value="Puédes encender esta opción para tener un marco violeta sobre la ventana de poker que esté activa" />
      <add key="WALK_SCENARIO_GENCONFIG_GENERAL_CONFIGURATION_Save_Changes" value="Guarda tus configuraciones o simplemente continúa" />
    </sub>
    <sub id="6" name="HotKeys Config">
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_HAMBURGER_MENU_ITEM_HotKeys" value="Aquí podrás configurar atajos de teclado para tomar acción en las mesas como check/fold/bet/raise!" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Intro" value="Establece tus atajos de teclado o mouse para tus apuestas y acciones! Algunas salas como GGPoker requieren una configuración extra! Mira nuestro FAQ en la web para saber más" />
      <add key="WALK_SCENARIO_HOTKEYSCONFIG_Page_Discord_Intro" value="Parece que no tienes acceso a esta funcionalidad! Al clickear aquí podrás pedir acceso en el discord dejando tu nombre de usuario de Jurojin" />
    </sub>
    <sub id="7" name="Controller Config">
      <add key="WALK_SCENARIO_CONTROLLER_HAMBURGER_MENU_ITEM_Controller" value="También hemos sumado soporte para mando en algunas salas!" />
      <add key="WALK_SCENARIO_CONTROLLER_Page_Intro" value="Agarrá unas cervezas, tírate en el sofá, y disfruta de unos spins con nuestro nuevo  support para mando!" />
    </sub>
